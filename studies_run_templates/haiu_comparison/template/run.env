# ===============================================================
# Shared, non-secret runtime contract
# ===============================================================
# This file is exhaustive for settings used by the measured code paths.
# Real credentials belong in AppRC's app-wide configuration.

DMW_EXPERIMENTS_STORAGE="."
# DMW_EXPERIMENTS_PUBLICATION_PYTHON=
DMW_EXPERIMENTS_WATCHDOG_STALL_SECONDS="14400"

MONGO_DB="UserData"
USERS_COLLECTION="users"
THREAD_COLLECTION="threads"
BRANCH_REGISTRY_COLLECTION="ontology_branches"
WORKFLOW_EVENTS_COLLECTION="workflow_events"
WORKFLOW_PROGRESS_COLLECTION="workflow_progress"
WORKFLOW_EVENTS_TTL_SECONDS="604800"
WORKFLOW_PROGRESS_TTL_SECONDS="21600"

ACCESS_TTL_SECONDS="900"
REFRESH_TTL_SECONDS="1209600"
COOKIE_SECURE="false"
COOKIE_SAMESITE="lax"
JWT_ISSUER="dmw-experiments"
GITHUB_ONTOLOGY_REPO_NAME="Ontology-Development"
SEND_EMAILS="false"
ALLOWED_ORIGINS="*"
UVICORN_WORKERS="1"
BACKGROUND_WORKER_PROCESSES="1"

KISSKI_BASE_URL="https://chat-ai.academiccloud.de/v1"
KISSKI_TIMEOUT_SECONDS="3600"
KISSKI_MAX_RETRIES="3"
KISSKI_MAX_TOKENS="60000"
ONTOLOGY_WORKER_TIMEOUT_SECONDS="7200"
NER_WORKER_TIMEOUT_SECONDS="7230"

OPA_REQUIRE_ONTOLOGY_REF="true"
OPA_REQUIRE_SUCCESSFUL_RAG_RETRIEVAL="true"
OPA_SAFE_CONTEXT_RATIO="0.85"
OPA_FULL_ONTOLOGY_MAX_TOKENS="0"
OPA_THREAD_WRITE_MAX_RETRIES="3"
OPA_THREAD_WRITE_RETRY_DELAY_SECONDS="0.25"

HAIU_OPENAI_BASE_URL="https://chat-ai.academiccloud.de/v1"
HAIU_EMBEDDING_BASE_URL="https://chat-ai.academiccloud.de/v1"
HAIU_MODEL_LLM="qwen3.6-27b"
HAIU_MODEL_FAST="qwen3.6-27b"
HAIU_MODEL_FAST_REASON="false"
HAIU_MODEL_EMBED="qwen3-embedding-4b"
HAIU_MAX_RETRIES="3"
HAIU_MAX_RETRIES_OPENAI="0"
HAIU_TIMEOUT_LLM="3600"
HAIU_TIMEOUT_EMBEDDING="180"
HAIU_RPM="30"
HAIU_MAXCONCURRENCY="2"
HAIURAG_MODEL_LLM="qwen3.6-27b"
HAIURAG_MODEL_EMBED="qwen3-embedding-4b"
HAIURAG_ENABLE_EMBEDDING_CACHE="true"
HAIURAG_IGNORE_EMBEDDING_CACHE_READS="false"
HAIURAG_ENABLE_TURTLE_UPWARD_SCHEMA_CLOSURE="true"
LIGHTRAG_TOP_K="60"
LIGHTRAG_CHUNK_TOP_K="20"
LIGHTRAG_MAX_ENTITY_TOKENS="6000"
LIGHTRAG_MAX_RELATION_TOKENS="8000"
LIGHTRAG_MAX_TOTAL_TOKENS="30000"

