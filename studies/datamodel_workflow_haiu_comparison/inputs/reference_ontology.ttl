:Person a owl:Class ;
  rdfs:subClassOf :Akteur ;
  :stringInRGX "Henricus Leubing"@la ,
  "uxor"@la ;
  rdfs:label "Person"@de ;
  skos:definition "Diese Klasse umfasst reale Personen, die leben oder von denen angenommen wird, dass sie gelebt haben. \"This class comprises real persons who live or are assumed to have lived.\" (CIDOC)"@de ;
  skos:editorialNote <http://www.cidoc-crm.org/cidoc-crm/E21_Person> ,
  """Für jede Person werden die folgenden Properties verwendet; wenn die notwendigen Informationen im Text nicht zu finden sind, dann muss die Range \"Information fehlt\" vergeben werden:

1. Person_X hat Namen \"string\"
2. Person_X hat Vornamen \"string\"
3. Person_X hat Familiennamen \"string\"
4. Person_X hat Namenszusatz \"string\""""@de ,
  "Wir geben das Tag \"Person\" für alle Namen (alle Namensformen in allen Kombinationen, auch de ...) und alle Nomen, die eine Person referenzieren, wenn kein Name angegeben ist: dux Austrie. In der Regel konstituiert sich eine Person im RG aus der Kombination von einem Vornamen und einem Familienname (RG 5/163: Albertus Scriptoris). Manchmal wird eine Person nur über einen Namensteil (RG 2/2: Albertus) referenziert. Für die Disambiguierung einer Person ist es v.a. dann nötig, neben dem Namen weitere Informationen wie sozialer Stand, Pfründe, Diözese, Datum o. Ä. heranzuziehen (RG 5/163: Albertus dux Austrie ...16 oct. 1389). Ggf. müssen auch RG externe Quellen zur Disambiguierung und Identifikation herangezogen werden. Oft ist keine Identifikation möglich. In vielen Fällen werden Personen implizit, z.B. über Pronomen, referenziert."@de ;
  skos:example "\"explizit\": RG V 09440: Wilhelm Waghet"@la ,
  "\"implizit\" uxor: RG IV 00045: Adulphus de Lohusen domic. Colon. et uxor alt. port. 6 ian. 1423 L 237 60r."@la .


:Dekanat a owl:Class ;
  rdfs:subClassOf :Archidiakonat ;
  :stringInRGX "dign. ruralis et decanatus nunc."@la ;
  rdfs:label "Dekanat"@de ;
  skos:definition "Untergliederung eines Archidiakonats; nicht das Stiftsamt; Kontext entscheidet."@de ;
  skos:example "RG IX 03329: Johannes Ledebur scol. Osnaburg. dioc. qui vig. disp. sup. def. nat. (de mil. gen. s.s. ) s.c. capel. s. Jacobi in civit. Osnaburg. obtin. cler. Osnaburg. dioc.: de par. eccl. in Hofewynkel Monast. dioc. dign. ruralis et decanatus nunc. (4 m. arg. ) vac. p.o. Luderii Beke quam Henricus Hachmester p. an. occupavit 16. febr. 1465 S 579 142rs."@la .


:Pfruendenentzug a owl:Class ;
  rdfs:subClassOf :Aktivitaet ;
  :stringInRGX "privatus"@la ;
  :stringInRG "priv."@la ;
  rdfs:label "Pfründenentzug"@de ;
  skos:altLabel "privatio"@la ;
  skos:definition "Angaben zum Entzug einer Pfründe."@de ;
  skos:example "RG I 00029: Albertus ep. Tarbat. S 50 105 (petit div. indulta eligendi confessorem, providendi 2 personis de can. sub expect. preb. etc. privandi adher. Barth. beneficiis eaque aliis conferendi) 50 108 170v 61 6v."@la ,
  "RG V 00014: Adam de Mailverch cler. Leod. dioc., ex utr. de mil. gen., cui post priv. Johannis Pollart ob adhes. concil. Basil. post transl. p. dec. eccl. b. Marie Aquen. capel. s. Salvatoris prope et e.m. Aquen. d. dioc. (6 m. arg. ) coll. est de nova prov. 18. sept. 1440 S 367 195vs."@la .


:Prior a owl:Class ;
  rdfs:subClassOf :Klosteramt_Leitung ;
  :stringInRGX "prior"@la ;
  rdfs:label "Prior"@de ;
  skos:definition """Der Prior ist in klösterlichen Gemeinschaften der stellvertretende Leiter unter dem Abt; im Stiftswesen kommt er nur selten vor.

\"Das frühe Mönchtum verwendet den Begriff niemals im Sinne des ma. und modernen Sprachgebrauchs, nach dem der P. für den zweiten (d. h. stellvertretenden) Superior eines Kl. steht.\" (A.de Vogüé, \"Prior\", in: LexMA 7, Sp. 216-217; vgl. F.-J. Felten, \"Priorat\", in: LexMA 7, Sp. 217-218)."""@de ;
  skos:example "RG V 00336: Andreas de Tosonibus (Tonsonibus) prior mon. s. Sophie Paduan. o. s. Aug., nuntius pape constit. collect. in patriarchatibus Aquileg. et Graden. 9. mart. 1432 V 381 102v–104v."@la .


:Instandhaltung_Gebaeude a owl:Class ;
  rdfs:subClassOf :Objekt ;
  :stringInRGX "conservationem"@la ;
  rdfs:label "Instandhaltung Gebäude"@de ;
  skos:definition "z.B. als Objekt für einen Indulgenzbrief. Achtung: Nicht zu verwechseln mit dem Schutzbrief (littera conservatoria)."@de ;
  skos:example "RG V 07376: Obernperg (Obernpurg) Patav. dioc. capel. Corporis Christi op. O.: de indulg. pro conservatione 6. apr. 1446 S 410 267rs, L 430 293vs."@la ,
  """RG X 1184:
Cella Vetus
Abba. et monial. mon. Celle Veteris o. Cist. Magunt. dioc. inter al. referentes quod propter conservationem d. mon. et illius possessionum 400 fl. renen. certis personis solv. debent et quod 3 perp. s. c. benef. altaria nunc. in supremo alt. eccl. d. mon. ad coll. d. mon. pertin. p. personas in d. mon. degentes ab eodem mon. alienata fuerunt: de incorp. d. monasterio d. 3 benef. altaria nunc. (insimul 9 m. arg.) 9. decb. 78 S 775 252rs, L 788 115vs [...]"""@la .


:Paepstlicher_Thesaurar a owl:Class ;
  rdfs:subClassOf :Kuriales_Amt ;
  :stringInRG "thesaur. pape"@la ;
  rdfs:label "Päpstlicher Thesaurar"@de ;
  skos:definition "Hoher Bediensteter der apostolischen Kammer. \"Ihm lag die gesamte Kassenverwaltung ob, vor allem die Führung des Hauptbuches, der Introitus et Exitus; andererseits hatte er auch dei Beitreibung der Kammereinnahmen zu verfolgen […]\" (RG 3, S. 28*)."@de ;
  skos:example "RG III 01561: Luphardus Tepoldi (Polt; Depolt) de Benrade cler. Colon. dioc. scribens in thesaur.: recipit a thesaur. pape 2 fl. pro multis scripturis factis pro cam. ap. ac pro eundo Ostiam in negotiis cam. 5 mai. 1413 IE II 128;."@la .


:Expektanz a owl:Class ;
  rdfs:subClassOf :Pfruendenvergabe ;
  :stringInRG "gr. expect."@la ;
  rdfs:label "Expektanz"@de ,
  "gratia expectativa"@la ;
  skos:definition """\"Aus dem Reservationsrecht entwickelt sich das System der päpstlichen Expektanzen. Seit Hadrian IV. (1154/9) hatte es sich eingebürgert, nicht nur erledigte Pfründen zu besetzen, sondern auch für noch nicht erledigte Anwartschaften aufzustellen. Der Papst konnte eine rechtsverbindliche »gratia expectativa« aussprechen, die den Bewerber gegenüber allen anderen Anwärtern, selbst den von dem zuständigen Bischof begünstigten, bevorzugte […]\" 

(Johannes Mundhenk, Der Ertrag zweier an den Papst gerichteter Suppliken von 1429/30 für die Geschichte der Externsteiner Kapelle, in: Westfälische Zeitschrift 126/127, 1976/1977, S. 209)."""@de ;
  skos:editorialNote """\"Päpste [verliehen] generell zu Beginn ihrer Amtszeit in großem Stil Anwartschaften auf
kirchliche Benefizien […] (vgl. Andreas Meyer 1990).\" (RG 10, Textband 1/1, S. XIV)."""@de ;
  skos:example "RG I 00038: […] de benef. ad coll. abb. etc. mon. s. Galli o. s. Ben. Constant. dioc. […]"@la ,
  "RG IV 00016: […] de benef. Leod. dioc. […]"@la ,
  "RG VII 00240.: Bernhardus Fabri cler. Spiren. dioc. gr. expect. ut supra c. clausula perinde val. acsi 20 apr. 55 conc. essent 7 mai. 1457 V 447 181v-183r."@la .


:Vakanzgrund_unklar a owl:Class ;
  rdfs:subClassOf :Vakanzgrund ;
  :stringInRG "certo modo vac."@la ;
  rdfs:label "Vakanzgrund unklar"@de ;
  skos:definition "Unklarer Vakanzgrund"@de ;
  skos:example "RG VIII 00099: A(lbertus) de Opathow (Oppothow) rect. par. eccl. s. Trinitatis prope Zamchosch Cracov. dioc. (2 m. arg. ), mag. in med. ac bac. in theol. med. doct. , cler. Cracov. dioc.: de nova prov. de can. et preb. eccl. Gneznen. (20 m. arg. ) certo modo vac. [vel p. resign.?] mag. Schanchkenis de Czochel de quib. Johannes aep. Gneznen. sibi vig. litt. ap. prov. 26. nov. 1461 S 547 39vss."@la .


:Weiheempfang a owl:Class ;
  rdfs:subClassOf :Aktivitaet ;
  :stringInRGX "ordinatio"@la ;
  :stringInRG "recip. consecr."@la ,
  "recip. diacon."@la ,
  "recip. presb."@la ,
  "recip. presbit."@la ,
  "recip. subdiacon."@la ;
  rdfs:label "Weiheempfang"@de ;
  skos:definition """Akt der Aufnahme einer Person in einen klerikalen \"Ordo\" (vgl. Weihegrad); durch einen legitimen kirchlichen Obern (i.d.R. Ordinarius).

\"[…] Schon in christl. Frühzeit wurden Presbyter (→Priester), →Diakone und kirchl. Amtsträger unter dem Namen →Klerus (ordo) zusammengefaßt. […] Den Akt, mit dem man in einen solchen ordo aufgenommen wird, bezeichnet man als →Ordination. […] Durch den W.akt wird dem Empfänger die geistl. Gewalt, d. h. die Befähigung zur Verrichtung geistl. Funktionen, verliehen. […] Der Spender des W.sakramentes ist der Bf., es wird aber auch die Auffassung vertreten, daß der Papst einen Priester mit der W.spendung, ausgenommen der Bf.sw., betrauen kann (→Huguccio). Eine bes. Rolle spielte die Frage, wie die W. der Häretiker, Schismatiker und Simonisten zu beurteilen sei. […] Offen war die Zahl der W.grade und auch das Verhältnis von Episkopat und Presbyterat. […] Die Eignung wurde nach dem Dekretalenrecht vom Spender überprüft, also von dem Bf., dem Archidiakon oder dem vom Ordinator bestellten Priester bzw. von einem anderen im göttl. Recht und in kirchl. Vorschriften erfahrenen Mann (D. 25 c. 1). Zur Eignung gehörten erforderl. Alter, persönl. und charakterl. Eignung, Fehlen von Hinderungsgründen, notwendige Kenntnisse (D. 36-40). Zu den Kenntnissen gehörten genügende theol. Vorbildung und auch kanonist. Bildung, profanes Wissen, z. B. Grammatik und Dialektik sowie Kenntnis der weltl. Geschäfte. Es gab eine Vorprüfung sowie eine Prüfung, die in die Zeremonie der W. eingeschlossen war. Die Priester- und Diakonatsw. war dem Bf. vorbehalten. Zuständig war der Diözesanbf. […] Für die Bf.sw. mußte der Konsekrator die Bf.sw. besitzen. Weitere W.spender waren Äbte oder auch Kard.-prieser. Das Recht der Bf.skonsekration wurde vom Papst als Reservat angesprochen, was in der Praxis aber nicht durchsetzbar war. Außerdem wurde das Recht der Dimissorien und W.zeugnisse weiterentwickelt, die W.fristen (interstitia) geregelt. Die Spendung der niederen W.n sollte an Sonntagen oder hohen Festtagen erfolgen, die der höheren W.n nur an bestimmten Samstagen (Quatember-, Karsamstag).\" (\"Weihe, -grade, -hindernisse\", in: LexMA 8, Sp. 2104-2106)."""@de ;
  skos:example "RG IV 00013: Adam Fleszer primissarius in Kuinspach Spiren. dioc. recip. subdiacon. in curia 23 febr. 1426 F 1 16r."@la ,
  "RG IV 02123: [… ] de absol. quia se fecit promoveri sine lic. ordinarii et titulo […]"@la ,
  "RG VI 00256: Antonius (de Goppo) dec. eccl. Tergest. conc. recip. consecr. 7. mart. 51 L 461 111vs, l.b. mart. 1451 T 7 113v."@la ,
  "RG VII 00017: Adolphus de Hamel ( al. Curre) cler. Osnaburg. dioc., Jacobi ep. Perusin. cap. de prom. in cur. 7 febr. 1458 S 506 165v."@la ,
  "confirmatio ordinationum: RG IV 00094: Albertus dux Austrie de conf. ordinationum sup. domo o. fr. herem. s. A. Wien. Patav. dioc.; rem. plen. 18 aug. 1421 S 154 3r, conf. ordinationum L 213 293v."@la .


:Vakanzgrund_Aberkennung a owl:Class ;
  rdfs:subClassOf :Vakanzgrund ;
  :stringInRG "vac. p. priv."@la ,
  "vacat. p. priv."@la ;
  rdfs:label "Vakanzgrund Aberkennung"@de ;
  skos:definition "Vakanz wegen Aberkennung (vac. / vacat. p. priv.): Die Pfründe ist vakant, weil der vorherige Inhaber ihrer „beraubt“ worden ist wegen eines kirchenrechtlich relevanten Vergehens - das ist in der Regel durch den Ordinarius, den zuständigen Ortsbischof, geschehen (vgl. RG Bearbeitungshinweise, S. 42)."@de ;
  skos:example "RG IV 00088: Albricus Petri de Ostrow cler. Gneznen. de conf. par. eccl. in Lubothiin Wladislav. dioc. vac. p. priv. Nagortze vel assec. alterius benef. p. Michaelem 2 oct. 1420 S 147 90v."@la ,
  "RG IV 01276: Burkardus Langenbrunner ( al. Nusplinger) presb. Basil. oblig. sup. annat. alt. s. Erhardi in par. eccl. de op. Novicastri Constant. dioc. vacat. p. priv. Ulrici Crutzer 5 mart. 1423 A 2 227r."@la .


:Pfruendenresignationsempfang a owl:Class ;
  rdfs:subClassOf :Objekt ;
  :stringInRGX "recipiendi resignationem benef."@la ;
  rdfs:label "Pfründenresignationsempfang"@de ;
  skos:definition "Pfründenresignationsempfang bezeichnet einen thematischen Bezugspunkt, auf den sich eine Lizenz oder ein anderer Gnadenerweis bezieht, wenn einer Person die Befugnis eingeräumt wird, die Resignation einer kirchlichen Pfründe entgegenzunehmen, ggf. mit der Fakultät, die Pfründe anschließend anderweitig zu vergeben."@de ;
  skos:example "RG I 00219: […] diverse fac.: […] recipiendi resignationem benef. et conferendi aliis […]"@la .


:Reservierung a owl:Class ;
  rdfs:subClassOf :Gnadenerweis ;
  :stringInRG "reserv."@la ;
  rdfs:label "Reservierung"@de ,
  "reservatio"@la ;
  skos:definition "Reservierung bezeichnet als Typ eines Gnadenerweises einen Akt, durch den eine kirchliche Pfründe für einen bestimmten Petenten vorbehalten wird, ohne dass damit zwingend die spätere tatsächliche Verleihung verbunden ist."@de ;
  skos:editorialNote """Bezieht sich auf Objekte:
- Patronatsrecht
- Einkünfte

Andere:
- Kirchliches_Amt"""@de ;
  skos:example "RG VI 02814: […] de reserv. can. et preb. […]"@la .


:Lektor_Ordensschule a owl:Class ;
  rdfs:subClassOf :Kirchliches_Amt ;
  :stringInRGX "lector"@la ;
  :stringInRG "lect."@la ;
  rdfs:label "Lektor Ordensschule"@de ;
  skos:definition "\"II. Ordensgeschichtlich, -rechtlich: Früher war L. die Bez. ordensinterner Dozenten für philosophisch-theol. Bildung der Brüder; entwickelt in ma. Bettelorden aus dem Dienst der \"lectio\" (Lesung u. Kmtr.) der Hl. Schrift bzw. maßgebender philos. und theol. Texte, zuerst bei Dominikanern, dann auch bei Franziskanern vorgeschrieben. Dieser Dienst erforderte bald einen Ausbildungsgang in philosophisch-theol. Stud.-Einrichtungen der Orden, bei überregionaler Bedeutung (\"studia generalia\") oft Universitäten angegliedert. Akademische Stellung als \"Magister artium\" od. \"theologiae\" angestrebt, doch nicht vorausgesetzt für ordensinternen Lehrauftrag, bei entspr. Qualifikation u. Bewährung im eigenen Studium v. Ordensoberen erteilt. […]\" (Johannes Schlageter, \"Lektor, Lektorin\", in: Lexikon für Theologie und Kirche, Band 6, 3. Auflage, 1997, Sp. 806f.)."@de ;
  skos:editorialNote "Achtung: Die Abkürzung lect. für Lektor_Ordensschule kann leicht verwechselt werden mit dem Inhaber der 2. niederen Weihe Lektor; außerdem gibt es noch lect. i.S.v. lectio (Verlesung)."@de ;
  skos:example "RG V 00940:  Caspar Melchioris fr. Caspar Melchioris lector o. pred. Constant. dioc., cap. Alberti ducis Austrie ( d. A. et Sigismundo Austrie, Stirie, Carinthie et Carniole ducibus et com. Tirolis supplic. ) de disp. ut quamcumque par. eccl. de iure patron. d. ducum acc. val. 16. iul. 1446 S 412 218v."@la ,
  "RG VI 00642: Gaspar Melchioris lect. o. Prem. cap. Alberti ducis Austrie supplic. d. duce disp. recip. benef. eccles. 5. mai. 1452 V 400 165rs."@la .


:Dioezese a owl:Class ;
  rdfs:subClassOf :Ort ;
  :stringInRG "dioc."@la ;
  rdfs:label "Diözese"@de ;
  skos:altLabel "Bistum"@de ;
  skos:definition """Ein kirchlicher Verwaltungsbezirk, der i. d. R. unter der Leitung eines Bischofs steht, aber auch einen exempten Status haben kann. Mehrere Diözesen können einen Kirchenprovinz bilden.

\" […] Bis ins 12. Jh. wurden beide Begriffe [parochia und diocesis] synonym verwandt; erst während des 13. Jh. entwickelte sich diocesis (Diözese) zum gebräuchl. Wort für das B. in der Westkirche. In den päpstl. Quellen des 12. Jh. erscheinen für B. auch nebeneinander civitas und ecclesia (Toubert).

Als sich die institutionalisierte Kirche in der Spätantike ausbreitete, entstanden B.er auf verschiedene Weise. In einigen Teilen des Röm. Reiches, bes. in Italien und Afrika, kam es zur Ausbildung einer Vielzahl von B.ern in verhältnismäßig kleinen städt. Siedlungen. Deshalb wurde bald gefordert, Bf.e sollten ihre Sitze nur in wichtigen städt. Zentren haben (Konzil v. →Sardika [Sofia] 343). Gegen Ende des 4. Jh. hatte Italien etwa 80 B.er, um 600 war die Zahl auf etwa 200 angestiegen (Feine). In Nordafrika gab es schon in der Mitte des 3. Jh. etwa 87, auf der Synode v. Karthago (411) waren 286 kath. Bf.e anwesend. […] Nördl. der Alpen war die Zahl der B.er wesentl. geringer, da sie erst vom Papst oder von Metropoliten gegründet wurden. Die Metropoliten und die ihnen unterstehenden Bf.e entschieden im FrühMA noch gemeinsam über die Errichtung, Vereinigung oder Teilung von Bistümern. Schon sehr früh begannen jedoch die Päpste, sich die Gründung neuer B.er in Missionsgebieten vorzubehalten. So beschreibt →Beda Venerabilis den Plan Papst Gregors d. Gr., in England B.er zu errichten. 601 beauftragte er →Augustinus v. Canterbury (2. A.), zwölf neue B.er zu gründen, und übersandte ihm das →Pallium. Ebenso verfuhr Papst Gregor II. (716), als er seinem Legaten →Willibrord befahl, drei oder vier B.er in Bayern zu errichten. Papst Gregor III. (732) erteilte dem hl. →Bonifatius den allgemeinen Auftrag, die frk. Kirche zu reorganisieren. Neue Bf.e wurden »ex nostra vice« ernannt. Später behielt sich das Papsttum grundsätzl. das Recht zur Schaffung v. B.ern vor. Papst Urban II. bekräftigte 1092 die Forderung Gregors VII. (Dictatus papae), daß es das ausschließl. Recht des röm. Papstes sei, neue B.er zu errichten: »Solius etenim Apostolici est episcopatus coniungere, coniunctos disiungere, aut etiam novos construere« (Jaffé 5473). Daraus wurde im späteren kanon. Recht ein päpstl. Privileg.

Die B.er der frühen Kirche waren so organisiert, daß den Bf.en der größeren Städte, den →Metropoliten, die der kleineren Gemeinden unterstellt waren. Im 4. und 5. Jh. wurden die B.er zu Kirchenprovinzen zusammengefaßt (in der Ostkirche zu →Eparchien), die von einem Patriarchen (bzw. →Exarchen) geleitet wurden. Die innere Organisation der B.er beruhte hauptsächl. auf den Ortskirchen, den ecclesiae oder plebes baptismales, wo an Sonn- und Feiertagen der Hauptgottesdienst gehalten und zu Ostern und Pfingsten die Taufe gespendet wurde. Diese Kirchen nannte man in Südeuropa Taufkirchen, in Nordeuropa Pfarrkirchen; sie haben sich aus verschiedenen Wurzeln entwickelt, und dementsprechend vielfältig sind ihre Erscheinungsformen (→Pfarrwesen).

Für die wachsenden chr. Gemeinden errichteten Bf.e, Äbte und Laien Kirchen, deren Verwaltung sie Priestern, Erzpriestern usw. übertrugen. Als sich das Eigenkirchenwesen immer mehr durchsetzte (8.-10. Jh.), schwand zugleich die Hoffnung auf eine einheitl. Verwaltung der Ortskirchen im Rahmen der Diözesen. Institutionelle Gleichheit wurde hier erst in der frühen NZ erreicht. Seit dem FrühMA, insbes. seit dem 9.-11. Jh., bildete sich in vielen B.ern das Amt des →Archidiakons mit starker Eigenständigkeit heraus; die Unterteilung der B.er in Archidiakonate behielt während des gesamten MA große Bedeutung. Als Vertreter des Bf.s war der Archidiakon in seinem Jurisdiktionsbereich für die bfl. Rechtsprechung verantwortlich. Später erhoben die Archidiakone sogar den Anspruch auf eine jurisdictio ordinaria, nicht delegata. Innerhalb der Diözesanhierarchie gewann im HochMA auch ein anderes Amt an Bedeutung, das des bfl. →Offizials. Der Offizial vertrat den Bf. bei Gericht und in dessen Abwesenheit. Als bfl. Vertreter für die Verwaltungsaufgaben ist auch der →Generalvikar zu nennen. Allgemeingültige Feststellungen über Titel und Funktionen der verschiedenen Diözesanämter lassen sich jedoch nicht treffen, da sie in den einzelnen Kirchen Westeuropas stark differieren. […]\" 

(K. Pennington, \"Bistum\", in: LexMA 2, Sp. 251-253)."""@de .


:Kommende a owl:Class ;
  rdfs:subClassOf :Religioese_Gemeinschaft ;
  :stringInRGX "commenda"@la ;
  rdfs:label "Kommende"@de ;
  skos:definition "\"(lat. commenda, von commendare = \"anvertrauen\"). [1] Von Dienstverpflichtung befreite geistl. Pfründe. Handelte es sich ursprgl. um die befristete Übertragung eines kirchl. Amtes samt Benefizium aufgrund Vakanz oder Behinderung des Inhabers, erfolgten schon bald Verleihungen auf Lebenszeit. Bereits unter den karol. Hausmeiern dehnte sich die Praxis auf die Belehnung von Laien mit der Abtswürde aus. Diese Kommendataräbte (→Abt) übten beschränkte Jurisdiktion aus, was sie zum Ziel der Kritik früher Reformorden machte. Lag das Belehnungsrecht in landesherrl. Gewalt, fielen K.n häufig an Kard.e und Bf.e, bes. in Italien, Spanien und Frankreich. Zwar hatte das II. Konzil v. Lyon 1274 das K.nwesen mit Vorschriften zur Residenzpflicht und Verbot der Pfründenhäufung zu beschränken versucht, doch behielt selbst der Hl. Stuhl diese Praktiken bei. So konnten im späten MA mehrere K.n in einer Hand vereinigt sein, und es entstanden die sog. »jüngeren K.n«, Kaplaneien an Altarstiftungen mit zugehöriger Nutzung. [2] Bei den →Ritterorden die unterste selbständige Verwaltungseinheit. Der Name K. leitet sich von commendator ab. Johanniter und Templer gebrauchten seit Mitte/Ende des 12. Jh. diesen Begriff, aus dem sich durch Eindeutschung die Bezeichnung Komtur für den Vorsteher der K. entwickelte; der →Dt. Orden schloß sich dem Sprachgebrauch an. Zur K. konnten eine oder mehrere Burgen gehören. Nicht immer hatte die K. einen Konvent, auch wenn die Ordensregeln dies vorschrieben. Beim Dt. Orden wurden mehrere K.n zu einer Ballei unter Leitung eines Landkomturs zusammengefaßt; sein Sitz hieß Landk. In Preußen und Livland entsprach der K. die Komturei. [3] Form einer Handelsgesellschaft oder eines Kommissionsgeschäfts: →Kommission.\" (G. Michels, \"Kommende\", in: LexMA 5, Sp. 1278-1279)"@de ;
  skos:example "RG IV 01692: Conradus Conhouer (Konhofer) aud. cap. pape: de conf. can. et preb. Patav. et Ratisbon. ac par. eccl. in Galkbeis Patav. dioc., n. o. commenda mon. s. crucis e. m. Eistet., lite sup. decan. Patav. ac can. et preb. et celeraria August. 7 febr. 1418 S 109 215r."@la .


:Segenerhalt a owl:Class ;
  rdfs:subClassOf :Objekt ;
  :stringInRG "munus bened."@la ;
  rdfs:label "Segenerhalt"@de ;
  skos:definition "Segenerhalt bezeichnet einen thematischen Bezugspunkt, auf den sich eine Lizenz bezieht, wenn einer Person gestattet wird, einen kirchlichen Segen von einem dazu befugten Amtsträger zu empfangen."@de ;
  skos:example "RG I 00128: […] lic. recipiendi munus bened. a quocunque antistite […]"@la .


:Bakkalaureat a owl:Class ;
  rdfs:subClassOf :Akademischer_Grad ;
  :stringInRGX "baccalarius"@la ,
  "baccalauriatus"@la ;
  :stringInRG "bac."@la ;
  rdfs:label "Bakkalaureat"@de ;
  skos:definition """Niedrigster akademischer Grad.

\"[…] Zw. 1250 und 1275 wird b. zu einem festen institutionellen Begriff. Man wurde b. nach einem bestimmten, nach Fakultäten unterschiedlich langen Studium, nachdem man vor einem aus Magistern zusammengesetzten Prüfungsausschuß mit Erfolg ein Vorexamen (responsiones) abgelegt und in einer Disputation die Fähigkeit der Schlußfolgerung (determinatio) erwiesen hatte. Der b. war danach berechtigt, selbständig bestimmte Texte zu »lesen«, meistens in kursor. Weise (cursorie, extraordinarie) und mit wörtl. Kommentierung. Er nahm auch aktiv an Disputationen teil, sei es als respondens oder als opponens, und konnte schließlich für ein Lizentiat kandidieren. Dieser Übergang von einem bloßen Status zu einem eigtl. Universitätsgrad findet sich weniger in den Universitäten des Südens als in Paris und v.a. in Oxford, wo die Prüfungen der determinationes große Bedeutung hatten und wo der Titel b. durch den Kanzler verliehen wurde, während er sonst im wesentl. eine Beförderung im Rahmen der Klasse eines Magisters ohne Beteiligung der Aufsichtsbehörden blieb. In den theol. Fakultäten wurden sogar verschiedene Grade des b. unterschieden: Nach einem Studium (audire) von sieben oder acht Jahren erhielt der Student als b. cursor oder biblicus das Recht, über die Bibel zu lesen. Dann durfte er nach einem weiteren Examen (disputatio tentativa) als b. sententiarius über die Libri Sententiarum des Petrus Lombardus lesen. Nach dieser Lehrtätigkeit blieb er eine gewisse Zeit b. formatus mit der einzigen Verpflichtung, sich an Disputationen zu beteiligen, bis er sich um ein Lizentiat in Theologie bewerben konnte. […]\" (J. Verger, \"Baccalarius\", in: LexMA 1, Sp. 1323)."""@de ;
  skos:example "Bakkalaureat in Geisteswissenschaften: bac. ... in art. (RG 2/715)"@la ,
  "Bakkalaureat in Medizin: bac. in med. (RG 2/715)"@la ,
  "Bakkalaureat in Theologie: bac. in theol. (RG 2/2543)"@la ,
  "Bakkalaureat in beiden Rechten: bac. in utr. iur. (RG 5/45)"@la ,
  """Bakkalaureat in kanonischem Recht: bac. in decr. (RG 2/51);
bac. in iur. can. (RG 2/585)"""@la ,
  "Bakkalaureat in weltlichem Recht: bac. in leg. (RG 4/755)"@la .


:Anhaenger a owl:Class ;
  rdfs:subClassOf :Personenzuschreibung ;
  :stringInRGX "adherens"@la ;
  :stringInRG "adher."@la ;
  rdfs:label "Anhänger"@de ;
  skos:definition "Eine Person hängt einer anderen Person (z.B. Gegenpapst) oder einem Konzil (Basel) an. Bei Gegenpäpsten wird nicht der gewählte Papstname, sondern der Geburtsname gesetzt."@de ;
  skos:example "RG II 00025: Bertrandus olim. abb. mon. s. Antonii Vienn. o. s. Aug. Roberto adher. m. exig. a. d. abb. pecunias ante adhesionem collectas 2 aug. 1388 V 311 265v."@la .


:Weihurkunde a owl:Class ;
  rdfs:subClassOf :Gnadenerweis ;
  :stringInRGX "littera testimonialis"@la ;
  :stringInRG "litt. testimonialis"@la ;
  rdfs:label "Weihurkunde"@de ;
  skos:definition """Beurkundung einer Weihe oder eines Amtes

\"Viele Kandidaten ließen sich nach erfolgter Weihe eine Bescheinigung ausstellen, in der in der Regel alle in Rom erhaltenen Weihen aufgelistet sind. In diesen litt. testim. (littere testimoniales) werden der/die erhaltene(n) Weihegrad(e), das Datum und der/die Ort(e) der Weihe(n) festgehalten. Falls auf eine vorher erhaltene Supplik Bezug genommen wird, wird dies in Klammern ergänzt.\" (RG Bearbeitungshinweise, S. 76)

\"Ein Notar war zur Stelle, um die Kandidaten namentlich aufzurufen und um nach der Zeremonie die vollzogene Weihe in Form einer sog. littera testimonialis bzw. (littera) formata zu beurkunden. Einem Kammerkleriker oblag es, die littere formate in den Registern der gleichnamigen Serie (in stark gekürzter Form) zu kopieren.\" (Andreas Rehberg, Deutsche Weihekandidaten in Rom am Vorabend der Reformation, 2005; in: FS Brigide Schwarz, p. 277-305, hier: S. 280)

\"Um 1500 erfuhr das System der Weihen in Rom starke Veränderungen, die sich auch im Aufbau der Libri formatarum, besonders zwischen den Bänden 12 (1496–1503) und 13 (15011521), beobachten lassen. Die beiden bis 1524 reichenden Bände des 16. Jahrhunderts (ASV, Cam. Ap., Libri format. 13 und 14) verzeichnen im Gegensatz zu den Bänden des Quattrocento nicht mehr die Teilnehmer an den ordinationes generales und Dimissorialbriefe, sondern nur noch littere testimoniales, d. h. die eigentlichen (littere) formate.\" (Andreas Rehberg, Deutsche Weihekandidaten in Rom am Vorabend der Reformation, 2005; in: FS Brigide Schwarz, p. 277-305, hier: S. 278, Fn. 7)"""@de ;
  skos:example "RG II 01914: Fredericus Rese cler. Magunt. in palat. in officio foliarie serviens littera testimonialis […]"@la ,
  "RG IV 03763: […] litt. testimonialis quod tempore Bonifatii IX collector Colon. Meten. Monast. Minden. et Osnaburg. fuerat 27 iun. 1423 DC 7 284v."@la .


:Verleihungsrecht_Doktorat a owl:Class ;
  rdfs:subClassOf :Objekt ;
  :stringInRG "licentia doctorandi"@la ;
  rdfs:label "Verleihungsrecht Doktorat"@de ;
  skos:definition "Verleihungsrecht_Doktorat bezeichnet das institutionell geregelte Recht, den akademischen Grad eines Doktors zu verleihen."@de ;
  skos:example "RG IV 13013: Rostoc rect. etc. univ. studii Zwerin. dioc.: de conc. quod in casu quo ep. Zwerin. cancellarius studii seu eius deputati iuxta statuta sup. licentia doctorandi requisitus nollet dare licentiam aut dare differet rector c. ep. seu deputato et si ille hoc facere plus debito differet cum 2 seu 3 magistris licentiam concedant ipsisque scolares presententur 28 febr. 1427 S 208 9, L 274 20v."@la .


:Rechtsstatus a owl:Class ;
  rdfs:subClassOf owl:Thing ;
  rdfs:label "Rechtsstatus"@de ;
  skos:definition "Rechtsstatus bezeichnet eine Klasse zur Einordnung besonderer rechtlicher Stellung oder Privilegierung von Personen oder Institutionen."@de .


:Aenderung_des_Kollators a owl:Class ;
  rdfs:subClassOf :Nachbesserung ;
  :stringInRGX "mutatio coll."@la ,
  "mutatio collationis"@la ;
  :stringInRG "mutatio ad coll."@la ;
  rdfs:label "mutatio collatoris"@la ,
  "Änderung des Kollators"@de ;
  skos:definition "\"Hat der Petent eine Expektanz auf Pfründen bestimmter Kollatoren erhalten, so kann er später eine Änderung des Kollators erwirken (mutatio coll., so der Randvermerk in den Supplikenregistern). Die Gründe für solche Änderungswünsche (z. B. nullum fruct. consequi sperans) werden im Regest in der Regel nicht angegeben. Da es sich um die Änderung einer gr. expect. handelt, die im Grundsatz gültig bleiben soll, kann das Regest auch mit perinde val. formuliert werden.\" (Bearbeitungshinweise, S. 56)"^^xsd:string ;
  skos:example "RG IX 00955: […] motu pr. de mutatione collationis ad can. et preb. eccl. b. Marie ad Gradus Colon. loco can. et preb. d. eccl. s. Florini […]"@la .


:Degradation a owl:Class ;
  rdfs:subClassOf :Zensurstrafe ;
  :stringInRG "degradatione"@la ,
  "degradatus"@la ;
  rdfs:label "Degradation"@de ;
  skos:definition "\"Bis zum 12. Jh. syn. mit dem Begriff der →Deposition verwendet und die Absetzung eines Klerikers - auch durch weltl. Richter - bezeichnend, wurde die D. seit ca. 1200 bis hin zum Liber Sextus (1298) neu definiert. Seitdem war sie die schwerste Strafe für einen →Kleriker, denn sie allein entzog ihm seine Privilegien. Zum Ärger weltl. Instanzen durften mit der D. gewöhnlich nur geistl. Vergehen geahndet werden: die Rückfälligkeit eines schon deponierten Klerikers (incorrigibilitas), der Widerstand gegen den eigenen Bf., die →Fälschung päpstl. Urk. und v. a. die →Häresie, außerdem - weil als häret. beurteilt - das Assassinat (heimtückischer →Mord mit religiösen Motiven), →Homosexualität sowie →Hexerei. Daher blieb die D. etwa von klerikalen Mördern oder Hochverrätern für Jahrhunderte ein Konfliktpunkt zw. weltl. und kirchl. Instanzen. Die D. betraf alle Kleriker außer den Papst; Ansätze, auch ihn zu degradieren, sind in der Kanonistik erst nach 1378 infolge des →Abendländ. Schismas zu erkennen. Seit →Bonifatius VIII. bestand die D. aus zwei Akten: der »degradatio verbalis« und der »degradatio realis« oder »actualis«. Während des ersteren, der das Gerichtsverfahren abschloß, wurde die D.ssentenz verkündet. Daran mußten, spätantiken Synodalbeschlüssen folgend, außer dem Degradator selbst - je nach dem →Weihegrad des Delinquenten - unterschiedl. viele Bf.e teilnehmen. Doch gab es von dieser Bestimmung schon seit →Gregor IX. →Dispense zur besseren Bekämpfung von Ketzern. Der zweite Akt bewirkte die reale D. und wurde von einem Bf., wahrscheinl. in einer Kirche, liturg. vollzogen und bes. seit dem 14. Jh. in Ordines beschrieben. Ihnen zufolge wurden, der frühma. Tradition entsprechend, dem Delinquenten zuerst nacheinander alle liturg. Geräte und Gewänder, die zum jeweiligen Weihegrad gehörten, entzogen. War der Bestrafte Priester oder Bf., so entfernte ihm der Degradator gewöhnl. auch das Fleisch von den Weihefingern mit einem Messer oder einer Glasscherbe. Allen Degradierten wurde schließlich mit einer Schere, Scherbe oder Schneide die →Tonsur abgekratzt, was dem Skalpieren nahekam. Zum Abschluß empfing den Degradierten der anwesende weltl. Richter zur Aburteilung. Die dabei obligator. Bitte seitens des Degradators, den Degradierten nicht zu töten oder zu verstümmeln, bildete gewöhnl. eine bloße Formalie, denn die meisten Bestraften waren Häretiker, denen schon Gregor IX. den Feuertod bestimmt hatte. Auch, daß der Papst einen Degradierten restituieren konnte und dieser den character indelebilis behielt, blieb meist reine Theorie, denn der D. folgte gewöhnl. sofort die Hinrichtung.\" (B. Schimmelpfennig, \"Degradation\", in: LexMA 3, Sp. 637-638)."@de ;
  skos:example "RG IV 10476: Maguntia aep.: et Trever. Colon. Salzeburg. Magdeburg. Bremen. Rigen. Strigon. et Gneznen. aep. ac Frising. Bamberg. Ratisbon. Patav. Olomuc. Cracov. Poznan. Luthomisl. et Nitricen. ep. necnon Romanorum Ungarie et Polonie reges et duces Bavarie Saxonie Austrie et Slesie ac Brandenburg. Misnen. et Moravie marchiones etc.: notitia sup. degradatione Conradi aep. Prag. 2 ian. 1426 V 358 156v."@la ,
  "RG V 00284: Andreas Michaelis Wacien. dioc., propter hereseos, quos unac. nonnullis aliis regni Bohemie personis credidit, omn. s. ord. degradatus m. Jacobo de Marchia o. fr. min. in Ungaria et nonnullis aliis locis inquisitori, ut ipsum A. M. absolvat et restituat ad exec. s. ord. [MHI II 492, p. 151] 22. iul. 1437 V 366 242vss."@la .


:Fabbriche_I a owl:Class ;
  rdfs:subClassOf :Fondo_Camerale_Primo_I ;
  :stringInRG "Fabbriche"^^xsd:string ;
  :bezieht_sich_auf_RG-Band "RG V"^^xsd:string ;
  rdfs:label "Fabbriche (I)"@de ;
  skos:altLabel "Archivio di Stato di Roma, Fondo Camerale I, Fabbriche"@la ;
  skos:definition "Fabbriche bezeichnet eine kuriale Überlieferungseinheit, deren Inhalt in einem oder mehreren Einträgen des Repertorium Germanicum verarbeitet ist. Die Überlieferung beinhaltet beispielsweise Ausgaben für Baumaßnahmen, vornehmlich an römischen Kirchen. Die handschriftlichen Texte sind im Allgemeinen schwer lesbar."@de .


:Stadt a owl:Class ;
  rdfs:subClassOf :Ort ;
  :stringInRGX "civitas"@la ,
  "opidum"@la ,
  "oppidum"@la ;
  :stringInRG "op."@la ,
  "opid."@la ,
  "opp."@la ;
  rdfs:label "Stadt"@de ;
  skos:definition """\"Eine Stadt […] ist eine größere, zentralisierte und abgegrenzte Siedlung im Schnittpunkt größerer Verkehrswege mit einer eigenen Verwaltungs- und Versorgungsstruktur. […]\"

(https://de.wikipedia.org/wiki/Stadt)

\"[…] Der S.begriff der Zeit [= 14. Jh.] ergibt sich aus den →S.rechten, die die S. in vier Punkten vom Land unterscheiden: 1. Sie besaß eine aus Freien bestehende (Hörige ausschließende) Bürgergemeinde, 2. sie war Marktort mit tägl. Marktbetrieb, 3. für ihr Gebiet bestand ein bes. Gerichtsbezirk, 4. sie war hinsichtl. der öffentl. Lasten bevorzugt. […]\"

\"[…] Um 1320 gab es in Deutschland nahezu 4000 S.e, darunter etwa 50 Großs.e mit mehr als 50 ha Fläche und über 5000 Einwohnern sowie etwa 200 Mittels.e mit 20-50 ha Fläche und 2000 bis 5000 Einwohnern; den Rest bildeten Kleins.e. […]\"

(E. Pitz, \"Stadt\", in: LexMA 7, Sp. 2176-2178)"""@de ;
  skos:editorialNote "Achtung: Die Bezeichnung opid. kann sowohl für die Stadt als auch für den Stadtbewohner stehen."@de ;
  skos:example "RG IV 00004: Abraham de Monaco iudeus in op. Ingelstad Eistet. dioc. relaxatur iuramentum solvendi certam summam extortum p. Swiggerum de Gundelfingen iun. armig. Frising. dioc. 27 nov. 1420 L 212 21r."@la .


:Statut_Kardinal a owl:Class ;
  rdfs:subClassOf :Statut ;
  :stringInRGX "statutis card. s. Clementis"@la ;
  rdfs:label "Statut Kardinal"@de ;
  skos:definition "Statut_Kardinal bezeichnet im RG den Bezug auf meist nicht weiter ausgeführte Statuten, die von Kardinälen ausgingen."@de ;
  skos:example "RG II 00681: […] n. o. statutis editis p. card. Brandam […]"@la ,
  "RG IV 04754: […] n. o. statutis card. s. Clementis […]"@la .


:Fuerstentum a owl:Class ;
  rdfs:subClassOf :Ort ;
  :stringInRGX "princeps"@la ;
  rdfs:label "Fürstentum"@de ;
  skos:definition "Der Begriff Fürstentum bezeichnet das Herrschaftsgebiet eines Fürsten. (Wiki)"@de ;
  skos:example "RG VIII 05977: Wratislav. Univers. civit. W. civ., proconsules et civit. W.: de conf. privil. Caroli IV. R. I. et Bohemie regis p. Sigismundum R. I. conf. quod nullus princeps , bar. , nob. , mil. , civ. aut al. persona ad actoris cuiusquam instantiam extra regnum Bohemie et regalis curie iudicium citari val. 24. sept. 1463 S 570 93rss."@la .


:Ehrenkaplan a owl:Class ;
  rdfs:subClassOf :Kaplan ;
  :stringInRG "cap. hon."@la ;
  rdfs:label "Ehrenkaplan"@de ;
  skos:definition "Vom Papst verliehener Ehrentitel."@de ;
  skos:example "RG II 00113: Johannes de Appeldornenbeke can. mon. Cappenberg. Prem. o. Monast. dioc. cap. hon. 15 apr. 1383 K 22v."@la .


:Versoehnung a owl:Class ;
  rdfs:subClassOf :Objekt ;
  :stringInRGX "reconciliandi"@la ;
  rdfs:label "Versöhnung"@de ,
  "reconciliatio"@la ;
  skos:definition """Die Vollmacht zur Wiederherstellung kirchlicher Reinheit oder Gemeinschaft, sei es durch die rituelle Reinigung verunreinigter Kirchenräume oder durch die Reintegration von Personen in die Kirche.

\"Bei Verunreinigung von Kirchenräumen (effusio sanguinis, seminis) wird die Möglichkeit der rituellen Reinigung eingeräumt. Kommt sehr selten vor.\" (Bearbeitungshinweise, S. 61)"""@de ;
  skos:example "RG III 00353: […] fac. reconciliandi adher. Ang. in dioc. Verden. […]"@la ,
  "RG IX 05308: […] de fac. reconciliandi d. eccl. et eius cimit. […]"@la .


:Reichsstadt a owl:Class ;
  rdfs:subClassOf :Stadt ;
  rdfs:label "Reichsstadt"@de ;
  skos:definition "\"[Reichsstädte] stellen wie die von ihnen zu unterscheidenden →Freien Städte einen bes. Typus der dt. Stadt- und Verfassungsgesch. dar, insofern sich diese ursprgl. kgl. →Städte der Stauferzeit im Zuge der Ausgestaltung ihrer Ratsverfassung (→Rat, städt.) unterschiedl. weit von der direkten Stadtherrschaft des Kg.s emanzipierten und ein so hohes Maß an Freiheiten (→Privilegien, städt.) und fakt. Autonomie gewannen, daß sie um 1500 eine - nicht gleichberechtigte - Mitwirkung an den ständ. Reichsgremien sowie in der NZ den Charakter »selbstmechtiger«, wenngleich weiterhin durch stadtherrl. Relikte und die Obrigkeit des Ks.s abhängiger Stadt»staaten« erlangten.\" (Paul-Joachim Heinig, \"Reichsstädte\", in: LexMA 7, Sp. 637–639)."@de .


:Statut_Dioezese a owl:Class ;
  rdfs:subClassOf :Statut ;
  :stringInRGX "statutis d. Gneznen. dioc."@la ;
  rdfs:label "Statut Diözese"@de ;
  skos:definition "Statut_Diözese bezeichnet im RG den Bezug auf meist nicht weiter ausgeführte diözesane Statuten."@de ;
  skos:example "RG V 06172: […] n.o. <statutis d. Gneznen. dioc. et quod iuram. in absentia prestet>, prov. de can. et preb. […]"@la .


:Priorat a owl:Class ;
  rdfs:subClassOf :Kloster ;
  :stringInRGX "prioratus"@la ;
  rdfs:label "Priorat"@de ;
  skos:definition "\"Priorat bez. ursprünglich Amt u. Würde eines Priors, des Leiters einer rel. Gemeinschaft, später den 'Zweiten' nach dem Abt einer monast. Gemeinschaft. Sit dem frühen MA setzt sich die Bedeutung durch: Haus einer rel. Gemeinschaft, das nicht Abtei ist (abbatiola, cella, monasteriolum, praepositura). Rechtlich sind zwei Arten zu unterscheiden: das einfache P[riorat], ein K[loster], das völlig v. seinem Gründungsk[loster] abhängig ist, u. das Konventual-P[riorat], ein K[loster] sui iuris, das zwar finanziell u. organisatorisch autonom ist, aber nicht z. Abtei erhoben wurde.\" (Dominicus M. Meier, \"Priorat\", in: LThK 8, Sp. 598)"@de ;
  skos:example "RG IV 05084: Henricus de Seyn prior prioratus Montis s. Remigii o. s. Ben. Magunt. dioc. de com. gen. subdiac. de n. prom. ad ord. 23 oct. 1420 S 147 183v."@la .


:Annexkapelle_einer_Pfarrkirche a owl:Class ;
  rdfs:subClassOf :Kapelle ;
  :stringInRGX "in capella corp. Christi annexa par. eccl. b. Marie Premslauien. Camin. dioc."@la ;
  rdfs:label "Annexkapelle einer Pfarrkirche"@de ;
  skos:definition "Eine Kapelle, die sich in einer Pfarrkirche befindet."@de ;
  skos:example "RG IV 01603: Conradus Baldewini (Balduini) de archidiac. Usnamen. in eccl. Camin. ac de can. sub expect. preb. d. eccl. vac. p. n. prom. Sanderi de Bonow, n. o. vicar. eccl. s. Nicolai, in eccl. b. Marie Gripenwalden., in capella corp. Christi annexa par. eccl. b. Marie Premslauien. Camin. dioc. 30 oct. 1418 S 116 220r, L 197 109v."@la .


:Klosterreform a owl:Class ;
  rdfs:subClassOf :Objekt ;
  :stringInRG "visitandi et reformandi mon."@la ;
  rdfs:label "Klosterreform"@de ;
  skos:definition "Klosterreform bezeichnet Maßnahmen zur Erneuerung und Neuordnung des klösterlichen Lebens, insbesondere zur Wiederherstellung oder Verschärfung der Ordensdisziplin und Verwaltung."@de ;
  skos:example "RG II 01505: […] m. reformandi et visitandi nonnulla mon. in Almania […]"@la ,
  "RG IX 00033:[…] de fac. visitandi et reformandi mon. […]"@la .


:Regens_der_Kanzlei a owl:Class ;
  rdfs:subClassOf :Kuriales_Amt ;
  :stringInRGX "offic. locumtenentie seu regentis cancellarie"@la ,
  "officium cancellarie regens"@la ;
  rdfs:label "Regens der Kanzlei"@de ;
  skos:definition "\"Stellvertreter des →Vizekanzlers in der päpstl. →Kanzlei. Zunächst nur bei Bedarf vom Vizekanzler oder Papst ernannt, wird das Amt seit dem späten 15. Jh. ein ständiges.\" (Th. Frenz, \"Regens cancellariam\", in: LexMA 7, Sp. 563)"@de ;
  skos:example "RG II 09402: Roterus de Balhorn mag. not. et officium cancellarie regens litt. passus 8 oct. 1409 V 337 127. pape protonotarius: iurat offic. locumtenentie seu regentis cancellarie 19 ian. 1413 Arm. XXXIV 4 87."@la .


:Sinekure a owl:Class ;
  rdfs:subClassOf :Pfruendenpflicht ;
  :stringInRG "s. c."@la ,
  "s.c."@la ,
  "sine cura"@la ;
  rdfs:label "Sinekure"@de ;
  skos:definition "Eine Sinekure bezeichnet eine kirchliche Pfründe ohne Seelsorgeverpflichtung."@de ;
  skos:example "RG VIII 00010: Adam Hofmaister de Froydenperg cler. Ratisbon. dioc. de perp. s. c. benef. sive capel. s. Oswaldi in civit. Ratisbon. (4 m. arg. ) vac. p. o. Stephani Buchmer 2. oct. 1463 S 556 159v."@la .


