:Instrumenta_Miscellanea_I a owl:Class ;
  rdfs:subClassOf :Kuriale_Ueberlieferungseinheit ;
  :stringInRG "IM"^^xsd:string ,
  "Instr. Misc."^^xsd:string ;
  :bezieht_sich_auf_RG-Band "RG II"^^xsd:string ,
  "RG IV"^^xsd:string ,
  "RG IX"^^xsd:string ,
  "RG V"^^xsd:string ,
  "RG X"^^xsd:string ;
  rdfs:label "Instrumenta_Miscellanea (I)"@de ;
  skos:altLabel "Arch. Vat. Instrum. Miscellanea 336"^^xsd:string ,
  "Archivio Segreto Vaticano, Instrumenta Miscellanea"@la ;
  skos:definition "Instrumenta Miscellanea bezeichnet eine kuriale Überlieferungseinheit, deren Inhalt in einem oder mehreren Einträgen des Repertorium Germanicum verarbeitet ist. Es handelt sich um eine Sammlung von Einzelblättern und Faszikeln unterschiedlichster Art und Herkunft."@de ;
  skos:editorialNote "IM (RG II, RG IV, RG V), Instr. Misc. (RG IX, RG X)"^^xsd:string ,
  "Im RG X steht dazu: \"Es handelt sich um Einzelstücke mit den Nummern Instr. Misc. 3921, Instr. Misc. 5409 und Instr. Misc. 7305.\" Diese Angabe stimmen auch mit den entsprechenden Nummern."^^xsd:string .


:Weltliche_Institution a owl:Class ;
  rdfs:subClassOf :Institution ;
  rdfs:label "Weltliche Institution"@de ;
  skos:definition "Eine weltliche Institution ist eine Institution innerhalb des heiligen Römischen Reiches, die einem politisch-administrativen Zweck dient."@de .


:Begarden a owl:Class ;
  rdfs:subClassOf :Religioese_Laienvereinigung ;
  :stringInRGX "Begardorum"@la ;
  rdfs:label "Begarden"@de ;
  skos:definition "\"Begarden waren Angehörige semireligiöser Gemeinschaften von Männern. Sie widmeten sich häufig der Krankenpflege und Totenbestattung. Die Begardenbewegungen entstanden um 1220 in den Niederlanden. Sie waren weit weniger verbreitet als die Beginen. Sie verdienten ihren Lebensunterhalt mit Betteln und handwerklichen Tätigkeiten (vor allem Weben), existierten vor allem zwischen dem 13. und 15. Jahrhundert und gerieten nicht selten unter Häresieverdacht.\" (https://database.factgrid.de/wiki/Item:Q640843)"@de ;
  skos:example "RG III 01031: Jacobus prep. mon. in Walsse Constant. dioc. m. (Johanni dec. eccl. Trident. apud cur. commor. ) priv. de sua prepos., quia perversum modum celebrandi div. off. in presentia Begardorum vel Beginarum in eccl. dicti mon. permiserat 8 dec. 1414 L 176 267."@de .


:Studienganggruendung a owl:Class ;
  rdfs:subClassOf :Gruendung ;
  :stringInRGX "fundandi studium generale"@la ;
  rdfs:label "Studienganggründung"@de ;
  skos:definition "Studienganggründung bezeichnet den durch eine kirchliche und/oder weltliche Autorität genehmigten Vorgang der Einrichtung eines organisierten Studienbetriebs."@de ;
  skos:example "RG IV 02770: Ericus rex Dacie etc. (et Pomeranie dux) de lic. fundandi studium generale 26 ian. 1419 S 120 254."@la .


:Acquisti a owl:Class ;
