@prefix : <http://hisqu.de/rg_ontology/ontology/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rg: <http://hisqu.de/rg_ontology/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@base <http://hisqu.de/rg_ontology/ontology/> .

<http://hisqu.de/rg_ontology/ontology/> a owl:Ontology .

#################################################################
#    Annotation properties
#################################################################

:stringInRGX a owl:AnnotationProperty ;
  rdfs:label "stringInRGX"@de ;
  skos:definition "Diese Annotation Property dient der Angabe eines Strings aus dem RG, der einer Klasse beispielhaft einen sprachlichen Ausdruck zuweist. Sie wird verwendet, wenn eine vollständige Erfassung aller im RG vorkommenden Bezeichnungen oder Formulierungsvarianten nicht praktikabel ist. Der angegebene String kann dabei ein exaktes Match im Sinne von stringInRG sein, zugleich aber auf weitere mögliche Deklinations- oder Flexionsvarianten verweisen (z. B. Dispens: dispensatio, dispensationis, ...), oder ein einzelnes Beispiel für eine Klasse darstellen, deren weitere Belege im RG in teilweise stark abweichenden Formulierungen erscheinen können (z. B. Rückerstattung von bereits geleisteten Zahlungen: recip. 20 fl. adc. quos dudum solvit)."@de .


:stringInRG a owl:AnnotationProperty ;
  rdfs:label "stringInRG"@de ;
  skos:definition "Diese Annotation Property dient der Angabe eines Strings aus dem RG, der einer Klasse oder Instanz einen konkreten sprachlichen Ausdruck zuweist. Der Anspruch eines exakten Matches gilt dabei insbesondere für RG-Abkürzungen (z. B. disp.) sowie für feste Formulierungen (z.B. aud. litt. contradictarum)."@de ;
  skos:editorialNote """Die Angaben sind nicht vollständig (disp., dispensatione, dispensatum [...]). 

Oft sind Wörter durch Konjugation bzw. Deklination leicht abgewandelt.

Bei sprachlichen Ausdrücken, die aus mehr als einem Wort bestehen, können die Bestandteile in unterschiedlicher Reihenfolge erscheinen. 

Durch doppelte Belegung derselben Abkürzung (z.B. d.) im RG, können Verwechslungen auftreten."""@de .


:bezieht_sich_auf_RG-Band a owl:AnnotationProperty ;
  rdfs:label "bezieht sich auf RG-Band"@de ;
  skos:editorialNote "Diese Annotation Property dient dazu kenntlich zu machen, in welchen RG-Bänden eine bestimmte Fundstelle überhaupt erwähnt wird."@de ;
  rdfs:range xsd:string ;
  rdfs:domain :Fundstelle .


:owl:inverseOf a owl:AnnotationProperty ;
  rdfs:label "owl:inverseOf"@de ;
  skos:definition "Diese Annotation Property dient der Deklaration zweier Properties als invers zueinander."@de .


###  http://www.w3.org/2000/01/rdf-schema#label
rdfs:label skos:definition "Diese Annotation Property dient der Vergabe der primären Bezeichnung einer Klasse oder Property und stellt den bevorzugten, menschenlesbaren Namen des jeweiligen Konzepts dar."@de .


###  http://www.w3.org/2004/02/skos/core#altLabel
skos:altLabel a owl:AnnotationProperty ;
  skos:definition "Diese Annotation Property dient der Vergabe alternativer Bezeichnungen für eine Klasse oder Property in derselben Sprache, während Bezeichnungen in unterschiedlichen Sprachen über separate rdfs:label (z. B. de, en, la) vergeben werden."@de .


###  http://www.w3.org/2004/02/skos/core#definition
skos:definition a owl:AnnotationProperty ;
  skos:definition "Diese Annotation Property dient der formalen inhaltlichen Definition einer Klasse oder Property und beschreibt deren Bedeutung und intendierte Verwendung."@de ;
  skos:editorialNote "Zur Angabe von Definitionen."@de .


###  http://www.w3.org/2004/02/skos/core#editorialNote
skos:editorialNote a owl:AnnotationProperty ;
  skos:definition "Diese Annotation Property dient der Kommentierung von Klassen und Properties und ermöglicht die Aufnahme redaktioneller Hinweise, Erläuterungen oder Modellierungsentscheidungen, die nicht Teil der formalen Definition sind."@de .


###  http://www.w3.org/2004/02/skos/core#example
skos:example a owl:AnnotationProperty ;
  skos:definition "Diese Annotation Property dient der Angabe von Beispielen aus dem RG, in denen eine bestimmte Klasse oder Property deutlich wird."@de .


#################################################################
#    Datatypes
#################################################################

###  http://www.w3.org/2001/XMLSchema#date
xsd:date a rdfs:Datatype ;
  rdfs:label "xsd:date"@de .


###  http://www.w3.org/2001/XMLSchema#duration
xsd:duration a rdfs:Datatype ;
  rdfs:label "xsd:duration"@de .


#################################################################
#    Object Properties
#################################################################

:erworben_im_Fach a owl:ObjectProperty ;
  rdfs:subPropertyOf owl:topObjectProperty ;
  rdfs:domain :Akademischer_Grad ;
  rdfs:range :Studienfach ;
  rdfs:label "erworben im Fach"@de ,
  "obtained in subject"@en ;
  skos:definition "Diese Property ordnet einem akademischen Grad ein Studienfach zu und dient der Spezifikation des fachlichen Bereichs, in dem der akademische Grad erworben wurde."@de .


:hat_Entsender a owl:ObjectProperty ;
  rdfs:subPropertyOf :hat_Beteiligten ;
  rdfs:domain :Entsendung ;
  rdfs:range :Person ;
  rdfs:label "hat Entsender"@de ;
  skos:definition "Eine Instanz von E39 Actor, die eine Person irgendwohin entsendet."@de .


:hat_Ehepartner a owl:ObjectProperty ;
  rdfs:subPropertyOf :hat_Familienbeziehung_zu ;
  rdfs:domain :Person ;
  rdfs:range :Person ;
  :owl:inverseOf "ist Ehepartner von"@de ;
  rdfs:label "has spouse"@en ,
  "hat Ehepartner"@de ;
  skos:definition "Diese Property stellt eine eheliche Beziehung zwischen zwei Instanzen der Klasse Person her und gibt an, dass die eine Person Ehepartner der anderen Person ist."@de .


:hat_Zahlungszusager a owl:ObjectProperty ;
  rdfs:subPropertyOf :hat_Beteiligten ;
  rdfs:domain :Zahlungsverpflichtung ;
  rdfs:range :Person ;
  rdfs:label "hat Zahlungszusager"@de ;
  skos:definition "Eine Instanz von Akteur, die sich zu einer Geldzahlung verpflichtet."@de .


:hat_Weihegrad a owl:ObjectProperty ;
  rdfs:subPropertyOf owl:topObjectProperty ;
  rdfs:domain :Person ;
  rdfs:range :Weihegrad ;
  rdfs:label "has order"@en ,
  "hat Weihegrad"@de ;
  skos:definition "Diese Property ordnet einer Person einen Weihegrad zu."@de .


:hat_Delegierten_Richter a owl:ObjectProperty ;
  rdfs:subPropertyOf :hat_Prozessvorsteher ;
  rdfs:domain :Gerichtsprozess ;
  rdfs:range :Person ;
  :stringInRG "iudex delegatus"@la ;
  :owl:inverseOf "nimmt teil an als Delegierter Richter"@de ;
  rdfs:label "had delegated judge"@en ,
  "hat Delegierten Richter"@de ;
  skos:definition "Diese Property verbindet eine Instanz der Activity Gerichtsprozess mit einer Person, die von einer Institution oder einer anderen, höher stehenden Person mit der temporären Amtsgewalt eines Richters ausgestattet wurde, wobei diese Amtsgewalt zeitlich, lokal oder fallspezifisch beschränkt sein kann."@de ;
  skos:example "RG V 05061: […] [Johannes Schele] ep. Lubic., iudex delegatus in lite abb. etc. mon. Montismaioris o. s. Ben. Arelaten. dioc. contra abb. etc. o. s. Aug. mon. s. Antonii Viennen. dioc. […]"@la .


:fand_statt_in a owl:ObjectProperty ;
  rdfs:subPropertyOf owl:topObjectProperty ;
  rdfs:domain :Ereignis ;
  rdfs:range :Ort ;
  rdfs:label "fand statt in"@de ;
  skos:definition "Diese Property beschreibt den räumlichen Ort einer Instanz von E4 Zeitraum (und dessen Unterklasse E5 Ereignis).\" This property describes the spatial location of an instance of E4 Period [und deren Unterklasse E5 Event].\" (CIDOC)"@en ;
  skos:editorialNote "http://www.cidoc-crm.org/cidoc-crm/P7_took_place_at"@en .


:hat_Zahler a owl:ObjectProperty ;
  rdfs:subPropertyOf :hat_Beteiligten ;
  rdfs:domain :Geldzahlung ;
  rdfs:range :Person ;
  rdfs:label "hat Zahler"@de ;
  skos:definition "Eine Instanz von Akteur, die eine Geldzahlung leistet."@de .


:hat_Fuersprecher a owl:ObjectProperty ;
  rdfs:subPropertyOf :hat_Beteiligten ;
  rdfs:domain :Aktivitaet ;
  rdfs:range :Person ;
  :stringInRG "supplic."@la ,
  "supplicante"@la ;
  :owl:inverseOf "nimmt teil an als Fürsprecher"@de ;
  rdfs:label "had intercessor"@en ,
  "hat Fürsprecher"@de ;
  skos:definition "Diese Property verbindet eine Aktivität mit der Person, die für einen Petenten Fürsprache an der Kurie einlegt, wobei der Fürsprecher nicht selbst an der Kurie anwesend sein muss und es sich in der Regel um eine prominente Person handelt."@de ;
  skos:example "Albertus Holteker cler. Magunt. de (Johanne de Feys datario pro fam. supplic. ) benef. Avinion. 21 apr. 1420 S 141 121v."@la ,
  "RG IX 00026: Admont Abb. et conv. mon. A. o.s. Ben. Salzeburg. dioc. : supplic. Friderico R.I. de indulg. 5 an. pro par. eccl. b. Marie Cholben Salzeburg. dioc. d. mon. incorp."@la .


:hat_abweichenden_Gnadenempfaenger a owl:ObjectProperty ;
  rdfs:subPropertyOf :hat_Beteiligten ;
  rdfs:domain :Gnadenerweis ;
  rdfs:range :Person ;
  rdfs:label "hat abweichenden Gnadenempfänger"@de ;
  skos:definition "In den allermeisten Ereignissen vom Typ Gnadenerweis ist der Petent auch gleichzeitig der Gnadenempfänger. Manchmal kommt es jedoch vor, dass ein Petent für eine andere Person um eine Gnade bittet. Der Begünstigte wird über diese Property mit dem Ereignis verbunden."@de .


:hat_Gegenstand a owl:ObjectProperty ;
  rdfs:subPropertyOf owl:topObjectProperty ;
  rdfs:domain owl:Thing ;
  rdfs:range owl:Thing ;
  rdfs:label "has subject"@en ,
  "hat Gegenstand"@de ;
  skos:definition "Diese Property spezifiziert den thematischen oder inhaltlichen Fokus einer Klasseninstanz, ohne eine weitergehende oder spezifische Festlegung der Art der Beziehung vorzunehmen."@de ;
  skos:example "Gnadenerweis vom Typ Absolution hat ein Gewaltdelikt zum Gegenstand."@de .


:hat_Rechtsklausel a owl:ObjectProperty ;
  rdfs:subPropertyOf owl:topObjectProperty ;
  rdfs:domain :Aktivitaet ;
  rdfs:range :Non-Obstanz ;
  rdfs:label "has legal clause"@en ,
  "hat Rechtsklausel"@de ;
  skos:definition "Diese Property stellt die Beziehung zwischen einer Instanz der Klasse E7 Aktivität und einer Non-Obstanz-Formel her."@de .


:hat_studiert_an a owl:ObjectProperty ;
  rdfs:subPropertyOf owl:topObjectProperty ;
  rdfs:domain :Person ;
  rdfs:range :Universitaet ;
  rdfs:label "hat studiert an"@de ,
  "studied at"@en ;
  skos:definition "Diese Property verbindet eine Person mit einer Universität, an der sie studiert hat."@de .


:hat_Geschwister a owl:ObjectProperty ;
  rdfs:subPropertyOf :hat_Familienbeziehung_zu ;
  rdfs:domain :Person ;
  rdfs:range :Person ;
  :owl:inverseOf "ist Geschwisterteil von"@de ;
  rdfs:label "has sibling"@en ,
  "hat Geschwister"@de ;
  skos:definition "Diese Property stellt eine familiäre Beziehung zwischen zwei Instanzen der Klasse Person her und gibt an, dass die beteiligten Personen Geschwister sind."@de .


:hat_Zahlungsempfaenger a owl:ObjectProperty ;
  rdfs:subPropertyOf :hat_Beteiligten ;
  rdfs:domain :Geldzahlung ;
  rdfs:range :Akteur ;
  :owl:inverseOf "nimmt teil an als Zahlungsempfänger"@de ;
  rdfs:label "had payment recipient"@en ,
  "hat Zahlungsempfänger"@de ;
  skos:definition "Diese Property verbindet eine Instanz der Activity Geldzahlung mit einem Akteur, der das Geld erhält."@de .


:ist_Mitglied_einer_Institution a owl:ObjectProperty ;
  rdfs:subPropertyOf owl:topObjectProperty ;
  rdfs:domain :Person ;
  rdfs:range :Institution ;
  rdfs:label "is a member of an institution"@en ,
  "ist Mitglied einer Institution"@de ;
  skos:definition "Diese Property stellt die Beziehung zwischen einer Instanz der Klasse Person und einer Institution her und gibt an, dass die Person Mitglied dieser Institution ist."@de .


:hat_Prozessvorsteher a owl:ObjectProperty ;
  rdfs:subPropertyOf :hat_Prozessbeteiligten ;
  rdfs:domain :Gerichtsprozess ;
  rdfs:range :Person ;
  :stringInRG "iudex"@la ,
  "officialis"@la ;
  :owl:inverseOf "nimmt teil als Prozessvorsteher"@la ;
  rdfs:label "had presiding authority"@en ,
  "hat Prozessvorsteher"@de ;
  skos:definition "Diese Property verbindet eine Instanz der Activity Gerichtsprozess mit einer Person, die in einem Gerichtsprozess als Richter auftritt."@de ;
  skos:editorialNote """Die sperrige Bezeichnung \"Prozessvorsteher\" (statt eingängiger \"Richter\") ist dem Umstand geschuldet, dass nicht nur amtliche \"Richter\" (vgl. WeltlichesAmt) als Richter auftreten, sondern auch der \"Offizial\", \"Delegierter Richter\" o.ä.

Der Prozessvorsteher wird oft über ein Präpositionalobjekt mit \"coram + Name des Richters\" angegeben."""@de ;
  skos:example "RG IV 00007: […] sup. quib. litig. contra Johannem de Hamelburgh presb. coram Johanne Sindra officiali Patav. 29 apr. 1423 L 235 105v."@la ,
  "RG V 01395: [...] iudex in lite sup. benef. Leod. dioc. […]"@la .


:hat_Kommissionsempfaenger a owl:ObjectProperty ;
  rdfs:subPropertyOf :hat_Beteiligten ;
  rdfs:domain :Kommissionsvermerk ;
  rdfs:range :Person ;
  :owl:inverseOf "nimmt teil an als Kommissionsempfänger"@de ;
  rdfs:label "had commission recipient"@en ,
  "hat Kommissionsempfänger"@de ;
  skos:editorialNote "Diese Property verbindet einen Kommissionsvermerk mit der Person, die in dem Vermerk als committ. genannt wird."@de ;
  skos:example "RG V 00061: Agnes de Bronchorst (Brouchorst) de illustri gen., can. sec. eccl. [s. Viti] Altinen. (de Elten) Traiect. dioc., in 22 an. sue et. constit., in abbam. d. eccl. el. de disp. sup. def. et. ( committ. mag. Petro de Mera prep. eccl. Embricen. [Traiect. dioc.]) 17. apr. 1443 S 391 146v."@la .


:hat_Pfruendenverlierer a owl:ObjectProperty ;
  rdfs:subPropertyOf :hat_Beteiligten ;
  rdfs:domain :Pfruendenentzug ;
  rdfs:range :Person ;
  :owl:inverseOf "nimmt teil an als Pfründenverlierer"@de ;
  rdfs:label "had benefice holder deprived"@en ,
  "hat Pfründenverlierer"@de ;
  skos:definition "Diese Property verbindet eine Instanz der Activity Pfründenentzug mit der Person, der die Pfründe entzogen worden ist."@de .


:hat_Beruf a owl:ObjectProperty ;
  rdfs:subPropertyOf owl:topObjectProperty ;
  rdfs:domain :Person ;
  rdfs:range :Beruf ;
  rdfs:label "has occupation"@en ,
  "hat Beruf"@de ;
  skos:definition "Diese Property ordnet einer Person einen Beruf zu."@de .


:autorisiert_die_Ausstellung_von a owl:ObjectProperty ;
  rdfs:subPropertyOf owl:topObjectProperty ;
  rdfs:domain :Gnadenerweis ;
  rdfs:range :Paepstliche_Littera ;
  rdfs:label "authorizes the issuance of"@en ,
  "autorisiert die Ausstellung von"@de ;
  skos:definition "Diese Property stellt die Beziehung zwischen einer Instanz eines Gnadenerweises und der Instanz einer päpstlichen Littera her, deren Ausstellung durch diesen Gnadenerweis autorisiert wird."@de .


:hat_Dioezesanzugehoerigkeit a owl:ObjectProperty ;
  rdfs:subPropertyOf owl:topObjectProperty ;
  rdfs:domain owl:Thing ;
  rdfs:range :Dioezese ;
  rdfs:label "hat Diözesanzugehörigkeit"@de ;
  skos:definition "Die Property weist einer Instanz der Ontologie eine Diözese zu."@de ;
  skos:editorialNote "Wenn ein Kleriker mit einer Diözese genannt wird, dann wird dies als Inkardination bezeichnet (cler./acol./subdiac./diac./presb. + Diözese)."@de .


:hat_Zeugen a owl:ObjectProperty ;
  rdfs:subPropertyOf :hat_Beteiligten ;
  rdfs:domain :Ereignis ;
  rdfs:range :Person ;
  :owl:inverseOf "nimmt teil an als Zeuge"@de ;
  rdfs:label "had witness"@en ,
  "hat Zeugen"@de ;
  skos:definition "Diese Property verbindet eine Instanz von Event mit einer Person, die als Zeuge agiert."@de ;
  skos:editorialNote "Zeugen können in Gerichtsprozessen auftreten, aber auch im Kontext von Zahlungen und Obligationen, siehe Beispiele. Manchmal ist der Kontext auch unbestimmt. Deshalb ist diese Property keine Subproperty von Prozessbeteiligter."@de ;
  skos:example "Adolphus filius ducis Cleven. testis 21. febr. 1440 DC 20 141r."@la ,
  "Jacobus Nedermolen cler. Colon. dioc. testis super quadam oblig. 28 iul. 1409 M 8."@la ,
  "Johannes de Bulgaro cler. Colon. dioc. testis super quadam solut. 8 oct. 1409 M 11v."@la .


:hat_Bullenverleser a owl:ObjectProperty ;
  rdfs:subPropertyOf :hat_Beteiligten ;
  rdfs:domain :Korrektur-_Lesung_einer_Bulle ;
  rdfs:range :Person ;
  rdfs:label "hat Bullenverleser"@de ;
  skos:definition "Eine Person, die eine Bulle verliest: l.b. (lectio bulle) - Person nie bekannt."@de .


:bezieht_sich_auf_kirchliche_Institution a owl:ObjectProperty ;
  rdfs:subPropertyOf :bezieht_sich_auf ;
  rdfs:domain :Pfruende ;
  rdfs:range :Kirchliche_Institution ;
  rdfs:label "bezieht sich auf kirchliche Institution"@de ;
  skos:definition "Diese Property weist einer Instanz von Pfründe die zu ihr gehörige kirchliche Institution zu."@de .


:hat_Schuldner a owl:ObjectProperty ;
  rdfs:subPropertyOf :hat_Beteiligten ;
  rdfs:domain :Aktivitaet ;
  rdfs:range :Person ;
  :owl:inverseOf "nimmt teil an als Schuldner"@de ;
  rdfs:label "had debtor"@en ,
  "hat Schuldner"@de ;
  skos:definition "Diese Property verbindet eine Instanz von Activity mit einer Person, die als Schuldner auftritt."@de ;
  skos:editorialNote "Hiermit ist explizit nicht der Petent gemeint, sondern eine Person, die z.B. im Rahmen einer Gerichtsverhandlung als Schuldner auftritt oder bezeichnet wird."@de .


:hat_Amt a owl:ObjectProperty ;
  rdfs:subPropertyOf owl:topObjectProperty ;
  rdfs:domain :Person ;
  rdfs:range :Amt ;
  rdfs:label "hat Amt"@de ,
  "holds office"@en ;
  skos:definition "Diese Property ordnet einer Person ein Amt zu und ist zu verwenden, wenn nicht eindeutig bestimmbar ist, ob es sich um ein kirchliches oder ein weltliches Amt handelt."@de .


:hat_Vorname a owl:ObjectProperty ;
  rdfs:subPropertyOf owl:topObjectProperty ;
  rdfs:domain :Person ;
  rdfs:range :Vorname ;
  rdfs:label "has given name"@en ,
  "hat Vorname"@de ;
  skos:definition "Diese Property stellt die Beziehung zwischen einer Instanz der Klasse Person und einer Instanz von Vorname her."@de ;
  skos:example "Johannes (RG VI 01496)"@la .


:hat_Personenzuschreibung a owl:ObjectProperty ;
  rdfs:subPropertyOf owl:topObjectProperty ;
  rdfs:domain :Person ;
  rdfs:range :Personenzuschreibung ;
  rdfs:label "has personal attribution"@en ,
  "hat Personenzuschreibung"@de ;
  skos:definition "Diese Property stellt die Beziehung zwischen einer Instanz der Klasse Person und einer Personenzuschreibung her, die nicht dem sozialen Stand oder einem Amt zuzuordnen ist."@de .


:hat_Familiennamensvariante a owl:ObjectProperty ;
  rdfs:subPropertyOf owl:topObjectProperty ;
  rdfs:domain :Person ;
  rdfs:range :Familienname ;
  rdfs:label "hat Familiennamensvariante"@de .


:hat_Vornamensvariante a owl:ObjectProperty ;
  rdfs:subPropertyOf owl:topObjectProperty ;
  rdfs:domain :Person ;
  rdfs:range :Vorname ;
  rdfs:label "hat Vornamensvariante"@de .


:hat_Resignierenden a owl:ObjectProperty ;
  rdfs:subPropertyOf :hat_Beteiligten ;
  rdfs:domain :Resignation ;
  rdfs:range :Person ;
  rdfs:label "hat Resignierenden"@de ;
  skos:definition "Eine Person, die ein Amt niederlegt."@de .


:hat_Quittierer a owl:ObjectProperty ;
  rdfs:subPropertyOf :hat_Beteiligten ;
  rdfs:domain :Quittung ;
  rdfs:range :Kurie ;
  rdfs:label "hat Quittierer"@de ;
  skos:definition "Die Kurie, die eine Geldzahlung quittiert."@de .


:hat_Obligationsbeauftragten a owl:ObjectProperty ;
  rdfs:subPropertyOf :hat_Beteiligten ;
  rdfs:domain :Aktivitaet ;
  rdfs:range :Person ;
  :owl:inverseOf "nimmt teil an als Obligationsbeauftragter"@de ;
  rdfs:label "had obligation proxy"@en ,
  "hat Obligationsbeauftragten"@de ;
  skos:definition "Diese Property verbindet eine Instanz von Activity mit der Person, die stellvertretend für eine andere Person die Zahlungsverpflichtung für den Empfang einer Pfründe an der Kurie abgibt, in den Quellen in der Regel eingeleitet durch oblig. p. m.."@de ;
  skos:example "RG 5/40: o.s.a (obligatio super annata) per Johannem Scade procuratorem causarum in Romana curia"@la ,
  "RG II 00012: Anselmus abb. mon. s. Petri Novellarien [o. s. Ben.] Argent. dioc. oblig. p. m. Johannis Kesseler dec. eccl. s. Jacobi Bamberg. et recogn. oblig. pro Johanne predec. 23 iul. 1388 O 48 106v."@la .


:hat_Patrozinium a owl:ObjectProperty ;
  rdfs:subPropertyOf owl:topObjectProperty ;
  rdfs:domain :Institution ;
  rdfs:range :Patrozinium ;
  rdfs:label "has patrocinium"@en ,
  "hat Patrozinium"@de ;
  skos:definition "Diese Property stellt die Beziehung zwischen einer Instanz einer Institution und einer Instanz eines Patroziniums her, dem die Institution geweiht ist."@de .


:hat_Zahlungsmodalitaet a owl:ObjectProperty ;
  rdfs:subPropertyOf owl:topObjectProperty ;
  rdfs:domain :Geldzahlung ;
  rdfs:range :Zahlungsmodalitaet ;
  rdfs:label "hat Zahlungsmodalität"@de ;
  skos:definition "Die Property ermöglicht eine Auskunft darüber, ob eine Geldzahlung als Voll- oder nur als Teilzahlung geleistet wurde."@de .


:hat_Namensstatus a owl:ObjectProperty ;
  rdfs:subPropertyOf owl:topObjectProperty ;
  rdfs:domain :Person ;
  rdfs:label "hat Namensstatus"@de ;
  rdfs:range :Namensstatus ;
  skos:definition "Die Property weist einer Person einen Namensstatus zu."@de ;
  skos:editorialNote "Namensstatus umfasst die möglichen Zustände des Namens einer Person. Der Name einer Person hat entweder den Status „bekannt“ oder „unbekannt“."@de .


:hat_Pfruendenstatus a owl:ObjectProperty ;
  rdfs:subPropertyOf owl:topObjectProperty ;
  rdfs:domain :Pfruende ;
  rdfs:range :Pfruendenstatus ;
  rdfs:label "has benefice state"@en ,
  "hat Pfründenstatus"@de ;
  skos:definition "Die Property weist einer Instanz von Pfründe einen Pfründenstatus zu, der sich auf das Einkommen und den Besetzungsstatus beziehen kann."@de ;
  skos:editorialNote "Sie ist insbesondere für Instanzen von E39 Akteur und Pfründe relevant."@de .


:hat_Entsandten a owl:ObjectProperty ;
  rdfs:subPropertyOf :hat_Beteiligten ;
  rdfs:domain :Entsendung ;
  rdfs:range :Person ;
  :owl:inverseOf "nimmt teil an als Entsandter"@de ;
  rdfs:label "had envoy"@en ,
  "hat Entsandten"@de ;
  skos:definition "Diese Property verbindet eine Instanz der Activity Entsendung mit der Person, die entsandt wurde."@de .


:hat_Quellenbeleg a owl:ObjectProperty ;
  rdfs:subPropertyOf owl:topObjectProperty ;
  rdfs:domain :RG-Strukturelement ;
  rdfs:range :Quellenbeleg ;
  rdfs:label "hat Quellenbeleg"@de ;
  skos:definition "Die Property verknüpft eine Instanz von RG-Strukurelement (Kopf, Regest) mit einer Instanz der Klasse Quellenbeleg."@de ;
  skos:editorialNote "Jedes RG-Strukturelement muss einen Quellenbeleg zugeordnet bekommen."@de .


:Pfruende_wird_besetzt_durch a owl:ObjectProperty ;
  rdfs:subPropertyOf owl:topObjectProperty ;
  rdfs:domain :Pfruende ;
  rdfs:range :Akteur ;
  rdfs:label "Pfründe wird besetzt durch"@de ,
  "benefice is conferred by"@en ;
  skos:definition "Diese Property ordnet einer Pfründe den Akteur zu, der sie in der Funktion als Kollator besetzt."@de ;
  skos:editorialNote "Bei mehr als einer Pfründe und mehr als einem Kollator (z.B. verbunden durch et oder necnon) bezieht sich die erste Kollaturangabe auf die erste Pfründe und die zweite Kollaturangabe auf die zweite Pfründe usw., vgl. \"prov. de 2 benef. ad coll. ep. etc. Ratisbon. necnon prep. etc. mon. s. Nicolai e. m. Patav. o. s. Aug.\"."@de .


:hat_Fundstelle a owl:ObjectProperty ;
  rdfs:subPropertyOf owl:topObjectProperty ;
  rdfs:domain :Quellenbeleg ;
  rdfs:range :Fundstelle ;
  rdfs:label "has source"@en ,
  "hat Fundstelle"@de ;
  skos:definition "Angabe der Archivalien und Handschriften, aus denen das Regest im RG erstellt worden ist (Datum und Registerserie)."@de .


:hat_kirchlichen_Stand a owl:ObjectProperty ;
  rdfs:subPropertyOf owl:topObjectProperty ;
  rdfs:domain :Person ;
  rdfs:range :Kirchlicher_Stand ;
  rdfs:label "has ecclesiastical state"@en ,
  "hat kirchlichen Stand"@de ;
  skos:definition "Diese Property ordnet einer Person einen kirchlichen Stand zu und dient der Einordnung des kirchenrechtlichen Status, wobei als Ausprägungen Laie oder Kleriker verwendet werden."@de .


:hat_Kind a owl:ObjectProperty ;
  rdfs:subPropertyOf :hat_Familienbeziehung_zu ;
  rdfs:domain :Person ;
  rdfs:range :Person ;
  :owl:inverseOf "hat Mutter"@de ,
  "hat Vater"@de ;
  rdfs:label "hat Kind"@de ;
  skos:definition "Diese Property stellt die Beziehung zwischen zwei Instanzen der Klasse Person her, wobei die eine Person als Kind der anderen Person bezeichnet wird."@de .


:hat_Geschlecht a owl:ObjectProperty ;
  rdfs:subPropertyOf owl:topObjectProperty ;
  rdfs:domain :Person ;
  rdfs:range :Geschlecht ;
  rdfs:label "hat Geschlecht"@de ;
  skos:definition "Die Property weist einer Person ein Geschlecht zu."@de ;
  skos:editorialNote "Geschlecht bezeichnet im Kontext des Repertorium Germanicum eine personenbezogene Zuschreibung, die – sofern nicht ausdrücklich genannt – aus dem Vornamen und aus grammatischen Merkmalen der Quelle (z. B. Pronomen) erschlossen wird."@de .


:hat_Familienbeziehung_zu a owl:ObjectProperty ;
  rdfs:subPropertyOf owl:topObjectProperty ;
  rdfs:domain :Person ;
  rdfs:range :Person ;
  rdfs:label "has family relationship with"@en ,
  "hat Familienbeziehung zu"@de ;
  skos:definition "Diese Property stellt die Beziehung zwischen zwei Instanzen der Klasse Person her und gibt an, dass zwischen ihnen eine familiäre Beziehung besteht."@de .


:hat_kuriale_Ueberlieferungseinheit a owl:ObjectProperty ;
  rdfs:subPropertyOf owl:topObjectProperty ;
  rdfs:domain :Fundstelle ;
  rdfs:range :Kuriale_Ueberlieferungseinheit ;
  rdfs:label "hat kuriale Überlieferungseinheit"@de ;
  skos:definition "Diese Property verknüpft eine Instanz der Klasse Fundstelle mit einer Instanz einer Unterklasse von Kuriale Überlieferungseinheit."@de .


:hat_Weihempfaenger a owl:ObjectProperty ;
  rdfs:subPropertyOf :hat_Beteiligten ;
  rdfs:domain :Aktivitaet ;
  rdfs:range :Person ;
  :owl:inverseOf "nimmt teil an als Weihempfänger"@de ;
  rdfs:label "had ordination recipient"@en ,
  "hat Weihempfänger"@de ;
  skos:definition "Diese Property verbindet eine Instanz von Activity mit einer Person, die eine Weihe empfangen hat."@de .


:hat_Vater a owl:ObjectProperty ;
  rdfs:subPropertyOf :hat_Familienbeziehung_zu ;
  rdfs:domain :Person ;
  rdfs:range :Person ;
  :owl:inverseOf "hat Kind"@de ;
  rdfs:label "has father"@en ,
  "hat Vater"@de ;
  skos:definition "Diese Property stellt die Beziehung zwischen zwei Instanzen der Klasse Person her, wobei die eine Person als Vater der anderen Person bezeichnet wird."@de .


:hat_Resignationsempfaenger a owl:ObjectProperty ;
  rdfs:subPropertyOf :hat_Beteiligten ;
  rdfs:domain :Aktivitaet ;
  rdfs:range :Person ;
  :owl:inverseOf "nimmt teil an als Resignationsempfänger"@de ;
  rdfs:label "had resignation recipient"@en ,
  "hat Resignationsempfänger"@de ;
  skos:definition "Diese Property verbindet eine Instanz von Activity mit einer Person, in deren Hände ein Amt resigniert wurde."@de .


:hat_Zielort a owl:ObjectProperty ;
  rdfs:subPropertyOf owl:topObjectProperty ;
  rdfs:domain :Entsendung ;
  rdfs:range :Ort ;
  rdfs:label "has destination"@en ,
  "hat Zielort"@de ;
  skos:definition "Diese Property ordnet einer Instanz von Entsendung einen Zielort zu und bezeichnet so den Ort, an den die entsandte Person gelangt oder gelangen soll."@de .


:hat_Ablassart a owl:ObjectProperty ;
  rdfs:subPropertyOf owl:topObjectProperty ;
  rdfs:domain :Ablass ;
  rdfs:range :Ablassart ;
  rdfs:label "hat Ablassart"@de ;
  skos:definition "Qualifiziert einen Ablass als vollständigen (=Plenar-) Ablass oder als eingeschränkten Teilablass."@de .


:hat_sozialen_Stand a owl:ObjectProperty ;
  rdfs:subPropertyOf owl:topObjectProperty ;
  rdfs:domain :Person ;
  rdfs:range :Sozialer_Stand ;
  rdfs:label "has social status"@en ,
  "hat sozialen Stand"@de ;
  skos:definition "Diese Property stellt die Beziehung zwischen einer Instanz der Klasse Person und einer Instanz des sozialen Standes her und weist der Person einen sozialen Stand zu."@de .


:hat_Ablassempfaenger a owl:ObjectProperty ;
  rdfs:subPropertyOf :hat_Beteiligten ;
  rdfs:domain :Ablass ;
  rdfs:range :Institution ;
  :owl:inverseOf "nimmt teil als Ablassempfänger"@de ;
  rdfs:label "had indulgence recipient"@en ,
  "hat Ablassempfänger"@de ;
  skos:definition "Diese Property verbindet eine Instanz der Activity Gnadenerweis vom Typ Ablass mit der Institution, der der Ablass gewährt wurde."@de .


:hat_Mutter a owl:ObjectProperty ;
  rdfs:subPropertyOf :hat_Familienbeziehung_zu ;
  rdfs:domain :Person ;
  rdfs:range :Person ;
  :owl:inverseOf "hat Kind"@de ;
  rdfs:label "has mother"@en ,
  "hat Mutter"@de ;
  skos:definition "Diese Property stellt die Beziehung zwischen zwei Instanzen der Klasse Person her, wobei die eine Person als Mutter der anderen Person bezeichnet wird."@de .


:hat_Waehrung a owl:ObjectProperty ;
  rdfs:subPropertyOf owl:topObjectProperty ;
  rdfs:domain :Geldsumme ;
  rdfs:range :Waehrung ;
  rdfs:label "hat Währung"@de ;
  skos:definition "Diese Property stellt die Beziehung zwischen einer Instanz der Klasse E97 Geldbetrag und der Instanz der Klasse E98 Währung her, in der dieser Betrag gemessen ist.\" This property establishes the relationship between an instance of E97 Monetary Amount and the instance of E98 Currency that it is measured in.\" (CIDOC)"@en ;
  skos:editorialNote "http://www.cidoc-crm.org/cidoc-crm/P180_has_currency"@en .


:hat_Weihspender a owl:ObjectProperty ;
  rdfs:subPropertyOf :hat_Beteiligten ;
  rdfs:domain :Weiheempfang ;
  rdfs:range :Person ;
  rdfs:label "hat Weihspender"@de ;
  skos:definition "Eine Person, die jemandem eine Weihe spendet."@de .


:bezieht_sich_auf a owl:ObjectProperty ;
  rdfs:subPropertyOf owl:topObjectProperty ;
  rdfs:domain owl:Thing ;
  rdfs:range owl:Thing ;
  rdfs:label "bezieht sich auf"@de ,
  "refers to"@en ;
  skos:definition "Diese Property stellt eine inhaltliche Bezugnahme zwischen zwei Instanzen beliebiger Klassen her und ermöglicht es, Sachverhalte, Vorgänge oder Entscheidungen miteinander zu verknüpfen, etwa wenn ein Ereignis auf ein anderes Bezug nimmt."@de ;
  skos:editorialNote "Im Unterschied zu P67 refers to (is referred to) in CIDOC CRM, das keine Beziehungen zwischen Ereignissen vorsieht, ist diese Property bewusst domänen- und bereichsoffen angelegt, um solche Verknüpfungen für das vorliegende Material zu ermöglichen."@de .


:ist_Teil_von_Ueberlieferungseinheit a owl:ObjectProperty ;
  rdfs:subPropertyOf owl:topObjectProperty ;
  rdfs:domain :Kuriale_Ueberlieferungseinheit ;
  rdfs:range :Kuriale_Ueberlieferungseinheit ;
  rdfs:label "ist Teil von Überlieferungseinheit"@de ;
  skos:definition "Eine Property, um die Beziehung zwischen Instanzen von \"Kuriale Überlieferungseinheit\" zu definieren."@de .


:bezieht_sich_auf_Amt a owl:ObjectProperty ;
  rdfs:subPropertyOf :bezieht_sich_auf ;
  rdfs:domain :Pfruende ;
  rdfs:range :Amt ;
  rdfs:label "bezieht sich auf Amt"@de ;
  skos:definition "Diese Property weist einer Instanz von Pfründe ein Amt zu."@de .


:hat_Rechtsbeistand a owl:ObjectProperty ;
  rdfs:subPropertyOf :hat_Prozessbeteiligten ;
  rdfs:domain :Gerichtsprozess ;
  rdfs:range :Person ;
  :owl:inverseOf "nimmt teil an als Rechtsbeistand"@de ;
  rdfs:label "had legal counsel"@en ,
  "hat Rechtsbeistand"@de ;
  skos:definition "Diese Property verbindet eine Instanz der Activity Gerichtsprozess mit einer Person, die einen Kläger oder Beklagten in einem Gerichtsprozess unterstützt."@de .


:hat_Kommissionsvermerk a owl:ObjectProperty ;
  rdfs:subPropertyOf owl:topObjectProperty ;
  rdfs:domain :Aktivitaet ;
  rdfs:range :Kommissionsvermerk ;
  rdfs:label "has commission note"@en ,
  "hat Kommissionsvermerk"@de ;
  skos:definition "Die Property verbindet eine Instanz von Activity (E7) mit einem Kommissionsvermerk."@de .


:hat_Funktion a owl:ObjectProperty ;
  rdfs:subPropertyOf owl:topObjectProperty ;
  rdfs:domain :Person ;
  rdfs:range :Funktion ;
  rdfs:label "has role"@en ,
  "hat Funktion"@de ;
  skos:definition "Diese Property stellt die Beziehung zwischen einer Instanz der Klasse Person und einer Instanz der Klasse Funktion her."@de .


:war_der_Tod_von a owl:ObjectProperty ;
  rdfs:domain :Tod ;
  rdfs:range :Person ;
  rdfs:label "war der Tod von"@de ;
  skos:definition "Diese Property verknüpft eine Instanz der Klasse E69 Tod mit der Instanz der Klasse E21 Person, die gestorben ist; eine Instanz von E69 Tod kann dabei mehrere Personen betreffen, etwa im Fall einer Schlacht oder eines Unglücks.\" This property links an instance of E69 Death to the instance of E21 Person that died. An instance of E69 Death may involve multiple people, for example in the case of a battle or disaster.\" (CIDOC)"@en ;
  skos:editorialNote <http://www.cidoc-crm.org/cidoc-crm/P100_was_death_of> .


:hat_Prozessbeteiligten a owl:ObjectProperty ;
  rdfs:subPropertyOf :hat_Beteiligten ;
  rdfs:domain :Gerichtsprozess ;
  rdfs:range :Person ;
  :owl:inverseOf "nimmt teil an als Prozessbeteiligter"@de ;
  rdfs:label "had litigant"@en ,
  "hat Prozessbeteiligten"@de ;
  skos:definition "Diese Property verbindet eine Instanz der Activity Gerichtsprozess mit einer Person, die an einem Gerichtsprozess beteiligt ist."@de .


:hat_Pfruendenentzieher a owl:ObjectProperty ;
  rdfs:subPropertyOf :hat_Beteiligten ;
  rdfs:domain :Pfruendenentzug ;
  rdfs:range :Person ;
  rdfs:label "hat Pfründenentzieher"@de ;
  skos:definition "Eine Person, die jemandem die Pfründe entzieht oder entzogen hat."@de .


:ist_nachgeordnetes_Ereignis_in a owl:ObjectProperty ;
  rdfs:subPropertyOf owl:topObjectProperty ;
  rdfs:domain :Ereignis ;
  rdfs:range :RG-Strukturelement ;
  rdfs:label "is subordinate event in"@en ,
  "ist nachgeordnetes Ereignis in"@de ;
  skos:definition """„ist nachgeordnetes Ereignis in“ verbindet ein Ereignis mit dem RG-Strukturelement (Kopf oder Regest), in dem es vorkommt. 

Nachgeordnete Ereignisse sind solche, die zwar in den kurialen Überlieferungseinheiten und folglich in den RG-Strukturelementen vorkommen, aber nicht Anlass der Registrierung waren."""@de ;
  skos:editorialNote "Das zu einem nachgeordneten Ereignis gehörende Fundstellendatum kann in der Regel nur als terminus ante quem zur Datierung des Ereignisses herangezogen werden."@de ,
  "Nachgeordnete Ereignisse können im Kopf der Petentenvita und in den Regesten (Untereinträgen) vorkommen."@de .


:hat_Pfruendenwert a owl:ObjectProperty ;
  rdfs:subPropertyOf owl:topObjectProperty ;
  rdfs:domain :Pfruende ;
  rdfs:range :Pfruendenschaetzwert ;
  rdfs:label "has benefice value"@en ,
  "hat Pfründenwert"@de ;
  skos:definition "Diese Property ordnet einer Pfründe einen Pfründenschätzwert zu, der die geschätzte Höhe des jährlichen Einkommens der jeweiligen Pfründe angibt."@de .


:hat_Gnadengewaehrer a owl:ObjectProperty ;
  rdfs:subPropertyOf :hat_Beteiligten ;
  rdfs:domain :Gnadenerweis ;
  rdfs:range :Person ;
  rdfs:label "hat Gnadengewährer"@de ;
  skos:definition "Rolle des Papstes in der Aktivität Gnadenerweis"@de .


:bezieht_sich_auf_Pfruende a owl:ObjectProperty ;
  rdfs:subPropertyOf :bezieht_sich_auf ;
  rdfs:domain :Ereignis ;
  rdfs:range :Pfruende ;
  rdfs:label "bezieht sich auf Pfründe"@de ;
  skos:definition "Diese Property verbindet ein Ereingnis (Pfründenvergabe, Gerichtsprozess, Annatenzahlung etc.) mit einer Instanz von Pfründe."@de .


:hat_Pfruendenpflicht a owl:ObjectProperty ;
  rdfs:subPropertyOf owl:topObjectProperty ;
  rdfs:domain :Pfruende ;
  rdfs:range :Pfruendenpflicht ;
  rdfs:label "has benefice duty"@en ,
  "hat Pfründenpflicht"@de ;
  skos:definition "Diese Property ordnet einer Pfründe eine Pfründenpflicht zu und dient der Beschreibung der mit der Pfründe verbundenen Verpflichtungen, insbesondere der Residenzpflicht oder der Seelsorge."@de .


:hat_Zahlungsbeauftragten a owl:ObjectProperty ;
  rdfs:subPropertyOf :hat_Beteiligten ;
  rdfs:domain :Geldzahlung ;
  rdfs:range :Person ;
  :stringInRG "solv. p."@la ,
  "solv. p. m."@la ;
  :owl:inverseOf "nimmt teil an als Zahlungsbeauftragter"@de ;
  rdfs:label "had payment proxy"@en ,
  "hat Zahlungsbeauftragten"@de ;
  skos:definition "Diese Property verbindet eine Instanz der Activity Geldzahlung mit einer Person, die für eine andere Person die Ausführung der Geldzahlung übernommen hat."@de ;
  skos:editorialNote "Ein Zahlungsbeauftragter ist eine Person, die vom Zahler (meist der Petent) mit der Begleichung von Geldschulden an der Kurie beauftragt wurde. Im RG eingeleitet durch \"solv. p. m. + Personenname\" o. Ä."@de ;
  skos:example "RG III 00213: […] solv. p. m. Georgii Vredelant 20 fl. […]"@la .


:hat_Vakanzgrund a owl:ObjectProperty ;
  rdfs:subPropertyOf owl:topObjectProperty ;
  rdfs:domain :Pfruende ;
  rdfs:range :Vakanzgrund ;
  rdfs:label "has vacancy reason"@en ,
  "hat Vakanzgrund"@de ;
  skos:definition "Diese Property stellt die Beziehung zwischen einer vakanten Pfründe und einer Instanz eines Vakanzgrundes her, der den Grund für die Vakanz angibt."@de .


:hat_Beteiligten a owl:ObjectProperty ;
  rdfs:subPropertyOf owl:topObjectProperty ;
  rdfs:domain :Ereignis ;
  rdfs:range :Akteur ;
  rdfs:label "had participant"@en ,
  "hat Beteiligten"@de ;
  skos:definition "Diese Property ermöglicht die Untertypisierung von CIDOC-CRM-Entitäten – als Form der Spezialisierung – durch die Verwendung einer terminologischen Hierarchie oder eines Thesaurus. \"This property describes the active or passive participation of instances of E39 Actors in an instance of E5 Event. […]\" (CIDOC)"@en ;
  skos:editorialNote "http://www.cidoc-crm.org/cidoc-crm/P11_had_participant"@en .


:hat_Ort a owl:ObjectProperty ;
  rdfs:subPropertyOf owl:topObjectProperty ;
  rdfs:domain :Akteur ;
  rdfs:range :Ort ;
  rdfs:label "hat Ort"@de ;
  skos:definition "Die Property weist einer Person oder einer Institution einen Ort zu, ohne dabei zu spezifizieren, was damit konkret gemeint ist."@de .


:hat_Familienstand a owl:ObjectProperty ;
  rdfs:subPropertyOf owl:topObjectProperty ;
  rdfs:domain :Person ;
  rdfs:range :Familienstand ;
  rdfs:label "hat Familienstand"@de ,
  "marital status"@en ;
  skos:definition "Diese Property stellt eine Beziehung zwischen einer Instanz der Klasse Person und einer Instanz der Klasse Familienstand her und gibt an, ob die Person ledig, verheiratet oder der Familienstand unbekannt ist."@de .


:hat_Petenten a owl:ObjectProperty ;
  rdfs:subPropertyOf :hat_Beteiligten ;
  rdfs:domain :Gnadenerweis ;
  rdfs:range :Person ;
  :owl:inverseOf "nimmt teil an als Petent"@de ;
  rdfs:label "had petitioner"@en ,
  "hat Petenten"@de ;
  skos:definition "Bezeichnet in der Regel die Person, die als Bittsteller an die Päpstliche Kurie herantritt. Nicht immer identisch mit dem Autor/Verfasser der Bittschrift. Das Repertorium Germanicum behandelt auch Ortsartikel als Petentenviten."@de .


:hat_Expeditionsmodalitaet a owl:ObjectProperty ;
  rdfs:subPropertyOf owl:topObjectProperty ;
  rdfs:domain :Gnadenerweis ;
  rdfs:range :Expeditionsmodalitaet ;
  rdfs:label "has expedition modality"@en ,
  "hat Expeditionsmodalität"@de ;
  skos:definition "Diese Property stellt die Beziehung zwischen einer Instanz eines Gnadenerweises und der Instanz einer Expeditionsmodalität her, nach der die Ausstellung der zugehörigen Urkunde erfolgt."@de ;
  skos:editorialNote "Es ist sinnvoll die Expeditionsmodalität an das Event Gnadenerweis zu modellieren, da sie, wie die Gnade selbst, erbeten und gewährt werden musste. Eine Modellierung an die physische Manifestation des Gnadenerweises, der päpstlichen Littera, verbietet sich daher."@de .


:ist_zentrales_Ereignis_in a owl:ObjectProperty ;
  rdfs:subPropertyOf owl:topObjectProperty ;
  rdfs:domain :Ereignis ;
  rdfs:range :Regest ;
  rdfs:label "is central event in"@en ,
  "ist zentrales Ereignis in"@de ;
  skos:definition """„ist zentrales Ereignis in“ verbindet ein Ereignis mit dem RG-Strukturelement (nur in einem Regest, nie Kopf), in dem es vorkommt.

Zentrale Ereignisse, eins oder mehrere pro Regest, sind der Grund für die ursprüngliche Aufnahme des Ereignisses in die kuriale Überlieferungseinheit."""@de .


:hat_Pfruendenanwaerter a owl:ObjectProperty ;
  rdfs:subPropertyOf :hat_Beteiligten ;
  rdfs:domain :Aktivitaet ;
  rdfs:range :Person ;
  :owl:inverseOf "nimmt teil an als Pfründenanwärter"@de ;
  rdfs:label "had benefice candidate"@en ,
  "hat Pfründenanwärter"@de ;
  skos:definition "Diese Property verbindet eine Instanz von Activity mit einer Person, die als Pfründenanwärter auftritt."@de ;
  skos:editorialNote "Ein Pfründenanwärter ist eine Person, die Anspruch auf eine Pfründe erhebt oder sich um eine solche bewirbt. Hiermit ist explizit nicht der Petent gemeint, sondern eine Person, die z.B. im Rahmen einer Gerichtsverhandlung als Pfründenanwärter auftritt oder bezeichnet wird."@de ;
  skos:example """Stephanus Bittinger ist in diesem Kontext ein Pfründenanwärter;  Johannes Wassemberg der Petent:

RG VIII 03783: Johannes Wassemberg (Wassenberg(h), Wasserberg) cler. Argent. qui vig. gr. expect. perp. vicar. par. eccl. in Tungsenheim Argent. dioc. (cuius fruct. satis modici val. ) vac. p. o. Henrici Grummel de Hagennowe acc. quarum coll. ad Georgium Zorn prep. eccl. s. Petri iunior. Argent. spectat quem Stephanus Bittinger cler. pretextu gr. expect. ad parendum proc. requisivit: de n. prom. ad 2 an. 6. apr. 1462 S 549 290rs."""@la .


:hat_Ordenszugehoerigkeit a owl:ObjectProperty ;
  rdfs:subPropertyOf owl:topObjectProperty ;
  rdfs:domain :Akteur ;
  rdfs:range :Orden ;
  rdfs:label "has religious order affiliation"@en ,
  "hat Ordenszugehörigkeit"@de ;
  skos:definition "Diese Property weist einer Instanz von Akteur eine Ordenszugehörigkeit zu."@de .


:hat_akademischen_Grad a owl:ObjectProperty ;
  rdfs:domain :Person ;
  rdfs:range :Akademischer_Grad ;
  rdfs:label "has academic degree"@en ,
  "hat akademischen Grad"@de ;
  skos:definition "Diese Property stellt die Beziehung zwischen einer Instanz der Klasse Person und einer Instanz der Klasse Akademischer Grad her und gibt an, welchen akademischen Grad die Person erworben hat."@de .


:hat_Familienname a owl:ObjectProperty ;
  rdfs:subPropertyOf owl:topObjectProperty ;
  rdfs:domain :Person ;
  rdfs:range :Familienname ;
  rdfs:label "has family name"@en ,
  "hat Familienname"@de ;
  skos:definition "Diese Property stellt die Beziehung zwischen einer Instanz der Klasse Person und einer Instanz von Familienname her."@la ;
  skos:example "Bodecker (RG VI 01496)"@la .


:hat_Pfruende a owl:ObjectProperty ;
  rdfs:subPropertyOf owl:topObjectProperty ;
  rdfs:domain :Person ;
  rdfs:range :Pfruende ;
  rdfs:label "has benefice"@en ,
  "hat Pfründe"@de ;
  skos:definition "Diese Property ordnet einer Person eine Pfründe zu und ist für alle Inhaber kirchlicher Ämter (spezifiziert) beziehungsweise eines beneficium / benef. (unspezifiziert) zu verwenden."@de .


:hat_Geldsumme a owl:ObjectProperty ;
  rdfs:subPropertyOf owl:topObjectProperty ;
  rdfs:domain :Geldzahlung ;
  rdfs:range :Geldsumme ;
  rdfs:label "has sum of money"@en ,
  "hat Geldsumme"@de ;
  skos:definition "Diese Property ermöglicht es, eine Instanz der Klasse Geldzahlung mit einer bestimmten Geldsumme (z.B. 30 fl.), die gezahlt wurde, zu verknüpfen."@en .


:hat_Streitgegenstand a owl:ObjectProperty ;
  rdfs:subPropertyOf :hat_Gegenstand ;
  rdfs:domain :Gerichtsprozess ;
  rdfs:range owl:Thing ;
  rdfs:label "has subject of litigation"@en ,
  "hat Streitgegenstand"@de ;
  skos:definition "Diese Property ordnet einem Gerichtsprozess eine Sache zu, um die sich mindestens zwei Parteien in diesem Gerichtsprozess streiten."@de ;
  skos:example "Gerichtsprozess hat eine Pfründe zum Streitgegenstand."@de .


:hat_Rechtsstatus a owl:ObjectProperty ;
  rdfs:subPropertyOf owl:topObjectProperty ;
  rdfs:domain owl:Thing ;
  rdfs:range :Rechtsstatus ;
  rdfs:label "hat Rechtsstatus"@de ;
  skos:definition "Die Property weist einer Instanz von Akteur einen Rechtsstatus (z.B. exempt) zu."@de .


:hat_Prozessausgang a owl:ObjectProperty ;
  rdfs:subPropertyOf owl:topObjectProperty ;
  rdfs:domain :Gerichtsprozess ;
  rdfs:range :Prozessausgang ;
  rdfs:label "has case outcome"@en ,
  "hat Prozessausgang"@de ;
  skos:definition "Diese Property ordnet einem Gerichtsprozess einen Prozessausgang zu und dient der Beschreibung des Ergebnisses oder Abschlusses des Gerichtsverfahrens."@de .


#################################################################
#    Data properties
#################################################################

:hat_GSN-ID a owl:DatatypeProperty ;
  rdfs:subPropertyOf owl:topDataProperty ;
  rdfs:domain owl:Thing ;
  rdfs:range xsd:string ;
  rdfs:label "hat GSN-ID"@de ;
  skos:definition "Diese Data Property ordnet einer Instanz der Ontologie eine GSN-ID als Zeichenkette zu."@de .


:hat_Datum a owl:DatatypeProperty ;
  rdfs:subPropertyOf owl:topDataProperty ;
  rdfs:domain owl:Thing ;
  rdfs:range xsd:date ;
  rdfs:label "has date"@en ,
  "hat Datum"@de ;
  skos:definition "Diese Data Property ordnet einer Klasseninstanz ein Datum zu und dient der Angabe eines zeitlichen Bezugspunkts."@de ;
  skos:editorialNote """1. Zur Anbindung eines Fundstellendatums an den dazugehörigen Quellenbeleg. Das Fundstellendatum bezieht sich primär auf das zentrale Ereignis, während es für nachgeordnete Ereignisse nur als terminus ante quem zur Datierung herangezogen werden kann.
2. Zur Anbindung von In-Text-Daten direkt an den dazugehörigen Textteil, z.B. ein Event von Typ \"nachgeordnetes Event\"."""@de .


:hat_Dauer a owl:DatatypeProperty ;
  rdfs:subPropertyOf owl:topDataProperty ;
  rdfs:domain :Aktivitaet ;
  rdfs:range xsd:duration ;
  rdfs:label "has duration"@en ,
  "hat Dauer"@de ;
  skos:definition "Diese Data Property ordnet einer Instanz von Activity eine quantifizierte Dauerangabe zu und dient der Angabe der zeitlichen Länge der Aktivität"@de ;
  skos:example "7 an.: RG 3/12: cum disp. retin. dign. cum decan. ad 7 an."@la .


:hat_Folioangabe a owl:DatatypeProperty ;
  rdfs:subPropertyOf owl:topDataProperty ;
  rdfs:domain :Fundstelle ;
  rdfs:range xsd:string ;
  rdfs:label "has folio number"@en ,
  "hat Folioangabe"@de ;
  skos:editorialNote "Diese Data Property ordnet einer Instanz von Fundstelle eine Folio-Nummer als Zeichenkette zu"@de ;
  skos:example "1r"^^xsd:string .


:hat_RG-ID a owl:DatatypeProperty ;
  rdfs:subPropertyOf owl:topDataProperty ;
  rdfs:domain :RG-Strukturelement ;
  rdfs:range xsd:string ;
  rdfs:label "has RG-ID"@en ,
  "hat RG-ID"@de ;
  skos:definition "Diese Data Property ordnet einer Instanz von RG-Strukturelement (Kopf, Regest) eine RG-ID als Zeichenkette zu, wenn in ihm ein Ereignis vorkommt."@de .


:hat_bewilligte_Dauer a owl:DatatypeProperty ;
  rdfs:subPropertyOf :hat_Dauer ;
  rdfs:domain :Aktivitaet ;
  rdfs:range xsd:duration ;
  rdfs:label "has granted duration"@en ,
  "hat bewilligte Dauer"@de ;
  skos:definition "Diese Data Property ordnet einer Instanz von Activity eine bewilligte Dauer zu und dient der Angabe des zeitlichen Umfangs einer gewährten Bewilligung (z.B. Ablass)."@de ;
  skos:example "Conc. de 3 an.: RG IX 00159: […] de indulg. 7 an. pro d. eccl. sive capel., Conc. de 3 an."@la .


:hat_Geonames-ID a owl:DatatypeProperty ;
  rdfs:subPropertyOf owl:topDataProperty ;
  rdfs:domain owl:Thing ;
  rdfs:range xsd:string ;
  rdfs:label "hat Geonames-ID"@de ;
  skos:definition "Diese Data Property ordnet einer Instanz der Ontologie eine Geonames-ID als Zeichenkette zu."@de .


:hat_ORCID-ID a owl:DatatypeProperty ;
  rdfs:subPropertyOf owl:topDataProperty ;
  rdfs:domain owl:Thing ;
  rdfs:range xsd:string ;
  rdfs:label "hat ORCID-ID"@de ;
  skos:definition "Diese Data Property ordnet einer Instanz der Ontologie eine ORCID-ID als Zeichenkette zu."@de .


:hat_RG_Stellenverweis a owl:DatatypeProperty ;
  rdfs:subPropertyOf owl:topDataProperty ;
  rdfs:domain :RG-Strukturelement ;
  rdfs:range xsd:string ;
  rdfs:label "has bibliographic reference"@en ,
  "hat RG Stellenverweis"@de ;
  skos:definition "\"hat RG Stellenverweis\" stellt eine Beziehung zwischen einer Instanz von RG-Struktureinheit (Kopf, Regest) und einem String her, der ihre Position im Repertorium Germanicum (Band- und Seitenangabe) angibt."@de ;
  skos:editorialNote "Da die Seitenzahlen bisher noch nicht zur Verfügung stehen, muss erstmal \"unbekannt\" als Range für jedes RG-Strukturelement angegeben werden."@de .


:hat_GND-ID a owl:DatatypeProperty ;
  rdfs:subPropertyOf owl:topDataProperty ;
  rdfs:domain owl:Thing ;
  rdfs:range xsd:string ;
  rdfs:label "hat GND-ID"@de ;
  skos:definition "Diese Data Property ordnet einer Instanz der Ontologie eine GND-ID als Zeichenkette zu."@de .


# <http://webprotege.stanford.edu/RCAm4im7iXkWTizp6RFONqh> a owl:DatatypeProperty ;
#   rdfs:subPropertyOf owl:topDataProperty ;
#   rdfs:domain :Person ;
#   rdfs:label "hat Namensstatus"@de .


:hat_Betrag a owl:DatatypeProperty ;
  rdfs:subPropertyOf owl:topDataProperty ;
  rdfs:domain :Geldsumme ;
  rdfs:range xsd:integer ;
  rdfs:label "has amount"@en ,
  "hat Betrag"@de ;
  skos:definition "Diese Data Property ordnet einem monetären Betrag einen Zahlenwert zu und dient der Angabe der Höhe des Geldbetrags. \"Diese Property ermöglicht es, eine Instanz von E54 Dimension durch eine Instanz des primitiven Typs E60 Number zu approximieren.\" \"This property allows an instance of E54 Dimension to be approximated by an instance of E60 Number primitive.\" (CIDOC)"@de ;
  skos:editorialNote <http://www.cidoc-crm.org/cidoc-crm/P90_has_value> .


:hat_Bandnummer a owl:DatatypeProperty ;
  rdfs:subPropertyOf owl:topDataProperty ;
  rdfs:domain owl:Thing ;
  rdfs:range xsd:string ;
  rdfs:label "has volume number"@en ,
  "hat Bandnummer"@de ;
  skos:definition "Datenwert, der die ordinale Kennzeichnung eines Bandes innerhalb einer zusammengehörigen Folge von Bänden angibt, einschließlich Bänden von Publikationen, Editionen und Registerquellen."@de .


:hat_WIAG-ID a owl:DatatypeProperty ;
  rdfs:subPropertyOf owl:topDataProperty ;
  rdfs:domain owl:Thing ;
  rdfs:range xsd:string ;
  rdfs:label "hat WIAG-ID"@de ;
  skos:definition "Diese Data Property ordnet einer Instanz der Ontologie eine WIAG-ID als Zeichenkette zu."@de .


:hat_Namen a owl:DatatypeProperty ;
  rdfs:subPropertyOf owl:topDataProperty ;
  rdfs:domain owl:Thing ;
  rdfs:range xsd:string ;
  rdfs:label "has name"@en ,
  "hat Namen"@de ;
  skos:definition "Diese Property stellt die Beziehung zwischen einer Instanz der Klasse Person und einer Zeichenkette her, die den Vollnamen der Person oder eines Ortes repräsentiert."@de ;
  skos:example "Johannes Bodecker de Castronovo (RG VI 01496)"@la .


:hat_beantragte_Dauer a owl:DatatypeProperty ;
  rdfs:subPropertyOf :hat_Dauer ;
  rdfs:domain :Aktivitaet ;
  rdfs:range xsd:duration ;
  rdfs:label "has requested duration"@en ,
  "hat beantragte Dauer"@de ;
  skos:definition "Diese Data Property ordnet einer Instanz von Activity eine beantragte Dauer zu und dient der Angabe des zeitlichen Umfangs einer beantragten Bewilligung (z.B. Ablass)."@de ;
  skos:example "7 an.: RG IX 00159: […] de indulg. 7 an. pro d. eccl. sive capel., Conc. de 3 an."@la .


:hat_Microfilmangabe a owl:DatatypeProperty ;
  rdfs:subPropertyOf owl:topDataProperty ;
  rdfs:domain :Fundstelle ;
  rdfs:range xsd:string ;
  :stringInRG "microf. p. 311."@de ;
  rdfs:label "has microfilm reference"@en ,
  "hat Microfilmangabe"@de ;
  skos:definition "Diese Data Property ordnet einer Instanz von Fundstelle eine Microfilmangabe als Zeichenkette zu. Microfilmangaben kommen nur in seltenen Fällen anstelle von Band- und Folioangaben vor (insbesondere in den Bänden 5, 6 und 9)."@de ;
  skos:example "RG 5/1: […] 7. apr. 1445 Paris, Q. A. 1 microf. p. 311."@de .


:hat_Alter a owl:DatatypeProperty ;
  rdfs:subPropertyOf owl:topDataProperty ;
  rdfs:domain :Person ;
  rdfs:range xsd:integer ;
  rdfs:label "has age"@en ,
  "hat Alter"@de ;
  skos:definition "Diese Data Property ordnet einer Person einen Zahlenwert zu, der das Alter der Person angibt."@de ;
  skos:editorialNote "In manchen Fällen gibt der Petent sein Alter explizit an, weil es für den Fall relevant ist (siehe Beispiel). In anderen Fällen lässt sich das Alter aus kirchenrechtlichen Bestimmungen erschließen (z.B. Dispens wg. Altersdefekt)."@de ;
  skos:example "hier in Klammern (23): RG IV 00041: Adolphus de Eppensteyn (Appensteyn, Eppesteyn) can. Colon. de com. gen. de disp. sup. def. et. (23) 17 sept. 1427 S 211 26v."@la .


:hat_Wikidata-ID a owl:DatatypeProperty ;
  rdfs:subPropertyOf owl:topDataProperty ;
  rdfs:domain owl:Thing ;
  rdfs:range xsd:string ;
  rdfs:label "hat Wikidata-ID"@de ;
  skos:definition "Diese Data Property ordnet einer Instanz der Ontologie eine Wikidata-ID als Zeichenkette zu."@de .


:hat_FactGrid-ID a owl:DatatypeProperty ;
  rdfs:subPropertyOf owl:topDataProperty ;
  rdfs:domain owl:Thing ;
  rdfs:range xsd:string ;
  rdfs:label "hat FactGrid-ID"@de ;
  skos:definition "Diese Data Property ordnet einer Instanz der Ontologie eine FactGrid-ID als Zeichenkette zu."@de .


:hat_Namenszusatz a owl:DatatypeProperty ;
  rdfs:subPropertyOf owl:topDataProperty ;
  rdfs:domain :Person ;
  rdfs:range xsd:string ;
  rdfs:label "has name suffix"@en ,
  "hat Namenszusatz"@de ;
  skos:definition "Diese Property stellt die Beziehung zwischen einer Instanz der Klasse Person und einer Instanz der Klasse Name her, die einen Namenszusatz der Person bezeichnet, etwa einen Herkunfts-, Adels- oder Ortszusatz."@de ;
  skos:example "de Castronovo (RG VI 01496)"@la .


:hat_KlosterID-GS-ID a owl:DatatypeProperty ;
  rdfs:subPropertyOf owl:topDataProperty ;
  rdfs:domain :Religioese_Gemeinschaft ;
  rdfs:range xsd:string ;
  rdfs:label "hat KlosterID-GS-ID"@de ;
  skos:definition "Diese Data Property ordnet einer Instanz von Religiöse Gemeinschaft eine KlosterID-GS-ID als Zeichenkette zu."@de .


:hat_Dauervermerk a owl:DatatypeProperty ;
  rdfs:subPropertyOf owl:topDataProperty ;
  rdfs:domain :Aktivitaet ;
  rdfs:range xsd:string ;
  rdfs:label "has duration note"@en ,
  "hat Dauervermerk"@de ;
  skos:editorialNote "Diese Data Property ordnet einer Instanz von Activity eine nicht-quantifizierte Dauerangabe als Text zu und dient der Erfassung freier oder formelhafter Dauerbezeichnungen (z.B ad vitam)."@de ;
  skos:example "\"ad vitam\": RG 3/235: Amplonius de Berka mag. in med. et art. et ad legendum phisicam in univ. studii Colon. per commun. civit. Colon. deput. disp. super lectura phisice etc. ad vitam l mart. 1414 L 172 240."@la .


#################################################################
#    Classes
#################################################################

:Cod_Ottob_Lat_I a owl:Class ;
  rdfs:subClassOf :Codices_Vaticani ;
  :stringInRG "Cod. Ottob. Lat."^^xsd:string ;
  :bezieht_sich_auf_RG-Band "RG X"^^xsd:string ;
  rdfs:label "Cod._Ottob._Lat. (I)"@de ;
  skos:altLabel """Biblioteca Apostolica Vaticana, Codices Ottoboniani
Latini"""^^xsd:string ;
  skos:definition "Cod. Ottob. Lat. bezeichnet eine kuriale Überlieferungseinheit, deren Inhalt in einem oder mehreren Einträgen des Repertorium Germanicum verarbeitet ist. Die Sammlung umfasst überwiegend Papierhandschriften, die aus dem 16. Jahrhundert stammen. Da sie teilweise Vorarbeiten für Indizes beinhaltet, sind die Einträge dort mitunter ausführlicher."@de .


:Cod_Cappon_I a owl:Class ;
  rdfs:subClassOf :Codices_Vaticani ;
  :stringInRG "Cod. Cappon."^^xsd:string ;
  :bezieht_sich_auf_RG-Band "RG X"^^xsd:string ;
  rdfs:label "Cod._Cappon. (I)"@de ;
  skos:altLabel "Biblioteca Apostolica Vaticana, Codices Capponiani"^^xsd:string ;
  skos:definition "Cod. Cappon. bezeichnet eine kuriale Überlieferungseinheit, deren Inhalt in einem oder mehreren Einträgen des Repertorium Germanicum verarbeitet ist. Es handelt sich um eine Sammlung verschiedener Handschriften, die überwiegend aus dem 16. Jahrhundert stammen."@de .


:Registeramt a owl:Class ;
  rdfs:subClassOf :Kuriale_Institution ;
  rdfs:label "Registeramt"@de ;
  skos:definition """Ein Amt, dem die Registrierung der päpstlichen Urkunden oblag. \"Mit dem Eintrag in das Register fand dann die Expedition der Päpstlichen Schreiben in der Kanzlei ihren Abschluß. Hier kommen nur die Kommunregister in Betracht, da für sie eine besondere Behörde eingerichtet war: das Registeramt.\" (RG 3, S. 23*); siehe Registrator. 

\"Hinsichtlich seiner Funktionen gehörte das Register genau wie die Bullarie zur Kanzlei, der Taxgelder wegen war es jedoch organisatorisch der Kammer unterstellt, die früher auch die Rechnungsführung wahrgenommen hatte.\" (RG 3, S. 25*). 

\"Mit der Zahlung der Registergelder war auch dem letzten Anspruch der Kanzleibehörden auf Expeditionsgebühren Genüge getan. Die Ausfertigung konnte dementsprechend im Registeramt der Partei ausgehändigt werden. Hatte jedoch die Camera apostolica noch Forderungen an den Empfänger, mußte die Urkunde in die Kammer abgeliefert werden. Meist waren die Registerschreiber die Überbringer.\" (RG 3, S. 26*)."""@de ;
  skos:example "RG I 01071: Henricus Bayler (Beyler, Bailler) [… ] can. Constant. litterarum ap. scriptor: prov. de off. registrature litt. ap. 25 oct. 1379 A 221 282 v."@la .


:Kaiserin a owl:Class ;
  rdfs:subClassOf :Weltliches_Amt ;
  :stringInRGX "imperatrix"@la ;
  rdfs:label "Kaiserin"@de ,
  "imperatrix"@la ;
  skos:definition "Eine Kaiserin ist eine Frau, die entweder selbst kaiserliche Herrschaft ausübt oder den kaiserlichen Titel als Gemahlin eines Kaisers trägt."@de .


:Klosterkirche a owl:Class ;
  rdfs:subClassOf :Kirche ;
  :stringInRGX "eccl. mon. Dalen o.Cist. e.m. Magunt."@la ;
  rdfs:label "Klosterkirche"@de ;
  skos:definition "Eine Klosterkirche ist die zentrale Kirche einer klösterlichen Gemeinschaft. Sie dient hauptsächlich dem Stundengebet, der Messfeier und der klösterlichen Liturgie."@de ;
  skos:example "RG VI 00017: Adam Tragas presb. de nova prov. de alt. s. Margarete in eccl. mon. Dalen o.Cist. e.m. Magunt. (24 m.arg. ), ad quod vac. p.o. Johannis Rumelfels present. fuit p. patron., n.o. vicar. in eccl. b. Marie ad grad. Magunt. (4) 19. nov. 1450 S 446 250rs."@la .


:Bischof a owl:Class ;
  rdfs:subClassOf :Kirchliches_Amt ;
  :stringInRGX "antistes"@la ,
  "episcopalis"@la ,
  "episcopatus"@la ,
  "episcopus"@la ;
  :stringInRG "ep."@la ,
  "episc."@la ,
  "epp."@la ;
  rdfs:label "Bischof"@de ;
  skos:definition "Kleriker, der einer Diözese vorsteht und sowohl geistliche als auch administrative und richterliche Aufgaben übernahm (vgl. K. Pennington, H.M. Biedermann, B.-U. Hergemöller, L. Ott, K. Richter,  R. Manselli, \"Bischof, -samt\", in: LexMA 2, Sp. 228-235)."@de ;
  skos:example "RG VI 00137: Altdorff mon. o. s. Ben. Argent. dioc. : supplic. Ruperto ep. Argent. de relax. 7 an., quia devastatum fuit p. armig. scortatores nunc. 5. apr. 1453 S 465 75vs, L 483 209rs."@la .


:Kanzler a owl:Class ;
  rdfs:subClassOf :Weltliches_Amt ;
  :stringInRGX "cancellarius"@la ;
  rdfs:label "Kanzler"@de ;
  skos:definition """Leiter einer weltlichen Kanzlei

\"[…] Schon in karol. Zeit wurden die Agenden der K., d. h. die Ausstellung von Urkk., von Angehörigen der Hofkapelle wahrgenommen; an deren Spitze stand der archicapellanus (→Erzkanzler), zu dessen Aufgaben auch die →Rekognition der Diplome zählte. Für den eigtl. Leiter der K. waren verschiedene Bezeichnungen üblich: archinotarius, protonotarius, summus notarius; darunter auch cancellarius (Witger 858, Hebarhard 868). Eine feste Form erhielt dieses Amt jedoch erst unter Otto I. (953, Liutolf); fortan rekognosziert auch der Kanzler stellvertretend (ad vicem) für den Erzkanzler. Ähnlich der Funktion des Erzkanzlers gab es seit Otto I. für Italien und später fallweise auch für Burgund eigene Kanzler und zumindest formell eigene K.en, ehe Heinrich V. 1122 die it. K. aufließ und es fortan bei einem Kanzler beließ. Die Kanzler hatten als enge Vertraute der Herrscher zunehmend polit. Aufgaben zu übernehmen, was in der Regel ihren Aufstieg zu hohen geistl. Würden begründete. Seit Konrad III. galten sie als Reichsfs.en. Erst Heinrich VI., der das Kanzleramt jahrelang unbesetzt ließ, leitete im Zusammenhang mit der Bestellung eines eigenen Kanzlers für Sizilien die Entwicklung der Kanzlerwürde zu einem Hofamt ein, das von Bf.en, später aber auch von anderen geistl. Würdenträgern bekleidet wurde. Nach dem →Interregnum bemühten sich die Erzkanzler zeitweise erfolgreich, Einfluß auf die Bestellung der Kanzler als führende Berater und Räte des Kg.s zu erlangen. Die eigtl. K.leitung war seit Friedrich I. auf die Protonotare (Heinrich v. Wiesenbach, 1157) übergegangen, die seit dem 13. Jh. auch den Titel →Vizekanzler führten. Der erste Laie, der das Kanzleramt erlangte, war 1432 Kaspar →Schlick, der zuvor vom Schreiber zum Protonotar aufgestiegen war. Die kgl. (ksl.) K. (»Reichsk.«) bestand aus mehreren, in der Regel der Kapelle angehörenden Notaren (capellani et notarii), denen mitunter auch polit. Aufgaben übertragen wurden; für das Schreiben der Urkk. zog man hingegen bei Bedarf auch Gelegenheits- oder Empfängerschreiber (→Empfängerausfertigung) heran. Im Unterschied zu anderen K.en kennen die Urkk. der dt. Herrscher keinen Schreibervermerk, so daß die Identifizierung namentl. bekannter Notare mit bestimmten Schreiberhänden nur in Ausnahmefällen mögl. ist. Mit der zunehmenden Schriftlichkeit seit dem ausgehenden 12. Jh. vergrößerte sich die Zahl des K.personals, die K.organisation wurde durch Zuteilung von Ressorts (notarius, registrator, sigillator) sowie die Verfeinerung des Arbeitsablaufs verbessert (→Register, →Formelbücher) und durch K.ordnungen geregelt. Seit dem 14. Jh. stieg die Zahl der weltl. K.kräfte an, wobei ihrer jurist. Ausbildung steigende Bedeutung zukam. Im SpätMA wurde die K. als Hofinstitution ein spezif. Bestandteil des Herrschaftssystems.

Auch in der Ausbildung der landesherrl. Verwaltung standen die K.en als Beurkundungsstellen am Anfang der Entwicklung, wobei jene geistl. Institutionen schon im 12. Jh. ausgeprägt erscheinen. Im 13. Jh. ist der Wandel zu Verwaltungsk.en zu beobachten, indem man die immer zahlreicher und differenzierter werdenden schriftl. Arbeiten verschiedenen, auch dezentralen Schreibstuben anvertraute, während die Hofk. zentrale Verwaltungsfunktionen übernahm. Die Loslösung von der Kapelle erfolgte dabei im allg. später als in der Reichsk.

Eine ähnl. Tendenz ist auch bei den Stadtk.en zu beobachten. Seit dem ausgehenden 12. Jh. sind vereinzelt Stadtschreiber nachweisbar; seit dem späteren 13. Jh. verfügen sie in größeren Städten bereits über einen Mitarbeiterstab für die eigtl. K.arbeit (Ausstellung und →Beglaubigung von Urkk., Führen der →Stadtbücher usw.). Vielfältige Aufgaben wurden ihnen im Dienst der Stadt übertragen, für die zunehmend Rechtskenntnisse erforderl. sind. Neben den Stadtk.en bestanden die Schreibstuben der sich im SpätMA entwickelnden städt. Ämter.\" (P. Csendes, \"Kanzlei, Kanzler\", in: LexMA 5, Sp. 910-912)."""@de ;
  skos:example "RG V 00954: Caspar (Guaspar(rus), Ghaspar) Slick (Sclick) (de Egra) com. palatinus, nob. vir cancellarius [Sigismundi] imper.: assign. 200 fl. p.m. Cosme et Laurentii de Medicis pro certis negotiis pape p. eum peragendis 28. iul. 1433 M 827 159v."@la .


:Koenig_von_Rom a owl:Class ;
  rdfs:subClassOf :Koenig ;
  :stringInRGX "Romanorum rex"@la ;
  rdfs:label "König von Rom"@de ;
  skos:definition "König von Rom bezeichnet den Regenten mit dem Titel „König der Römer“."@de ;
  skos:example "RG II 00237: Wenzeslaus Rom. et Boemie rex notificant cardinales transitum Urbani VI. 16 oct. 1389 V 312 68."@la ,
  "RG II 06693: Rupertus Bavarie dux et com. Palatinus et Elizabeth eius ux. Romanorum rex: m. ( August. Wormat. Herbip. Verden. ep. ), ut exigant decimam in Alamania Brabantia Flandria in subsidium d. regis qui quam celerrime Romam accessurus sit 1 oct. 1403 V 320 183v."@la .


:Paris_L_25_A_I a owl:Class ;
  rdfs:subClassOf :Bestaende_aus_Paris ;
  :stringInRG "Paris L 25 A 8"^^xsd:string ,
  "Paris L 25 A 9"^^xsd:string ;
  :bezieht_sich_auf_RG-Band "RG X"^^xsd:string ;
  rdfs:label "Paris_L_25_A (I)"@de ;
  skos:altLabel "Paris L 25 A 8 = Paris, Archives Nationales"^^xsd:string ;
  skos:definition "Paris L 25 A bezeichnet eine kuriale Überlieferungseinheit, deren Inhalt in einem oder mehreren Einträgen des Repertorium Germanicum verarbeitet ist. Es handelt sich um Registerbände, in denen sich Kleriker zur Zahlung von Annaten für ihre erhaltenen Pfründen verpflichteten. Diese Bände befinden sich heute in den französischen Nationalarchiven in Paris."@de .


:Offizial a owl:Class ;
  rdfs:subClassOf :Kirchliches_Amt ;
  :stringInRGX "officialis"@la ;
  :stringInRG "offic."@la ,
  "official."@la ;
  rdfs:label "Offizial"@de ;
  skos:definition "\"bezeichnet den Stellvertreter des Bf.s in der Gerichtsbarkeit; sein Amt entwickelte sich um das 13. Jh. regional wie zeitl. verschieden, mit zunächst uneinheitl. Strukturierung (deutl. beim O. frz. bzw. dt. Typs) und auch Benennung aus kanonist. geschulten Mitgliedern der bfl. →Kurie. Den Hauptgrund für seine Entstehung sieht man im Anwachsen anhängiger Gerichtssachen, dem zunächst durch von Fall zu Fall delegierte Richter nach dem Vorbild der röm. Kurie Rechnung getragen wurde; als Instrumentarium der Bf.e bei ihrem Bemühen, den Einfluß der →Archidiakone (die z. T. selbst schon O.e hatten) zurückzudrängen, dürfte die Einrichtung des O.s (und die des →Generalvikars für die Verwaltung) überschätzt worden sein. In der Folgezeit wurde der O. zum abberufbaren, seinem officium, nicht mehr einem beneficium verhafteten bfl. Beamten; als gelehrter Einzel-Berufsrichter übte er an der Spitze der bfl. Justizbehörde, des Offizialats, das vom Bf. als oberstem geistl. Gerichtsherrn seine Statuten erhielt, die umfassende Gerichtsbarkeit in der Diöz. aus.\" (H. Zapp, \"Offizial\", in: LexMA 6, Sp. 1370-1371)."@de ;
  skos:editorialNote "Achtung: Die Abkürzung offic. steht oft für officium, nicht für Offizial."@de ;
  skos:example "RG II 00217: Stanislaus Prus can. et offic. Poznan. succollect. in civ. et dioc. Poznan. a Dobrogostio collect. deput. 85 C 320."@la .


:Akademische_Insignien a owl:Class ;
  rdfs:subClassOf :Insignien ;
  :stringInRGX "doctoratus insignia"@la ;
  rdfs:label "Akademische Insignien"@de ;
  skos:definition "Akademische Insignien sind legitimierende Kennzeichen einer verliehenen Würde, eines Amtes oder eines besonderen Ranges im universitären Kontext."@de ;
  skos:example "RG IX 01551: Georgius Teyninger prof. o. fr. herem. s. Aug. conv. sive dom. Monachen. Frising. dioc., art. doct., in theol. lector de conc. ut etiam extra septa domorum d. ord. morando usque ad 7 an. ius can. audire et legere ac in illo etiam doctoratus insignia recip. valeat &nbsp; 24. mai. 1466 S 595 203r."@la .


:Index_Cedularum_Consistorialium_I a owl:Class ;
  rdfs:subClassOf :Kuriale_Ueberlieferungseinheit ;
  :stringInRG "Ind. Ced."^^xsd:string ;
  :bezieht_sich_auf_RG-Band "RG VIII"^^xsd:string ;
  rdfs:label "Index_Cedularum_Consistorialium (I)"@de ;
  skos:altLabel "Archivio segreto Vaticano, Index Cedularum Consistorialium"^^xsd:string ;
  skos:definition "Index Cedularum Consistorialium bezeichnet eine kuriale Überlieferungseinheit, deren Inhalt in einem oder mehreren Einträgen des Repertorium Germanicum verarbeitet ist. Dieser in der Barockzeit entstandene Band enthält eine Zusammenstellung von Konsistorialpfründen und deren Servitien für die Pontifikate von Martin V. bis Clemens VIII. Er ist alphabetisch nach Diözesen geordnet; als Quellen dienten vor allem Annaten-, Obligations- und Kommunregister. Der Zweck der Anlage war vermutlich die Überprüfung der Servitientaxen. Die Einträge sind besonders in jenen Fällen von Bedeutung, in denen die zugrunde liegenden Register verloren gegangen sind."@de .


:Interdikt a owl:Class ;
  rdfs:subClassOf :Zensurstrafe ;
  :stringInRG "interd."@la ,
  "interdictum"@la ;
  rdfs:label "Interdikt"@de ;
  skos:definition "Ein Interdikt ist eine kirchliche Zensurstrafe, durch die für eine Person, eine Gemeinschaft oder ein Gebiet die Feier bestimmter Sakramente und kirchlicher Handlungen ganz oder teilweise untersagt wird."@de ;
  skos:example "RG I 00485: […] lic. celebrari faciendi in locis interdictis […]"@la ,
  "RG I 00667: […] ( cass. ) de lic. celebrari faciendi tempore interdicti […]"@la ,
  "RG I 03241: […] lic. audiendi tempore interdicti divina […]"@la ,
  "RG II 02492: […] et cass. interd. latum a Gelasio abb. mon. s. Jacobi Schotorum Erfford. o. s. Ben. Magunt. dioc. […]"@la ,
  "RG III 00165: […] de locis interdictis […]"@la .


:Resignationes_I a owl:Class ;
  rdfs:subClassOf :Kuriale_Ueberlieferungseinheit ;
  :stringInRG "R"@la ,
  "Resign."@la ;
  :bezieht_sich_auf_RG-Band "RG IX"^^xsd:string ,
  "RG VII"^^xsd:string ,
  "RG VIII"^^xsd:string ,
  "RG X"^^xsd:string ;
  rdfs:label "Resignationes (I)"@de ;
  skos:altLabel "Archivio segreto Vaticano, Resignationes"^^xsd:string ;
  skos:definition "Resignationes bezeichnet eine kuriale Überlieferungseinheit, deren Inhalt in einem oder mehreren Einträgen des Repertorium Germanicum verarbeitet ist. Diese Serie umfasst Register, welche die mit Zustimmung der Kurie vorgenommenen Veränderungen im Besitzstand einzelner Benefizien dokumentieren. Davon waren auch die höchsten Ränge der kirchlichen Hierarchie nicht ausgenommen."@de ;
  skos:editorialNote """R (RG VII, RG VIII)
Resign. (RG IX, RG X)"""^^xsd:string .


:Propst a owl:Class ;
  rdfs:subClassOf :Stiftsamt_Leitung ;
  :stringInRGX "prepositus"@la ;
  :stringInRG "prep."@la ,
  "prepos."@la ;
  rdfs:label "Propst"@de ;
  skos:definition """\"P[ropst] ist die urspr. Bez. für den Stellvertreter des Abts […], später auch für den Vorsteher kleinerer Klöster. Der Titel findet Eingang in das Kanonikerwesen […] u. dient meist als Bez. des ersten Dignitärs (Dom-, Stifts-P[ropst]). Vielfach heißen die Vorsteher v. Chorherren-Stiften P[ropst]. Ferner führen den Titel bestimmte Kapläne u. Pfarrer an ehem. K[loster-] oder Stiftskirchen, bes. in Nord-Dtl. auch Pfarrer größerer Pfarreien. […]\" (Johann Hirnsperger, \"Propst\", in: LThK 8, Sp. 642).

\"[…] Die Verwaltung der Güter war auch die vorrangige Aufgabe des an der Spitze der Dom- und Stiftskapitel stehenden P.es (→Kapitel).\" (A.de Vogüé, \"Propst\", in: LexMA 7, Sp. 264).

Mancherorts wird der Archidiakon auch Propst genannt, vgl. RG IV 01002."""@de ;
  skos:example "RG VI 00098: Albertus Osen prep. eccl. Lubic. oblig. sup. annat. par. eccl. s. Petri de Brantonico Veronen. dioc. (8 m. arg. ) ( n. habuit possessionem) 8. dec. 1447 K 1232 16v-18v."@la .


:Amtsausuebung a owl:Class ;
  rdfs:subClassOf :Objekt ;
  :stringInRG "exercendi off."@la ,
  "off. exercendi"@la ;
  rdfs:label "Amtsausübung"@de ;
  skos:definition "Die Klasse Amtsausübung bezeichnet die  Ausübung der mit einem bestimmten Amt verbundenen Aufgaben und Befugnisse."@de ;
  skos:example "RG I 02931: […] lic. exercendi off. vicariatus in archidiaconat. Meten. pro mag. Johanne de Varennis […]"@la .


:Nonne a owl:Class ;
  rdfs:subClassOf :Klosteramt_Amt ;
  :stringInRGX "monialis"@la ;
  :stringInRG "monial."@la ;
  rdfs:label "Nonne"@de ;
  skos:definition "Eine Frau, die in einem Orden die Profess abgelegt hat  (vgl. H. M. Biedermann, A. de Vogüé, \"Mönch, Mönchtum\", in: LexMA 6, Sp. 733-746)."@de ;
  skos:example "RG V 00221: Anastasia filia com. Johannis de Nellenburg monial. professa mon. ss. Felicis et Regule abbat. Thuricen. o. s. Ben. Constant. dioc., prius in o. fr. herem. s. Aug. constit. de lic. assec. qualescumque dign. 22. sept. 1431 S 271 37r."@la .


:Schultheiss a owl:Class ;
  rdfs:subClassOf :Weltliches_Amt ;
  :stringInRGX "scultetus"@la ;
  rdfs:label "Schultheiß"@de ;
  skos:altLabel "scultetus"@la ;
  skos:definition "\"[…] insbes. im dörfl. Bereich [findet sich] neben richterl. Befugnissen allg. die Funktion der Dorfobrigkeit auch außerhalb der Gerichtsverfassung […]. Dabei gibt es alle Wahlmodalitäten von der freien Wahl durch die Dorfgemeinde bis zur einseitigen Einsetzung durch den Dorfherren. Sachlich gleichbedeutend werden Bezeichnungen wie →Meier, →Vogt, →Ammann u. a. benutzt. Eine Sonderstellung nimmt der S. im →Sachsenspiegel ein, wo er an der Spitze der →Schöffen gegenüber dem Richter steht, wohl eine ostfäl. Sonderentwicklung. Teilweise sondert sich das Amt des →Fronboten aus dem des S.en aus. In vielen Städten des SpätMA und der frühen NZ fungiert der S. als Richter mit Schöffen neben sich, vornehml. in den häufigen S.gerichten.\" (F. Ebel, \"Schultheiß\", in: LexMA 7, Sp. 1591-1592)."@de ;
  skos:example "Jacobus de Paltzow scultetus ville de Paltzow laic. et Catharina ux. Pomezan. dioc. rem. plen. 3. dec. 1450 L 462 242r."@la .


:Gebaeudeabriss a owl:Class ;
  rdfs:subClassOf :Objekt ;
  :stringInRGX "demoliendi"@la ,
  "demolire"@la ,
  "demolitione"@la ;
  rdfs:label "Gebäudeabriss"@de ;
  skos:definition "Ein Gebäudeabriss ist die gezielte, genehmigungspflichtige Entfernung eines bestehenden Bauwerks, bei der dessen bauliche Substanz ganz oder überwiegend beseitigt wird."@de ;
  skos:example "RG VI 03676: Johannes mag. dom. hosp. b. Marie Theotonicorum Jeroslomitani p. Livoniam de demolitione murorum capel. s. Andree non longe a castro Rigen. d. ord. distante ac de transl. cimit. ad capel. s. Johannis, que reparetur 17. aug. 1452 S 461 293r, L 479 104vs."@la ,
  "RG VI 05089: […] de lic. demoliendi capel. […] de ligno exstructa necnon reconstruendi ex lapidibus […]"@la .


:Herzog_von_Pommern a owl:Class ;
  rdfs:subClassOf :Herzog_Amt ;
  :stringInRGX "Pomeranie dux"@la ;
  rdfs:label "Herzog von Pommern"@de ;
  skos:definition "Herzog Pommern bezeichnet einen Herzog als Inhaber der herzoglichen Herrschaft im Herzogtum Pommern."@de ;
  skos:example "RG IV 02770: Ericus rex Dacie etc. (et Pomeranie dux) de lic. fundandi studium generale 26 ian. 1419 S 120 254."@la .


:Deputation a owl:Class ;
  rdfs:subClassOf :Beauftragung ;
  :stringInRGX "deputatio"@la ;
  :stringInRG "deput."@la ;
  rdfs:label "Deputation"@de ;
  skos:definition "Eine Deputation bezeichnet die Einsetzung einer Vertretung, durch die eine Person oder Personengruppe bevollmächtigt wird, eine Instanz zeitlich oder sachlich begrenzt nach außen zu vertreten."@de ;
  skos:example "RG VIII 04732 - Paulus Buse decr. doct. , prep. eccl. s. Mauricii in Hallis can. reg. o. s. Aug. Magdeburg. dioc.de indulg. 7 an. c. lic. deput. confess. 17. decb. 1461 S 548 54rss."@la .


:IE_II_I a owl:Class ;
  rdfs:subClassOf :Bestaende_aus_Florenz ;
  :stringInRG "IE II"^^xsd:string ;
  :bezieht_sich_auf_RG-Band "RG III"^^xsd:string ;
  rdfs:label "IE_II (I)"@de ;
  skos:altLabel "Florenz, Bibl. nazianale XIX 81"^^xsd:string ;
  skos:definition "IE_II bezeichnet eine kuriale Überlieferungseinheit, deren Inhalt in einem oder mehreren Einträgen des Repertorium Germanicum verarbeitet ist. Der Band stammt aus der Thesaurarie (die päpstliche Schatzmeisterei) und enthält als Teil der Reihe Introitus et Exitus das Hauptrechnungsbuch über die Einnahmen und Ausgaben der Apostolischen Kammer."@de .


:Siegelamt a owl:Class ;
  rdfs:subClassOf :Kuriale_Institution ;
  rdfs:label "Siegelamt"@de ,
  "bullaria"@la ;
  skos:altLabel "Bullarie"@de ,
  "bulla"@la ;
  skos:definition """Amt, das mit der Besiegelung der päpstlichen Urkunden betraut war, siehe Bullator.

\"Hinsichtlich seiner Funktionen gehörte das Register genau wie die Bullarie zur Kanzlei, der Taxgelder wegen war es jedoch organisatorisch der Kammer unterstellt, die früher auch die Rechnungsführung wahrgenommen hatte.\" (RG 3, S. 25*)."""@de ;
  skos:example "RG VII 00385: Conradus Ingenwin(c)kel de Capella cler. Colon. ( dioc. ) fam. ap. surrog. Johanni de Macaronibus cler. Penestrin. ad off. lectorie litt. ap. in bullaria ap. vac. p. o. Johannis Barne 3 mai. 1457 V 465 306rss."@la .


:Mangel a owl:Class ;
  rdfs:subClassOf :Objekt ;
  :stringInRGX "defectus"@la ;
  :stringInRG "def."@la ;
  rdfs:label "Mangel"@de ;
  skos:definition "Umstand, der einem Weiheempfang oder einer Pfründe im Wege steht. Manche Mängel verschwinden mit der Zeit, andere sind dauerhaft. Mängel können mit einer Dispens beseitigt werden."@la .


:Kanzlei a owl:Class ;
  rdfs:subClassOf :Kuriale_Institution ;
  :stringInRGX "cancelleria"@la ,
  "officium cancellarie"@la ;
  :stringInRG "canc."@la ,
  "canc. ap."@la ;
  rdfs:label "Kanzlei"@de ;
  skos:definition "Die päpstliche Kanzlei war die zentrale Behörde der römischen Kurie, die für die Ausfertigung, Registrierung und formale Beglaubigung päpstlicher Urkunden zuständig war."@de ;
  skos:example """RG II 09402: 
Roterus de Balhorn mag. not. et officium cancellarie regens litt. passus 8 oct. 1409 V 337 127."""@la ,
  "RG V 00563: […] canc. ap. regenti assistens, fam. pape, a R. cur. pro suis negotiis ad nonnullas partes Alamannie recessurus salvus conductus c. comitiva 6 personarum 20. iul. 1432 V 372 39v."@la ,
  "RG VI 03019: Johannes Heydecker (Haidecker) rect. par. eccl. in Amlungstat Bamberg. dioc. secr. Antonii ep. Bamberg. in cancelleria supplic. d. ep. de disp. n. prom. […]"@la .


:Kalandsbruderschaft a owl:Class ;
  rdfs:subClassOf :Religioese_Laienvereinigung ;
  :stringInRG "fr. kalend."@la ,
  "kalend. fr."@la ;
  rdfs:label "Kalandsbruderschaft"@de ;
  skos:definition "\"(fratres calendarii), spätma. geistl. →Bruderschaft aus Klerikern und Laien (so gen. nach den Zusammenkünften am ersten Tag des Monats).\" (E. Hoffmann, \"Kaland\", in: LexMA  5, Sp. 864-865)"@de ;
  skos:example "RG II 00851: Bertrandus de Moer rect. alt. s. Crucis in par. eccl. op. Wretzen Brandenburg. dioc. f. gr. de benef. ad coll. fr. kalend. in par. eccl. s. Nicolai in Godebutz d. dioc., in Molne Razeburg. dioc., n. o. benef. ad coll. fr. kalend. in par. eccl. s. Marie in Berlin Brandenburg. dioc., in Bernow d. dioc. dim. quoad cur., 9 nov. 1398 L 70 253."@la .


:Siegelbewahrer a owl:Class ;
  rdfs:subClassOf :Kuriales_Amt ;
  :stringInRGX "custos sigilli"@la ,
  "sigillifer curie"@la ;
  rdfs:label "Siegelbewahrer"@de ;
  skos:definition "Ein Siegelbewahrer ist ein Amtsträger, der für die Verwahrung eines offiziellen Siegels sowie für dessen ordnungsgemäßen Einsatz bei der Beglaubigung von Urkunden zuständig ist."@de ;
  skos:example "RG IV 06466: Johannes (de) Bettynhusen (Bettenhusen, Bettynchusen, Beyttenhusen; de Suntra) cler. Magunt. sigillifer vel custos sigilli auditoris curie camere 3 aug. 1430 DC 13 122."@la .


:Ort a owl:Class ;
  rdfs:subClassOf owl:Thing ;
  :stringInRGX "Butzowen."@la ,
  "Ruppin"@la ;
  rdfs:label "Ort"@de ;
  skos:definition "„Diese Klasse umfasst Ausdehnungen im natürlichen Raum, in dem wir leben, insbesondere auf der Oberfläche der Erde, im rein physikalischen Sinn: unabhängig von zeitlichen Phänomenen und von Materie. Sie können zur Beschreibung der physischen Lage von Dingen oder Phänomenen oder anderer Bereiche von Interesse dienen. Geometrisch bilden Instanzen von E53 Place einzelne zusammenhängende Flächen oder eine endliche Aggregation voneinander getrennter Flächen im Raum, die jeweils für sich zusammenhängend sind. Sie können unscharfe Grenzen aufweisen.“ (CIDOC)"@de ;
  skos:editorialNote <http://www.cidoc-crm.org/cidoc-crm/E53_Place> ;
  skos:example "Berlin"@de ,
  "Diözese Magdeburg"@de ,
  "Grafschaft Ruppin"@de .


:Sekretaer a owl:Class ;
  rdfs:subClassOf :Weltliches_Amt ;
  :stringInRGX "secretarius"@la ;
  :stringInRG "secr."@la ;
  rdfs:label "Sekretär"@de ;
  skos:definition "\"nach dem →Interregnum begegnen zunehmend S[ekretäre] geistl. oder viel seltener weltl. Standes, in dt. Sprache »heiml.« genannt, als Berater der dt. Kg.e. Jurist. Bildung wurde für sie allmähl. ein Charakteristikum. Der Titel \"S.\" konnte aber auch ehrenhalber an Personen verliehen werden, die nicht in regelmäßigem Kontakt zum Hof oder zur Kanzlei standen. In der Herrscherkanzlei ist die Bezeichnung \"S.\" (secretarius), von vereinzelten Nennungen abgesehen, erst seit der Mitte des 14. Jh. üblich, doch läßt sich keine generalisierende Aussage über die Funktion dieser S.e treffen. Im allg. haben sie wohl über bes. Qualifikationen wie stilist. Fähigkeiten oder Rechtsstudium verfügt und standen über den einfachen Schreibern. S.e wurden ähnl. den →Notaren des hohen MA mit polit. Missionen betraut. Am Ende des MA entwickelte sich \"S.\" zu einer festen Rangbezeichnung innerhalb der Kanzlei, und die S.e erlangten eine Stellung zw. dem Schreib- und Registraturpersonal und den Räten. Die Kanzleiordnung v. 1494 weist ihnen als Aufgabe die Verfertigung von →Konzepten sowie die Überwachung von deren Reinschrift und allfälliger Registrierung zu. Einige der Kanzlei angehörende S.e vermochten Karriere zu machen, so z. B. Pius II., S. Ks. Friedrichs III., und Matthäus Lang († 1540), Kard. und Ebf. v. Salzburg.\" (P. Csendes, \"Sekretär, I. Deutsches Reich\", in: LexMA 7, Sp. 1722-1723)."@de ;
  skos:editorialNote "Achtung: Die Bezeichnungen secr. und secretarius können sich je nach Kontext auf den Kuriensekretär (secr. pape) oder auf andere Sekretäre beziehen, z.B. von Königen oder Bischöfen (secr. regis o. Ä.), vgl. Kuriales_Amt."@de ;
  skos:example "RG I 01230: Henricus de Ludenschede (Ludenstede) cler. Colon. dioc. secretarius regis Francorum de benef. ad coll. ep. etc. Leod. vel de can. sub expect. preb. eccl. s. Cassii Bunnen. Colon. dioc. S 67 127."@de ,
  "RG V 00245: Andreas Derslai de Jaczkowe Andreas Derslai de Jaczkowe cler. Gneznen. dioc., ex utr. de nob. gen., secr. Alberti [Jastrzembiec] aep. Gneznen. (Branda [de Castillione] ep. Portuen. card. Placentin. supplic. ) de can. et preb. eccl. Cracov. (15 m. arg. ) vac. p.o. Nicolai de Lubanija fam. d. card.; n.o. can. et preb. ac alt. b. Marie et s. Stanislai in eccl. Gneznen. et par. eccl. in Jantzewo Gneznen. dioc. (insimul 24 m. arg. ) 26. ian. 1432 S 274 144r."@la .


:Fondo_dellArchivio_di_Stato_1831_I a owl:Class ;
  rdfs:subClassOf :Fondo_Spezialbestaende ;
  :stringInRG "ASO"^^xsd:string ;
  :bezieht_sich_auf_RG-Band "RG III"^^xsd:string ;
  rdfs:label "Fondo_dell'Archivio_di_Stato_1831 (I)"@de ;
  skos:definition "Fondo dell'Archivio di Stato 1831 bezeichnet eine kuriale Überlieferungseinheit, deren Inhalt in einem oder mehreren Einträgen des Repertorium Germanicum verarbeitet ist. Er beinhaltet Quittungen, wie beispielsweise Servitienquittungen (unter anderem vom 16. Juli 1413)."@de .


:Koenigin a owl:Class ;
  rdfs:subClassOf :Weltliches_Amt ;
  :stringInRGX "regina"@la ;
  rdfs:label "Königin"@de ;
  skos:definition "Königin bezeichnet eine Frau, die entweder selbst ein Königreich regiert oder als Ehefrau eines Königs den Titel einer Königin trägt."@de .


:Bischoefliche_Insignien a owl:Class ;
  rdfs:subClassOf :Insignien ;
  :stringInRGX "insignia pontific."@la ,
  "insigniis pont."@la ,
  "insigniis pontificalibus"@la ,
  "pont. insigniis"@la ;
  rdfs:label "Bischöfliche Insignien"@de ;
  skos:definition "Bischöfliche Insignien bezeichnen die Zeichen bischöflicher Würde, deren Verleihung auch ehrenhalber an Prälaten erfolgen kann."@de ;
  skos:example "RG V 06867: […] lic. utendi pont. insigniis et benedicendi in ipso mon. […]"@la .


:Depositoria_generale_I a owl:Class ;
  rdfs:subClassOf :Fondo_Camerale_Primo_I ;
  :stringInRG "DG"^^xsd:string ;
  :bezieht_sich_auf_RG-Band "RG IX"^^xsd:string ,
  "RG VI"^^xsd:string ,
  "RG VII"^^xsd:string ,
  "RG VIII"^^xsd:string ;
  rdfs:label "Depositoria_generale (I)"@de ;
  skos:altLabel "Archivio di Stato di Roma, Fondo Camerale Primo: Depositoria generale"^^xsd:string ;
  skos:definition "Depositoria generale bezeichnet eine kuriale Überlieferungseinheit, deren Inhalt in einem oder mehreren Einträgen des Repertorium Germanicum verarbeitet ist. Die Reihe umfasst Geschäftsbücher der Depositare (Bankiers, bei denen die päpstliche Kammer den Großteil ihrer Barmittel deponierte)."@de .


:RG-Strukturelement a owl:Class ;
  rdfs:label "RG-Strukturelement"@de ;
  skos:definition "Eine Klasse, die die Verankerung von Ereignissen im RG (RG-ID und RG-Stellenverweis) und in der päpstlichen Überlieferung (Quellenbeleg) herstellt und damit geschichtswissenschaftliches Arbeiten mit den Ereignissen ermöglicht."@de ;
  skos:editorialNote """Jedes RG-Strukturelement muss drei Angaben zugewiesen bekommen:
1. RG-ID (vgl. Data Property: \"hat RG-ID\")
2. RG-Stellenverweis (vgl. Data Property: \"hat RG-Stellenverweis\")
3. Quellenbeleg (vgl. Object Property: \"basiert auf\")"""@de .


:Crociata_I a owl:Class ;
  rdfs:subClassOf :Fondo_Camerale_Primo_I ;
  :stringInRG "Cr"^^xsd:string ;
  :bezieht_sich_auf_RG-Band "RG IX"^^xsd:string ,
  "RG VIII"^^xsd:string ;
  rdfs:label "Crociata (I)"@de ;
  skos:altLabel "Archivio di Stato di Roma, Fondo Camerale I: Crociata"^^xsd:string ;
  skos:definition "Crociata bezeichnet eine kuriale Überlieferungseinheit, deren Inhalt in einem oder mehreren Einträgen des Repertorium Germanicum verarbeitet ist. Sie enthält die Einnahmen und Ausgaben für den Kreuzzug gegen die Türken aus dem Zeitraum von November 1463 bis September 1464."@de .


:Prozessausgang a owl:Class ;
  rdfs:label "Prozessausgang"@de ;
