  skos:definition "Servitia_Minuta bezeichnet eine kuriale Überlieferungseinheit, deren Inhalt in einem oder mehreren Einträgen des Repertorium Germanicum verarbeitet ist."@de .


:Klostergruendung a owl:Class ;
  rdfs:subClassOf :Gruendung ;
  :stringInRG "fund. mon."@la ;
  rdfs:label "Klostergründung"@de ;
  skos:definition "Klostergründung bezeichnet den rechtlich geregelten Vorgang der Errichtung eines neuen Klosters."@de ;
  skos:example "RG VI 01299: Fredericus R. R. lic. fund. mon. s. Aug. ex par. eccl. in nova civit. Salzeburg. dioc. necnon indulg. sup. pontifical. pro prep. d. mon. ac prep. mon. in Varaw et in Stentz o. s. Aug. d. dioc. necnon lic. bened. d. mon. pro abb. mon. s. Trinitatis nove civit. o. Cist. d. dioc. 7. apr. 1452 V 398 2r-3v."@la .


:Markgraf_von_Brandenburg a owl:Class ;
  rdfs:subClassOf :Markgraf ;
  :stringInRGX "marchio Brandenburg."@la ;
