  "RG IV 00062: Agnes abba. mon. s. Stephani o. s. Aug. August. liberatur a visit. liminum […]"@la .


:Formatari_I a owl:Class ;
  rdfs:subClassOf :Kuriale_Ueberlieferungseinheit ;
  :stringInRG "F"^^xsd:string ;
