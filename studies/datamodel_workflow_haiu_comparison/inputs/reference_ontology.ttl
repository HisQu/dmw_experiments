:Kanonisches_Recht a owl:Class ;
  rdfs:subClassOf :Recht ;
  :stringInRG "in decr."@la ,
  "in decretis"@la ,
  "iur. can."@la ,
  "iure can."@la ,
  "iure canonico"@la ;
  rdfs:label "Kanonisches Recht"@de ;
  skos:definition "Kanonisches Recht bezeichnet eine Unterklasse von Recht, die die von kirchlichen Autoritäten gesetzten Normen zur Regelung der kirchlichen Ordnung, Disziplin und Rechtsprechung umfasst."@de ;
  skos:example "RG 4/133: Albertus Echte (de Echte) cler. Magunt. bac. in iure can. bac. in decr. de conf. can. et preb. eccl. s. crucis Northusen. Magunt. dioc. vac. p. o. Wernheri Kalen acc. p. J. aep. Magunt., n. o. par. eccl. in Flerszheim ac vicar. in eccl. s. Petri Northunen. et in par. eccl. in Dudirstad d. dioc. necnon can. et preb. eccl. s. Martini Hilgenstaden. d. dioc. acc. ad preces primarias Sigismundi regis 15 ian. 1418 S 109 50r, L 194 178v."@la .


:Statusfeststellung a owl:Class ;
  rdfs:subClassOf :Objekt ;
  rdfs:label "Statusfeststellung"@de ;
  skos:definition "Statusfeststellung bezeichnet einen deklaratorischen Akt, durch den das Bestehen eines bestimmten persönlichen Status oder einer sozialen bzw. institutionellen Rolle einer Person durch den Papst festgestellt wird."@de ;
  skos:example "RG V 02749: […] de decl. quod ipse H. ante et post assumptionem Eugenii IV. fam. pape fuit […]"@la .


:Kanonissin a owl:Class ;
  rdfs:subClassOf :Stiftsamt_Amt ;
  :stringInRGX "canonissa"@la ;
  :stringInRG "can."@la ;
  rdfs:label "Kanonissin"@de ;
  skos:definition """Eine Kanonissin (canonissa) war eine fromme, meist adlige Frau, die in einem Frauenstift in einer klosterähnlichen Gemeinschaft lebte.

\"[…] In der Zeit des 9.-11. Jh. beherbergten die Kl. teils Kl.frauen, teils Chorfrauen, die zumeist mit gemeinsamen Bezeichnungen wie \"sanctimoniales\", \"sorores\" und \"ancillae Dei\" bezeichnet wurden, ohne daß eine klare Trennung der beiden Kategorien deutlich wird. Auch die Berufung auf die Regula Benedicti gibt keinen eindeutigen Hinweis auf die Zugehörigkeit zur Gruppe der Kl.frauen, denn manche Religiosen behaupteten, der Regula Benedicti zu folgen, ohne doch auf die Freiheiten der K.n zu verzichten. […] Die Tradition der frühma. K. wurde fortgesetzt von den adligen Stiftsdamen, den sog. Säkular-K.n; ihre Lebensweise war gekennzeichnet durch exklusive adlige Abkunft, Verfügung über eine feste Anzahl von Präbenden, Wegfall der Gelübde, Privatbesitz, manchmal Erlaubnis zu individuellem Leben, temporärer oder dauernder Entfernung vom Kl. Die adligen Frauenkl. und -stifte bildeten das Gegenstück zu den männl. Kapiteln und Stiften, die sie in vielem nachahmten.\" (M. Parisse, \"Kanonissen\", in: LexMA 5, Sp. 907-908)."""@de ;
  skos:example "RG VI 01123: Elsa de Erpach canonissa eccl. in Freden Monast. dioc. rem. plen. 7. dec. 50 L 462 243rs, l. b. dec. 1450 T 7 97r."@la .


:Koenig_von_Frankreich a owl:Class ;
  rdfs:subClassOf :Koenig ;
  :stringInRGX "rex Francorum"@la ;
  rdfs:label "König von Frankreich"@de ;
  skos:definition "König von Frankreich bezeichnet den Regenten des Königreiches Frankreich."@de ;
  skos:example "RG I 00331: Carolus rex Francorum v. Angelus, Clemens ep. Lodoven."@la .


:Geldsumme a owl:Class ;
  rdfs:subClassOf owl:Thing ;
  rdfs:label "Geldsumme"@de ;
  skos:definition "„Diese Klasse umfasst Mengen monetärer Vermögenswerte oder Verpflichtungen in Bezug auf ihren Nominalwert gegenüber einer bestimmten Währung. […]“ (CIDOC). Kann ein Schätzwert sein oder genau."@de ;
  skos:editorialNote <http://www.cidoc-crm.org/cidoc-crm/E97_Monetary_Amount> ;
  skos:example "N. N. N. N. solv. 30 fl. pro ann. can. et preb. eccl. s. Servatii Traiect. Leod. dioc. 7. apr. 1445 Paris, Q. A. 1 microf. p. 311."@la .


:Kammernotar a owl:Class ;
  rdfs:subClassOf :Kuriennotar ;
  :stringInRGX "notarius curie camere ap."@la ;
  rdfs:label "Kammernotar"@de ,
  "notarius camere"@la ;
  skos:definition "Ein Kammernotar ist ein der päpstlichen Kammer zugeordneter Notar, der finanz- und verwaltungsbezogene Rechtsakte protokolliert und beurkundet, vgl. RG 3, S. 29*."@de ;
  skos:editorialNote "Vgl. Thomas Frenz \"Notarius\", in: LexMA, Verlag J.B. Metzler, Vol. 6, cols 1275-1276."@de ;
  skos:example "RG 1/2686: Ludovicus Ryman cler. Magunt. dioc. notarius curie camere ap. de benef. ad coll. cap. eccl. s. Severi Erforden. dicte dioc. S 47 30 v."@la ,
  "RG IV 08855: Johannes Quentin (de Odesloe) fit notarius curie causarum cam. ap. vac. p. res. Johannis Arnoldi de Hoya cler. Bremen. 16 nov. 1424 DC 8 253v."@la .


:Augustinerchorherren a owl:Class ;
  rdfs:subClassOf :Orden ;
  :stringInRG "o. s. Aug."@la ,
  "o. s. Aug. can. reg."@la ;
  rdfs:label "Augustinerchorherren"@de ;
  skos:definition "\"Bei den Augustinerchorherren handelt es sich um regulierte Chorherren, die im 11./12. Jahrhundert die augustinische Regel annahmen und sich zu einem Leben in Gemeinschaft verpflichteten, das von priesterlichem Dienst, Askese, Keuschheit und Armut geprägt war. Eine der wichtigsten Aufgaben der Augustinerchorherren war die Seelsorge. Die Reformbewegung der Kanoniker breitete sich schnell in ganz Europa aus und entwickelte sich bis zum Zeitalter der Reformation zu einem der kulturell bedeutendsten und größten Orden. Fast alle Stifte nahmen auch Laienbrüder (Konversen) auf. Frauenklöster entstanden in enger Anbindung an die Männerklöster, vielfach wurden die Häuser als Doppelklöster gegründet. Häufig schlossen sie sich zu Kongregationen zusammen, wie etwa die Windesheimer Kongregation, die Chorherren vom Hl. Grabe in Jerusalem, die Kreuzherren, die Antoniter und viele mehr. Die Säkularisation bedeutete für den Orden den nahezu vollständigen Niedergang.\" (https://database.factgrid.de/wiki/Item:Q172927)"@de .


:minor_prebenda a owl:Class ;
  rdfs:subClassOf :Praebende ;
  :stringInRG "min. preb."@la ,
  "preb. min."@la ;
  rdfs:label "minor_prebenda"@de ;
  skos:definition "Stiftspfründe mit geringeren Einkünften, häufig für jüngere oder nachrangige Kanoniker."@de .


:Rueckzahlung_von_zu_unrecht_erhaltenen_Pfruendeneinkuenften a owl:Class ;
  rdfs:subClassOf :Person_zahlt_Geld_an_Kammer ;
  :stringInRG "fruct. male"@la ;
  rdfs:label "Rückzahlung von zu unrecht erhaltenen Pfründeneinkünften"@de ;
  skos:definition "Rückzahlung von zu unrecht erhaltenen Pfründeneinkünften bezeichnet einen Zahlungsanlass, bei dem eine Person der Kurie Einkünfte aus einer kirchlichen Pfründe zurückerstattet, die sie ohne rechtmäßigen Anspruch oder entgegen den geltenden Bestimmungen erhalten hat."@de ;
  skos:example "Albertus Hesse (de Steynfurd) presb. Wormat. solv. fruct. male percept. ex vicar. Spiren. 6 febr. 1426 Q 3 223r. (RG IV 00168)"@la .


:Stundengebet a owl:Class ;
  rdfs:subClassOf :Gottesdienst ;
  :stringInRGX "horas canonicas dicere"@la ,
  "horas dicere"@la ;
  rdfs:label "Stundengebet"@de ;
  skos:altLabel "Brevier"@de ;
  skos:definition "\"Erlaubnis, das Beten des Breviers (der kanonischen Stunden) in der an der Kurie praktizierten verkürzten Form vorzunehmen.\" (Bearbeitungshinweise, S. 62)"@de ;
  skos:example "RG IV 00861: […] lic. dicendi horas more Romano […]"@la ,
  "RG IV 04039: […] de conc. quod horas canonicas dicere debent ad usum aliorum mon. o. s. Ben. propria consuetudine in melius reducta […]"@la .


:Bullator a owl:Class ;
  rdfs:subClassOf :Kuriales_Amt ;
  :stringInRGX "bullator"@la ;
  rdfs:label "Bullator"@de ;
  skos:definition "Mitarbeiter des Siegelamtes; \"Damit dort nichts mehr an [der Urkunde] geändert oder verfälscht werden könnte, war es seit alters Brauch, daß dies Amt von zwei des Lesens und Schreibens unkundigen Leuten, meist Laienkonversen des Zisterzienserordens, verwaltet wurde (bullatores, fratri barbati). [...] Nun lag den Bullatoren aber auch die Verwaltung der aus der Bullentaxe eingehenden Gelder ob, die der Camera apostolica zuflossen, während sie selbst sich mit einem gewissen Anteil oder einem kleinen Zuschlag begnügen mußten. […] in der späteren Zeit stellte sich aber doch die Notwendigkeit einer schriftlichen Rechnungsführung ein. Zu dem Zweck zogen die Bullatoren, die sog. clerici litterati familiares heran […]\" (RG 3, S. 21*)."@de .


:Expeditionsmodalitaet a owl:Class ;
  rdfs:subClassOf owl:Thing ;
  rdfs:label "Expeditionsmodalität"@de ;
  skos:definition "Einige Regesten enthalten Angaben zu den Expeditionsmodalitäten des Gnadenbriefes. Diese Angaben finden sich sowohl in Fällen, in denen ein Brief schon ausgestellt wurde (RG IV 00509, motu proprio für eine Provision, Lateranregister), als auch in solchen, in denen uns nichts über den Ausstellungsstatus des Briefes bekannt ist (RG IV 00241, motu proprio, Supplikenregister)."@de .


:Birgitten a owl:Class ;
  rdfs:subClassOf :Orden ;
  :stringInRG "S. Salvatoris"@la ,
  "o. s. Brigide"@la ,
  "o. s. Brigitte"@la ;
  rdfs:label "Birgitten"@de ;
  skos:definition "\"Der Name des Ordens, der der Regel des Heiligen Augustinus folgt, geht auf die mittelalterliche Mystikerin Birgitta von Schweden († 1373) zurück. Nach dem Tod ihres Mannes widmete Birgitta ihr Leben dem Gebet und erlebte Visionen, von denen eine die Gründung eines Ordens war. 1370 gestattete Papst Urban V. die Stiftung eines Nonnen- und eines Priesterklosters in Vadstena mit der Regula Salvatoris als Satzung zur Augustinusregel. Weitere Klöster folgten, jedes mit nicht mehr als 60 Nonnen. Jedem Kloster war eine parallele Gemeinschaft von Mönchen angegliedert, die unter der Leitung der Äbtissin das gleiche liturgische Leben teilten. Der Orden, der Demut, Einfachheit und Kontemplation betonte, blühte bis zur Reformation und wurde 1595 aus Schweden verbannt. Nach dieser Zeit gab es keine Birgittinermönche mehr; nur vier selbständige Nonnenhäuser überlebten die Säkularisation: eines in England, ein weiteres in Bayern (Altomünster) und zwei in den Niederlanden.\" (https://database.factgrid.de/wiki/Item:Q1195147)"@de ;
  skos:example "RG V 08261: Sifridus Cantelborg (Cantelberg) cler. Pomezan. dioc. de capel. s. Antonii e.m. Tarbat. (4 m. arg. ) vac. p. ingr. mon. e.m. Reval. o. s. Brigitte p. Nicolaum Volczen presb. Havelberg. dioc. 5. apr. 1438 S 345 243v."@la .


:Cod_Vat_lat_6330_I a owl:Class ;
  rdfs:subClassOf :Kommunregister ;
  :stringInRG "F"^^xsd:string ;
  :bezieht_sich_auf_RG-Band "RG II"^^xsd:string ;
  rdfs:label "Cod._Vat._lat._6330 (I)"@de ;
  skos:definition "Cod. Vat. lat. 6330 bezeichnet eine kuriale Überlieferungseinheit, deren Inhalt in einem oder mehreren Einträgen des Repertorium Germanicum verarbeitet ist. Der Band enthält Urkunden aus dem Pontifikat Bonifaz' IX., wobei in der Regel konkrete Daten und Namensnennungen fehlen."@de .


:Weihe_Beschleunigung a owl:Class ;
  rdfs:subClassOf :Objekt ;
  :stringInRG "extra temp."@la ;
  rdfs:label "Weihe Beschleunigung"@de ;
  skos:definition "\"Der Erwerb einer Pfründe mit Seelsorgeverpflichtung ist in der Regel mit der Vorschrift verbunden, innerhalb einer bestimmten Frist - meist wird ein Jahr genannt - die höheren Weihen zu empfangen. Um dies rascher als nach dem kanonisch festgelegten Zeitplan tun zu können, gab es die Möglichkeit, sich in Rom durch einen dazu bevollmächtigten Antistes (weiheberechtigten Bischof oder Abt) innerhalb weniger Tage die erforderlichen Weihen erteilen zu lassen. Der genaue Inhalt des Formulars de promovendo enthält dementsprechend die Bitte, einen an der Kurie (selten: etiam extra eam) residierenden Bischof zu bevollmächtigen, den Supplikanten auch außerhalb der vorgeschriebenen Fristen zu promovieren\" (Bearbeitungshinweise, S. 62)."@de ;
  skos:example "RG IV 00015: […] de lic. recip. ord. in curia extra temp. […]"@la ,
  "RG IX 02794: […] referens quod disp. obtin. de prom. ad omnes ord. extra temp. […]"@la .


:Kaiserliche_Kurie a owl:Class ;
  rdfs:subClassOf :Kurie ;
  :stringInRG "imper. cur."@la ;
  rdfs:label "Kaiserliche Kurie"@de ;
  skos:definition "Die kaiserliche Kurie ist die zentrale Hof- und Verwaltungsinstitution des römisch-deutschen Kaisers, die ihn bei Regierung, Rechtsprechung, Diplomatie und Urkundenausstellung unterstützt."@de ;
  skos:example "RG IX 00483: Bernhardus Keyß (Kreiß) de Lindenfels armig. Spiren. dioc. litig. coram Johanne nob. viro com. in Sults iudice imper. cur. in Rotwil Constant. dioc. contra Fridericum nob. virum com. Zwenbrucken Spiren. dioc. sup. quibusdam bonis et iuribus in d. dioc. de committ. in partibus 14. ian. 1469 S 636 184rs, m. L 679 84rs."@la .


:Obligationes_particulares_I a owl:Class ;
  rdfs:subClassOf :Obligationes ;
  :stringInRG "OP"@la ;
  :bezieht_sich_auf_RG-Band "RG IV"^^xsd:string ,
  "RG IX"^^xsd:string ,
  "RG V"^^xsd:string ,
  "RG VII"^^xsd:string ,
  "RG VIII"^^xsd:string ,
  "RG X"^^xsd:string ;
  rdfs:label "Obligationes_particulares (I)"@de ;
  skos:altLabel "Archivio Segreto Vaticano, Obligationes particulares"@la ;
  skos:definition "Obligationes particulares bezeichnet eine kuriale Überlieferungseinheit, deren Inhalt in einem oder mehreren Einträgen des Repertorium Germanicum verarbeitet ist. n dieser Serie wurden die Kleingebühren von Klerikern sowie deren Amtsverzichte dokumentiert."@de .


:Kaemmerer a owl:Class ;
  rdfs:subClassOf :Stiftsamt_Amt ,
  :Weltliches_Amt ;
  :stringInRGX "camerarius"@la ;
  rdfs:label "Kämmerer"@de ;
  skos:definition "\"Zwischen 1231 und 1235 wurde als eine Pflicht des stiftischen Kämmerers festgelegt, daß er die mit der Erledigung der Arbeiten im Dormitorium beauftragten weltlichen Unterkämmerer einzusetzen habe.\" (Wentz/Schwineköper, 1,1, S. 145)"@de ;
  skos:editorialNote "Verwechslungsgefahr mit dem ebenfalls als camerarius bezeichneten päpstlichen Kamerar."@de ;
  skos:example "RG II 05970: Nicolaus d. Nytzek (Nitzel) domic. Wratislav. Wenceslai Rom. et Boemie regis camerarius plen. 3 apr. 1397 L 45 170v."@la .


:Pfruendenstatus a owl:Class ;
  rdfs:label "Pfründenstatus"@de ;
  skos:definition "Pründenstatus ist eine Oberklasse für Status, die Pfründen zugewiesen werden können (z.B. Einkommensstatus oder Besetzungsstatus)."^^xsd:string .


:Zahlung_fuer_Weihe a owl:Class ;
  rdfs:subClassOf :Person_zahlt_Geld_an_Kammer ;
  :stringInRGX "solv. pro subdiacon."@la ;
  rdfs:label "Zahlung für Weihe"@de ;
