  rdfs:label "Altar Objekt"@de ;
  skos:definition "Gemeint als Objekt, vgl. Altar_Institution"@de .


:Pfruendenschaetzwert a owl:Class ;
  rdfs:subClassOf :Geldsumme ;
  rdfs:label "Pfründenschätzwert"@de ;
  skos:definition "Der Pfründenschätzwert ist die geschätzte Höhe eines Jahreseinkommen der jeweiligen Pfründe."@de ;
  skos:editorialNote "Im RG steht der Pfründenschätzwert in Klammern hinter der Pfründe."@de ;
  skos:example "de prepos. et can. et preb. eccl. Quinqueecclesien. (300 fl. ): Albertus de Hangach Albertus de Hangach (Hangnach, Hangas) de nob. gen., prothonot. cancellariae regis Hungarie de prepos. et can. et preb. eccl. Quinqueecclesien. (300 fl. ) vac. p.o. cuiusdam Gregorii; n.o. beneff. Agrien. [MHI II 859, p. 226] 30. iun. 45 S 406 177r, L 424 18r, de prorog. exped. litt. [MHI II 876, p. 230] 27. nov. 45 S 408 263v, solv. 60 fl. pro parte ann. p.m. mag. Thadei de Tervisio 29. ian. 46 IE 412 47r, IE 413 47r, Q 1122 25r, solv. 70 fl. pro compositione residui ann. p.m. Clementis de Gara (Gera) 27. sept. 1446 IE 412 78v, IE 413 78v, Q 1122 66v."@la .


:Kuriale_Institution a owl:Class ;
  rdfs:subClassOf :Kirchliche_Institution ;
  rdfs:label "Kuriale Institution"@de ;
  skos:definition "Bezeichnet eine Institution der römischen Kurie, die dauerhaft mit spezifischen Verwaltungs-, Rechts- oder Gnadenkompetenzen im Dienst des Papstes betraut ist."@de .


:Praebende a owl:Class ;
  rdfs:subClassOf :Einkuenfte ;
  :stringInRGX "prebenda"@la ;
  :stringInRG "preb."@la ;
  rdfs:label "Präbende"@de ;
  skos:definition "\"Präbende ist ein zuerst in den QQ des 8. Jh. nachweisbaerer Terminus, der damals die tägl. Zuteilung der z. Lebensunterhalt notwendigen Mittel durch den B[ischof] am einen Kanoniker (praebenda sc. pars) bezeichnete. Nach der Aufteilung der Güter der Stifte zw. B[ischöfen] u. Kanonikern bedeutete P[räbende] den auf den einzelnen Kanoniker entfallenden Anteil an Vermögen u. Einkommen. Im Dekretalenrecht wurde die P. als eine Art v. Benefizium begriffen […]. Die P[räbende] unterschied sich indes v. Benefizium durch die period. Neuverteilung der Kurien mit Zubehör u. die Einbehaltung eines Teils des Ertrags z. tägl. Zuteilung als Präsenzgelder. […]\" (Georg May, \"Präbende\", in: LThK 8, Sp. 464f.)."@de .


:Presidenza_delle_Strade_I a owl:Class ;
  rdfs:subClassOf :Kuriale_Ueberlieferungseinheit ;
  :stringInRG "Presidenza delle Strade, reg. 2"@la ;
  :bezieht_sich_auf_RG-Band "RG IX"^^xsd:string ;
  rdfs:label "Presidenza_delle_Strade (I)"@de ;
  skos:altLabel "Archivio di Stato di Roma, Achivio della Presidenza delle Strade n. 2, 151 vol."^^xsd:string ;
  skos:definition "Presidenza delle Strade bezeichnet eine kuriale Überlieferungseinheit, deren Inhalt in einem oder mehreren Einträgen des Repertorium Germanicum verarbeitet ist. Diese Serie umfasst Strafregister der römischen Presidenza delle Strade."@de .


:Schluesselwaechter a owl:Class ;
  rdfs:subClassOf :Weltliches_Amt ;
  :stringInRGX "custos conclavis"@la ;
  rdfs:label "Schlüsselwächter"@de ;
  skos:definition "Ein Schlüsselwächter (custos conclavis) ist eine Person, die für die Verwahrung der Schlüssel und die Kontrolle des Zugangs zu bestimmten abgeschlossenen Räumen zuständig ist."@de ;
  skos:example "RG IV 03988: Haubt Marscalcus de Pappenheym Sigismundi regis ac imperii generalis marscalcus ac custos conclavis de mort. artic.; alt. port.; interd.; ante diem; confess.; mort. artic. pro Clara Marscalkin moniali mon. in Zimeren o. Cist. August. dioc.; indulg. pro par. eccl. s. Galli in Pappenheim Eistet. dioc. 25 nov. 1417 S 106 298."@la .


