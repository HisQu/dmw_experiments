  rdfs:label "Personenzuschreibung"@de ;
  skos:definition "Personenzuschreibungen, die weder sozialer Stand noch Amt sind."@de .


:Rheinischer_Gulden a owl:Class ;
  rdfs:subClassOf :Gulden ;
  :stringInRG "fl. renen."@la ,
  "renen. fl."@la ;
  rdfs:label "Rheinischer Gulden"@de ,
  "florenus renensis"@la ;
  skos:definition "Eine im RG vorkommende Währungseinheit."@de .


:Dukat a owl:Class ;
  rdfs:subClassOf :Waehrung ;
  :stringInRG "adc."@la ,
  "duc. adc."@la ,
  "duc. auri"@la ;
  rdfs:label "Dukat"@de ,
  "ducatus"@la ;
  skos:definition "Eine im RG vorkommende Währungseinheit. \"Die seit 1284 in Venedig geprägte →Zechine, eine Konkurrenzmünze zum →Goldgulden von Florenz im Gewicht von ca. 3,5 g zeigt in der Nachahmung byz. Vorbilder auf der einen Seite Christus in der Mandorla, auf der anderen Seite den vor dem hl. Markus knienden Dogen und die Umschrift »Sit tibi Christe datus quem tu regis iste ducatus«. Vom letzten Wort »ducatus« der Inschrift wird nach allgemeiner Überlieferung die Bezeichnung D. abgeleitet. Der D. wurde zur langlebigsten Münze aller Zeiten. Während der Goldgulden West-, Mittel- und Nordeuropa eroberte, kursierte der D. hauptsächl. in Südosteuropa und im Orient, wo er häufig nachgeahmt wurde. Funde von D.en in Ägypten und Südindien bezeugen seine weite Verbreitung. In Europa wurde der D. seit 1325 in Ungarn geprägt; von hier aus drang er seit dem ausgehenden MA nach W vor und wurde 1559 in die Reichsmünzordnung übernommen. Zu Beginn des 17. Jh. hatte der D. den Goldgulden fast überall ersetzt.\" (P. Berghaus, \"Dukat\", in: LexMA 3, Sp. 1445)"@de .


:Aufgabe_der_Seelsorge a owl:Class ;
  rdfs:subClassOf :Aktivitaet ;
  :stringInRG "dim. quoad cur."@la ;
  rdfs:label "Aufgabe der Seelsorge"@de ;
  skos:definition "Ereignis, bei dem ein Pfründeninhaber darüber berichtet, ein Benefiz zwar grundsätzlich zu besitzen, aber die Seelsorge abgetreten zu haben."@de ;
  skos:editorialNote "Die Abkürzung \"dim. quoad cur.\" kommt so nur in RG 2 vor."@de ;
  skos:example "RG II 00255: Adam Manhart de superiori Heymbach cler. Magunt. f. gr. de benef. ad. coll. abbe. etc. mon. in Nunnenmonster Wormat. o. Cist., n. o. benef. ad coll. abb. etc. mon. Montissanctidysibodi o. Cist. d. dioc. dim. quoad cur., 14 nov. 1394 L 37 145."@la .


:Urteil a owl:Class ;
  rdfs:subClassOf :Objekt ;
  :stringInRG "sent."@la ,
  "sententia"@la ;
  rdfs:label "Urteil"@de ,
  "sententia"@la ;
  skos:definition "Urteil bezeichnet als Klasse die formelle, autoritative Entscheidung einer zuständigen Instanz. Es kann als Referenzpunkt für Gnadenerweise wie Kassation (Aufhebung) oder aggravatio (Verschärfung) dienen."@de ;
  skos:example "RG II 00950: […] m. cass. sent. in d. dioc. propter pecuniarum debita latas […]"@la ,
  "RG II 07171: […] m. aggravandi sent. contra Arnoldum Isernhod presb. Zwerin. contra quem ei sunt adiudic. can. et preb. eccl. in Oltzburg Hildesem. dioc. […]"@la .


:Klostergemeinschaft a owl:Class ;
  rdfs:subClassOf :Personengruppe ;
  :stringInRG "abb. etc."@la ,
  "prep. etc. mon."@la ;
  rdfs:label "Klostergemeinschaft"@de ;
  skos:definition "Die Klostergemeinschaft kann als Personengruppe im RG auftreten: abbas bzw. prepositus et conventus monasterii ..."@de .


:Archivium_Arcis_I a owl:Class ;
  rdfs:subClassOf :Kuriale_Ueberlieferungseinheit ;
  :stringInRG "A. A."^^xsd:string ;
  :bezieht_sich_auf_RG-Band "RG VIII"^^xsd:string ;
  rdfs:label "Archivium_Arcis (I)"@de ;
  skos:altLabel "Archivio segreto Vaticano, Archivium Arcis"^^xsd:string ;
  skos:definition "Archivium Arcis bezeichnet eine kuriale Überlieferungseinheit, deren Inhalt in einem oder mehreren Einträgen des Repertorium Germanicum verarbeitet ist. Ein Band stellt den frühen Ansatz einer Empfängerregistratur an der Kurie dar und wurde mit größeren Unterbrechungen bis 1539 fortgeführt. Weitere Bände enthalten Abschriften von Bullen, Briefen, Privilegien, Verträgen etc.."@de .


:Arzt a owl:Class ;
  rdfs:subClassOf :Beruf ;
  :stringInRGX "cirurgicus"@la ,
  "medicus"@la ,
  "phisicus"@la ;
  rdfs:label "Arzt"@de ;
  skos:definition "Im Spätmittelalter ist ein Arzt eine Person mit universitärer Ausbildung, die von Berufs wegen Kranke diagnostiziert und behandelt."@de ;
  skos:editorialNote """Vgl. G. Baader, \"Arzt\", in: LexMA  1, Sp. 1098-1101

Vgl. Manfred Stürzbecher: The physici in German-speaking countries from the Middle-Ages to the Enlightenment. In: A. Russell (Hrsg.): The Town and the State Physician in Europe from the Middle Ages to the Enlightenment. Wolfenbüttel 1981, S. 123–129.

Die Abkürzung med. findet sich nur für das Fach medicina, nicht für medicus."""@de ;
  skos:example "RG IX 00097: Albertus de Opatovo med. doct. et theol. bac. , phisicus regis Polonie de disp. ad 2 incompat. benef., Et de 2 par. eccl. ad 5 an. 16. apr. 1466 S 593 178rs."@la ,
  "RG V 01106: Conradus Everardi med. doct. et medicus Barbare Romanorum imperatricis et Hungarie ac Bohemie etc. regine de can. et preb. eccl. Alberegalien. Vesprimien. dioc. (12 m. arg. ) vac. p. ingr. mon. s. Martini de Neapuli o. Cartus. Ladislai Choff; n.o. canonn. et prebb. eccl. Agrien., eccl. Ratisbon. ac Wratislav. dioc. (!) (insimul 12 m. arg. ) [MHI II 350, p. 126] 9. oct. 1434 S 299 96v."@la ,
  "RG VIII 05440: Theobaldus Werner cirurgicus Basil. qui exnunc in fam. pape recip. litt. passus, gratis 9. iun. 1459 V 499 369v."@la .


:Augustinereremiten a owl:Class ;
  rdfs:subClassOf :Orden ;
  :stringInRG "o. fr. herem. s. Aug."@la ,
  "o. s. Aug."@la ;
  rdfs:label "Augustinereremiten"@de ;
  skos:altLabel "Augustiner"@de ;
  skos:definition "\"Die Augustinereremiten entstanden Mitte des 13. Jahrhunderts durch den Zusammenschluss mehrerer Eremitenverbände, die sich der Augustinusregel verpflichtet hatten. Die Gründung erfolgte 1244 unter Innozenz IV., 1256 wurde der Vereinigungsprozess mit der päpstlichen Bulle 'Licet ecclesiae' durch Alexander IV. abgeschlossen. Der Orden verbreitete sich rasch im gesamten christlichen Abendland. Die Augustinereremiten werden zu den Bettelorden gezählt. Entsprechend der Augustinusregel versteht sich der Orden als eine apostolische Bruderschaft, deren Ideal die Güter- und Liebesgemeinschaft im Geist evangelischer Armut ist. Sie kümmern sich vor allem um Predigt und Volksseelsorge, seit dem 17. Jahrhundert auch um die Bildung der Jugend (Gymnasien und Internate). Die größte Verbreitung erreichte der Orden Mitte des 18. Jahrhunderts.\" (https://database.factgrid.de/wiki/Item:Q143826)"@de .


:Gerichtsprozess a owl:Class ;
  rdfs:subClassOf :Aktivitaet ;
  :stringInRGX "causa"@la ,
  "lis"@la ,
  "processus"@la ;
  :stringInRG "litig."@la ,
  "proc."@la ;
  rdfs:label "Gerichtsprozess"@de ;
  skos:definition "Ein Gerichtsprozess ist ein rechtlich geregeltes Verfahren vor einem zuständigen Gericht, in dem ein Rechtsstreit zwischen zwei oder mehr Parteien geprüft und durch ein Urteil oder einen Beschluss entschieden wird."@de ;
  skos:editorialNote """Achtung: Die Bezeichnung proc. kann je nach Kontext neben Gerichtsprozess auch für Prokurator oder procedere stehen.

Da kein Verursacher im Sinne von P14 und P14.1 vorliegt, werden alle Beteilgten über P11 an das Event modelliert.

Wer den Prozess gegen wen zuerst eröffnet hat, geht aus den RG-Einträgen nicht sicher hervor. Deshalb sehen wir von einer Unterscheidung zwischen Kläger und Beklagter ab und sprechen freier von Prozessbeteiligten, zu denen darüber hinaus auch noch weitere Personen wie der Rechtsbeistand oder Prozessvorsteher zählen."""@de ;
  skos:example "RG II 06298: […] cass. processus ab Urbano VI contra eum fact. […]"@la ,
  "RG III 00015: Bertoldus Denen (Deynen) de Wildunghen lic. in decr., in iure can. lic. prov. super can. et preb. maiore ac prepos. eccl. Lubic. vac. per ob. Nicolai de Insula, collect. in dioc. Lubic., n. o. proc. de can. et preb. eccl. Herbip. ( dim. ) ac archidiac. in Ippenhouen in eccl. Herbip. ( dim. ) 7 iul. 1409 L 138 187 (cassata!)."@la ,
  "RG IV 10880: […] m. aggravandi processus contra nob. Sibrandum Lubrandi domicellum d. dioc. qui (ut quond. Edo Wemkens laicus) ipsum M. spoliari fecit […]"@la ,
  "RG V 00081: Albanus Seyfricstorffer de surrog. ad iur. Jacobi Smid ( resig. ) in par. eccl. in Otting Salzeburg. dioc. (12 m. arg., quam ipse A. possidet) sup. qua vac. p.o. Johannis Smalczl litig. contra Martinum Lienprechil 26. oct. 1437 S 341 174vs."@la ,
  "RG VI 02822: […] de commiss. ad abol. litis inter eum et exemptos in civit. et dioc. Eistet. […]"@la ,
  "RG VIII 00135: […] de advoc. et commiss. cause […]"@la .


:Baron a owl:Class ;
  rdfs:subClassOf :Sozialer_Stand ,
  :Weltliches_Amt ;
  :stringInRGX "baro"@la ;
  :stringInRG "bar."@la ;
  rdfs:label "Baron"@de ;
  skos:definition "\"[…] als Bezeichnung für den sozial herausgehobenen Angehörigen der Aristokratie, der in der Regel bes. Jurisdiktionsgewalt besitzt und in unmittelbarer lehnsrechtl. (und oft auch persönl. und verwandtschaftl.) Beziehung zum Fs.en steht. In dieser Bedeutung (bei großen Unterschieden und Nuancen im einzelnen) tritt der Begriff im HochMA in Frankreich, dem norm. England und einer Reihe weiterer Länder auf (hier z. T. unter frz. oder anglo-norm. Einfluß). […] Mit wachsender Hierarchisierung des Lehnswesens setzt eine Wandlung im Bedeutungsfeld des Begriffes B. ein. Als B.e und Baronien werden zunehmend eine Reihe bestimmter hoher Lehnsträger und Lehen bezeichnet. Diese v.a. in Frankreich erkennbare Entwicklung mündet gegen Ende des MA in die Wandlung des Terminus zu einem abgegrenzten feudalen Rang ein (vgl. bes. Abschnitt II). Zum Adelstitel geworden, findet der Begriff seit dem 16. Jh. in Deutschland Verbreitung und wird hier zum →Freiherrn in Analogie gesetzt.\" (U. Mattejiet, \"Baron (baro)\", in: LexMA 1, Sp. 1476-1477)."@de ;
  skos:editorialNote "Wenn kein Herrschaftsgebiet zum Titel genannt wird, fassen wir es als Angabe zum sozialen Stand auf; wenn ein Herrschaftsgebiet genannt wird, als Weltliches_Amt."@de ;
  skos:example "RG VI 00136: Alsso de Sterenberg baro et Matheus Slichk mil. burggravius in Egra et in Elenpogen Prag. dioc. et eorum ux. de alt. port. necnon de rem. plen. 5. apr. 1452 S 458 118r."@la .


:Korrektor a owl:Class ;
  rdfs:subClassOf :Kuriales_Amt ;
  :stringInRG "correct."@la ;
  rdfs:label "Korrektor"@de ;
  skos:definition "Ein kurialer Bediensteter, dem die Überprüfung päpstlicher Briefe oblag und der eventuelle Fehler korrigierte, bevor der Brief losgeschickt bzw, dem Petenten übergeben wurde."@de ;
  skos:editorialNote "Die Abkürzung correct. kann je nach Kontext für den Gnadenerweis \"reformatio\", d.h. einer Anpassung eines päpstlichen Briefes, oder für das kuriale Amt des Korrektors stehen."@de ,
  "Vgl. Brigide Schwarz (1974). Der corrector litterarum apostolicarum. Entwicklung des Korrektorenamtes der päpstlichen Kanzlei von Innozenz III. bis Martin V., in: QFIAB 54, S. 122-191."@de ;
  skos:example "RG V 00377: Anselmus Fabri de Breda Anselmus Fabri de Breda not. pape et litt. ap. correct. et refer., qui instituit capn. perp. in eccl. b. Marie Antwerpien. Camerac. dioc. et dotavit eam quadam confraternitate: lic. elig. confess. pro 25 confratribus 28. ian. 1447 L 431 293vs."@la .


:Deposition a owl:Class ;
  rdfs:subClassOf :Zensurstrafe ;
  rdfs:label "Deposition"@de ;
  skos:definition "\"Bezeichnung für die Absetzung eines Delinquenten im weltl. und kirchl. Bereich (oft syn. mit →Degradation), im 13. Jh. im Zuge der Fixierung des kirchl. Strafrechts kirchenrechtl. neu definiert. Spätestens seit dem →Liber Sextus (1298) galt die D. als härteste Strafe für Kleriker, die wegen krimineller (Raub, Mord, Entführung) oder geistl. Vergehen (Zölibatsbruch, Simonie) verurteilt wurden. Sie bestand aus dem Verlust von Amt und Pfründe und hatte die theoretisch lebenslängl. Haft - meist in einem Kl. - zur Folge. Doch verlor der Deponierte nicht seine klerikalen →Privilegien, zu geistl. Aufgaben wie Breviergebet war er weiterhin verpflichtet. Angesichts der Todesstrafe, die Laien bei Mord oder Raub zu erwarten hatten, waren geistl. Verbrecher gegenüber den Laien bevorzugt. Und wegen der oft milden Haft wurden viele Deponierte rückfällig. Daher forderten weltl. Instanzen häufig statt der D. die Degradation bei von Klerikern verübten kriminellen Delikten.\" (B. Schimmelpfennig, \"Deposition, 1. Absetzung eines Delinquenten\", in: LexMA 3, Sp. 708)"@de .


:Gulden a owl:Class ;
  rdfs:subClassOf :Waehrung ;
  :stringInRG "fl."@la ;
  rdfs:label "Gulden"@de ,
  "florenus"@la ;
  skos:definition "Eine im RG vorkommende Währungseinheit. \"(lat. florenus). Die 1252 in Florenz geschaffene Goldmünze im Gewicht von 3, 54 g erhielt ihren lat. Namen vom Florentiner Stadtsymbol, der Lilie (flos), auf ihrer Vorderseite; die Rückseite zeigt Johannes d. Täufer. Der G. wurde in zahlreichen Münzstätten (Italien, Frankreich, Niederlande, Deutschland, Böhmen, Ungarn) nachgeprägt und kursierte in West-, Mittel- und Nordeuropa. Erst in der Mitte des 14. Jh. wurde das Münzbild in den nachprägenden Münzstätten verändert. Durch den rhein. →Münzverein v. 1386 wurde der rhein. G. für über 100 Jahre Hauptwährungsmünze in Deutschland; an seine Seite traten seit dem Beginn des 15. Jh. die Apfelg. aus kgl. Münzstätten (Basel, Dortmund, Frankfurt, Nördlingen u. a.). Der G. wurde im Laufe der Zeit in seinem →Feingehalt zunehmend verschlechtert; die ndl. G. (→Hornsche G.) sanken seit dem Ausgang des 14. Jh. auf die Hälfte des Wertes des rhein. G. ab. Der G. scheiterte im 16. Jh. auf Grund seiner Legierung, die um 1500 etwa 17% Silber enthielt, an der Konkurrenz des →Dukaten. 1486 erhielt der G. sein Äquivalent in Gestalt des silbernen G. (→Taler).\" (P. Berghaus, \"Gulden\", in: LexMA 4, Sp. 1790-1791)"@de .


:Paepstlicher_Legat a owl:Class ;
  rdfs:subClassOf :Kuriales_Amt ;
  :stringInRGX "legatus Romanus"@la ,
  "legatus ap."@la ,
  "legatus pape"@la ,
  "sed. ap. legatus"@la ;
  rdfs:label "Päpstlicher Legat"@de ;
  skos:definition "\"Seit der Mitte des 11. Jh. beauftragten die Päpste L.en mit der Wahrung ihrer Interessen außerhalb Roms, bes. in den entfernteren Gegenden der abendländ. Christenheit. Gregor VII. betonte die Stellvertreter-Funktion schon durch die Titel »legatus Romane ecclesie«, »apostolice sedis« oder »legatus Romanus«, »apostolicus«. Der L. war dem lokalen Episkopat übergeordnet und führte den Vorsitz der Partikularsynode, richtete über Bf.e, führte →Visitationen durch und sorgte für die kirchl. Reform. Die L.en haben wesentl. zur Durchsetzung der Lehre vom →Primat beigetragen. Das Ansehen des Papsttums förderten sie auch durch ihre diplomat. Tätigkeit (Anerkennung von Kg.swahlen, Friedensstiftung) und den aus späterer Zeit bekannten Aufwand bei ihren Reisen. An wichtigen Aufgaben kamen die Vorbereitung und Leitung von Kreuzzügen sowie im →Schisma die Propaganda für den einen oder anderen der konkurrierenden Päpste hinzu. Anfangs hatten die L.en zuweilen nur den Rang eines Bf.s oder gar eines päpstl. Kaplans, doch mit zunehmender Ausschließlichkeit wurden Kard.e beauftragt. Diese waren die eigtl. »legati a latere« (entsandt »von der Seite« des Papstes), während die rangniedrigeren in den →Dekretalen und später manchmal »legati missi« hießen, meist jedoch »nuntii«. Einen dritten Typus bildete der »legatus natus«: ein Prälat mit der Vollmacht päpstl. Stellvertretung für ein ganzes Kgr., wie die Ebf.e v. Canterbury, Köln und Salzburg. Ein Sonderfall ist die Einsetzung des Gf.en →Roger I. als L.en (1098). Später beanspruchten deshalb die Kg.e v. Sizilien die Rechtsstellung geborener L.en. Eine bes. Position bekleideten auch diejenigen Kard.l.en, die während des späteren MA jeweils langjährige Aufgaben in der Verwaltung des →Kirchenstaates ausübten (vgl. päpstl. Statthalter in Bologna). →Gesandte, B. III.\" (D. Girgensohn, \"Legat, päpstlicher\", in: LexMA 5, Sp. 1795-1796)."@de ;
  skos:editorialNote "Achtung: Es kann auch ein Papstname neben der Bezeichnung legatus stehen (s. Beispiel unten: legatus Martini V.)."@de ;
  skos:example "RG V 00672: Basilea ( 1 )  concil. ecomenicum in civit. B.: congregatum, quo primum Julianus [de Cesarinis] s. Angeli diac. card. legatus Martini V. […]"@la ,
  "RG VIII 00513: Bessarion (Bis(s)arion) ep. Tusculan. card. Nicenus nunc. , sed. ap. legatus de latere ad Germanie sive Alamanie partes facult. consecr. eccl. ac mon. 1460 sine die V 475 58v."@la .


:Physik a owl:Class ;
  rdfs:subClassOf :Studienfach ;
  :stringInRGX "phisice"@la ;
  rdfs:label "Physik"@de ;
  skos:definition "Physik bezeichnet als Studienfach den gelehrten Bereich, der sich mit den allgemeinen Prinzipien der Natur befasst. \"[Sie] handelt von dem, was entstanden ist und entsteht (→Natur, nasci); Ausgangspunkt ist die - unmittelbar oder mittelbar auch der sinnl. Wahrnehmung zugängl. - Beschaffenheit der natürl. Dinge wie auch des Kosmos im Ganzen, sofern dieser in Hinblick auf seine natürl. Ursachen betrachtet wird. Die Ph. wird als Wiss. von der Natur der Philos. zugerechnet; hinsichtl. des Wiss. verständnisses überlagern sich im MA die platon.-stoische Einteilung der Philos. in Logik, Ph. und Ethik sowie die auf Aristoteles zurückgehende Einteilung in Ph., Mathematik und Theologie. […]\" (S. Donati/A. Speer, \"Physik und Naturphilosophie\", in: LexMA 6, Sp. 2111-2117)"@de ;
  skos:example "RG 3/235: Amplonius de Berka mag. in med. et art. et ad legendum phisicam in univ. studii Colon. per commun. civit. Colon. deput. disp. super lectura phisice etc. ad vitam l mart. 1414 L 172 240."@la .


:Tesoreria_Segreta_I a owl:Class ;
  rdfs:subClassOf :Fondo_Camerale_Primo_I ;
  :stringInRG "TS"^^xsd:string ;
  :bezieht_sich_auf_RG-Band "RG VI"^^xsd:string ,
  "RG VIII"^^xsd:string ;
  rdfs:label "Tesoreria_Segreta (I)"@de ;
  skos:altLabel "Archivio di Stato di Roma, Fondo Camerale I: Tesoreria Segreta"^^xsd:string ;
  skos:definition "Tesoreria Segreta bezeichnet eine kuriale Überlieferungseinheit, deren Inhalt in einem oder mehreren Einträgen des Repertorium Germanicum verarbeitet ist. Sie umfasst die Privatschatulle des Papstes, genauer gesagt die Rechnungsbücher aus dem Zeitraum von Dezember 1460 bis März 1464."@de .


:Ordenswechsel a owl:Class ;
  rdfs:subClassOf :Objekt ;
  :stringInRGX "ad d. mon. et ord. transivit"@la ;
  rdfs:label "Ordenswechsel"@de ;
  skos:definition "Übertritt von einem religiösen Orden in einen anderen; vgl. Klosterübertritt."@la ;
  skos:example "RG I 00020: […] lic. transeundi ad o. s. Aug. […]"@la ,
  "RG V 00649: fr. Bartholomeus Lombardi (Bombardi) (de Sicilia, de Regno) monach. mon. s. Galli de Mezio (Magio, Mozio, Mugra) o. s. Ben. Aquileg. dioc. de benef. Concordien. dioc. 1. apr. 41 S 372 222vs, de ref. c. express. quod prius fr. o. pred. fuit et de auct. ap. ad d. mon. et ord. transivit 7. iun. 1441 S 374 61r, L 384 310vss."@la .


:Friedhofskapelle a owl:Class ;
  rdfs:subClassOf :Kapelle ;
  :stringInRG "capel. cimit."@la ;
  rdfs:label "Friedhofskapelle"@de ;
  skos:definition "Eine Kapelle, die sich auf einem Friedhof befindet."@de ;
  skos:example "RG IV 01311: Kaltarn capella s. Wolffgangi in cripta in cimiterio par. eccl. s. Marie Trident. dioc. : de indulg. 21 mart. 1428 S 224 78r, L 279 282v."@la .


:Wahl a owl:Class ;
  rdfs:subClassOf :Objekt ;
  :stringInRGX "electio"@la ;
  :stringInRG "elect."@la ;
  rdfs:label "Wahl"@de ;
  skos:definition "Wahl bezeichnet als Klasse das Verfahren, durch das eine Person durch ein hierzu berechtigtes Gremium in ein Amt eingesetzt wird und dessen Ergebnis als Bezugspunkt für Maßnahmen wie Bestätigung oder Kassation dienen kann."@de ;
  skos:example "RG III 00003: Albertns el. Ratisbon. prov. post elect. capit. super eccl. Ratisbon. vac. per ob. Johannis 24 iul. 1409 C 1 4, Ind. 323 127."@la ,
  "RG III 00414: […] cum cass. elect. Andree Rugeleri […]"@la .


:Taxator a owl:Class ;
  rdfs:subClassOf :Kuriales_Amt ;
  :stringInRGX "taxator"@la ;
  rdfs:label "Taxator"@de ;
  skos:definition "Kammerbeamte, denen die Überprüfung der Bullentaxe oblag. \"Um die in der Kanzlei angesetzten Taxen zu überprüfen, wurden nämlich unter den Kammerbeamten drei Taxatoren ausgewählt und in die Bullarie geschickt […]\" (RG 3, S. 22*)."@de ;
  skos:example "RG VII 01570: Johannes Hof(f)man pauper cler. Herbip. dioc. Andree de Comitibus in plumbo ap. taxatoris fam.: supplic. Andrea de prerog. presencium 23 iun. 1456 S 491 178r."@la .


:Weihe_Gebaeude a owl:Class ;
  rdfs:subClassOf :Objekt ;
  :stringInRGX "consecrandi capellam"@la ;
  rdfs:label "Weihe Gebäude"@de ;
  skos:definition "Die Weihe eines Gebäudes bezeichnet den kirchlichen Akt, durch den ein Gebäude dauerhaft einem sakralen Zweck bestimmt und für den liturgischen Gebrauch geweiht wird."@de ;
  skos:example "RG II 00986: […] licentia consecrandi capellam […] de novo constructam […]"@la .


:Arch_Vat_Arm_XXXIII_vol_12_I a owl:Class ;
  rdfs:subClassOf :Armarien_I ;
  :stringInRG "C"^^xsd:string ;
  :bezieht_sich_auf_RG-Band "RG II"^^xsd:string ;
  rdfs:label "Arch._Vat._Arm. _XXXIII_vol._12 (I)"@de ;
  skos:definition "Arch. Vat. Arm.  XXXIII vol. 12 bezeichnet eine kuriale Überlieferungseinheit, deren Inhalt in einem oder mehreren Einträgen des Repertorium Germanicum verarbeitet ist. Bei diesem Band handelt es sich um ein Finanzregister der päpstlichen Kammer aus dem 14. Jahrhundert."@de .


:Koenig a owl:Class ;
  rdfs:subClassOf :Weltliches_Amt ;
  :stringInRGX "rex"@la ;
  rdfs:label "König"@de ,
  "rex"@la ;
  skos:definition "Der Regent eines Königreiches; zum dt. Königtum nach dem Investiturstreit: H. Thomas, \"König, Königtum\", in: LexMA 5, Sp. 1306-1309."@de .


:Aktivitaet a owl:Class ;
  rdfs:subClassOf :Ereignis ;
  rdfs:label "Aktivität"@de ;
  skos:definition "„Diese Klasse umfasst Handlungen, die von Instanzen von E39 Actor absichtlich ausgeführt werden und die zu Zustandsänderungen in den dokumentierten kulturellen, sozialen oder physikalischen Systemen führen. Dieser Begriff schließt sowohl komplexe, zusammengesetzte und langfristige Handlungen wie den Bau einer Siedlung oder einen Krieg als auch einfache, kurzzeitige Handlungen wie das Öffnen einer Tür ein.“ (CIDOC)"@en ;
  skos:editorialNote <http://www.cidoc-crm.org/cidoc-crm/E7_Activity> .


:Klosterflucht a owl:Class ;
  rdfs:subClassOf :Objekt ;
  :stringInRGX "apostasia"@la ,
  "mon. illicite exivit"@la ;
  rdfs:label "Klosterflucht"@de ;
  skos:definition "Klosterflucht bezeichnet im kirchenrechtlichen Kontext das unerlaubte Verlassen eines Klosters durch ein Ordensmitglied unter Verletzung der klösterlichen Verpflichtungen, insbesondere des Gehorsams und der Stabilität."@de ;
  skos:example "RG IV 00069: […] de absol. quod olim de mon. in Clingental o. s. Aug. Basil. et postea de mon. in Riintal o. Cist. illicite exivit […]"@la ,
  "RG IX 00294: […] ab apostasie reatu et excom. sent. absol. […]"@la .


:Ermahnung a owl:Class ;
  rdfs:subClassOf :Gnadenerweis ;
  :stringInRGX "monitorium"@la ,
  "monitorium penale"@la ;
  rdfs:label "Ermahnung"@de ;
  skos:definition "\"Diese Mahnung des Papstes an den Empfänger ist meist mit einer langen Narratio über die Umstände der Vergehen verbunden, die (neben allen deutschen Namen) nur in wesentlichen Punkten wiederzugeben sind. Die Fristsetzungen und angedrohten Sanktionen sind formelhaft und können übergangen werden\" (Bearbeitungshinweise, S. 68f.)"@de ;
  skos:example "RG V 07203: […] monitorium Francisci [Condulmari] camer. ap. ut restituat almarium et certas alias res Jacobino de Rubeis collect. cam. ap. in regno Polonie infra 60 dies sub pena excom. […]"@la ,
  "[…] monitorium penale contra Simonem et adherentes ut ab occupatione eccl. Reval. desistant et bona d. eccl. restit. […]"@la .


:Parament a owl:Class ;
  rdfs:subClassOf :Objekt ;
  :stringInRGX "paramenta"@la ;
  rdfs:label "Parament"@de ;
  skos:definition "Textilien, die im Kirchenraum und in der Liturgie Verwendung finden."@de ;
  skos:example "RG II 00424: Altach inferior (int. Althe) abb. etc. mon. o. s. Ben. Patav. dioc. lic. consecr. paramenta 8 ian. 1404 L 115 99."@la .


:Religioese_Laienvereinigung a owl:Class ;
  rdfs:subClassOf :Religioese_Gemeinschaft ;
  rdfs:label "Religiöse Laienvereinigung"@de ;
  skos:definition "Religiöse Laienvereinigungen bezeichnen Zusammenschlüsse von Laien, die ohne Ordensgelübde in gemeinschaftlicher Form ein religiös geprägtes Leben führen."@de .


:Kleriker a owl:Class ;
  rdfs:subClassOf :Kirchlicher_Stand ;
  rdfs:label "Kleriker"@de ;
  skos:definition "Eine Person, die eine Weihe empfangen hat und alle Personen, die mit einem kirchlichen Amt oder mit der Bezeichnung clericus aufgeführt werden."@de .


:Kommission a owl:Class ;
  rdfs:subClassOf :Gnadenerweis ,
  :Beauftragung ;
  :stringInRG "de commiss."@la ,
  "de committ."@la ;
  rdfs:label "Kommission"@de ,
  "commissio"@la ;
  skos:definition "Eine Kommission bezeichnet die Einsetzung einer Person oder eines Gremiums mit dem Auftrag, einen bestimmten Sachverhalt zu prüfen oder eine Entscheidung umzusetzen."@de ;
  skos:editorialNote """Bezieht sich auf Objekte:
- Rechtsstreit

Bezieht sich auf Gnaden:
- Dispens"""@de ;
  skos:example "RG V 00097: Albertinus (Albertus) Boqueti ( al. Laurencii) cler. Meten. dioc. de commiss. priv. Poncelleti de Villari can. et preb. eccl. Meten. (24 l. T. p. ) ob adhes. concil. Basil. post transl. et de prov. ipsi A. B. de eis 7. mart. 1446 S 409 189rs."@la ,
  "RG VII 00161: Aquen., regale op. Aquen. Dec. etc. eccl. b. Marie Leod. dioc. : de committ. in partibus unionem perp. vicar. par. eccl. in Sinzich Colon. dioc. (10 m. arg. ) vacat. p. resign. Engelberti Windenrode vic. 14 iun. 1455 S 482 12rss."@la .


:Suffragandioezese a owl:Class ;
