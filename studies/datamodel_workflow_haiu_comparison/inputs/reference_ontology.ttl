  skos:example "RG III 00064: […] disp. super def. nat. (de aep. et moniale o. s. B.) […]"@la .


:Medizin a owl:Class ;
  rdfs:subClassOf :Studienfach ;
  :stringInRG "in med."@la ;
  rdfs:label "Medizin"@de ;
  skos:altLabel "in medicina"@la ;
  skos:definition "Medizin bezeichnet als Studienfach den Bereich, der sich mit der theoretischen und praktischen Lehre von Gesundheit, Krankheit, Diagnose und Heilbehandlung des menschlichen Körpers befasst."@de ;
  skos:example "RG 4/958: Bernardus de Loen cler. Monast. in art. bac. et in med. lic. (in curia presens) de lic. faciendi in med. doctoratum in curia statutis Colon. n. o. 1 aug. 25 S 189 90r, 20 aug. 1425 S 193 49v."@la .


:Quittungsregister_I a owl:Class ;
  rdfs:subClassOf :Fondo_Camerale_Primo_I ;
  :stringInRG "Q"@la ;
  :bezieht_sich_auf_RG-Band "RG II"^^xsd:string ,
  "RG IV"^^xsd:string ,
  "RG IX"^^xsd:string ,
  "RG V"^^xsd:string ,
  "RG VIII"^^xsd:string ;
  rdfs:label "Quittungsregister (I)"@de ;
  skos:altLabel "Archivio di Stato di Roma, Fondo Camerale I, Quietanze per comuni o minuti servizi"@la ,
  "Archivio di Stato di Roma, Fondo Camerale I: Quittantiae"^^xsd:string ,
  "Archivio di Stato, Liber Quittantiarum 1"^^xsd:string ;
  skos:definition "Quittungsregister bezeichnet eine kuriale Überlieferungseinheit, deren Inhalt in einem oder mehreren Einträgen des Repertorium Germanicum verarbeitet ist. Die Register enthalten Abschriften von Quittungen des Kämmerers, des Thesaurars (Schatzmeister) sowie deren jeweiligen Stellvertreter. Diese dokumentieren die Einzahlung und Remission von Annaten sowie Taxen für Lizenzen, Fakultäten, Dispense und Ähnliches, ebenso wie Abrechnungen mit Kammerkollektoren."@de .


:Herzensmilde_Mangel a owl:Class ;
  rdfs:subClassOf :Mangel ;
  :stringInRG "def. len."@la ,
  "def. lenitatis"@la ;
  rdfs:label "Herzensmilde Mangel"@de ,
  "defectus lenitatis"@la ;
  skos:definition "Defectus lenitatis bezeichnet im kanonischen Recht einen rechtlichen Makel, der aus der Beteiligung an Gewalthandlungen oder Blutvergießen (insbesondere Tötung oder schwere Körperverletzung) resultiert und der die Ausübung bestimmter geistlicher Ämter oder Weihen hindert."@de ;
  skos:example "RG II 00411: […] disp. sup. def. len. […]"@la .


:advocatus_consistorii_et_camere_apostolice a owl:Class ;
  rdfs:subClassOf :Kuriales_Amt ;
  rdfs:label "advocatus consistorii et camere apostolice"@de ;
  skos:definition "Ein Bediensteter der apostolischen Kammer, vgl. RG 3, S. 29*."@de ;
  skos:example "RG IV 09175: Johannes Scrimp cler. Monast. de conf. can. et preb. eccl. s. Johannis Traiect. vac. p. o. Arnoldi Bruen vel res. Justini de Planta consist. advoc. cam. cler. et script., n. o. can. et preb. eccl. b. Marie Reyssen. Colon. dioc. 25 oct. 1418 S 117 81."@la ,
  "RG VIII 04563: Nicolaustit. s. Petri ad vincula presb. card. et ep. Brixin. qui p. Sigismundum Austrie ducem in castro Bruneck sue dioc. obsessus fuerat ad extorquendum castrum Taufers necnon pec. summam et plures litt. (quod instigante Michaele de Prato causarum cur. cam. ap. procur. in consistorio gener. p. Andream de Sancta Cruce utr. iur. doct. d. consistorii et fisci ap. advocatum exposita est, Johanni tit. s. Prisce presb. card. ac Johanni Atrebaten. et Dominico Torcellen. ep. causa commissa): assign. term. 1. aug. 60 ad decl. penas contra d. ducem 19. mai. 1460 V 476 236v-239r, Arm. 31.58 113r-117r."^^xsd:string .


:Reduktion a owl:Class ;
  rdfs:subClassOf :Gnadenerweis ;
  :stringInRGX "de reductione"@la ;
  rdfs:label "Reduktion"@de ,
  "reductio"@la ;
  skos:definition "Eine Reduktion bezeichnet einen Gnadenerweis, durch den eine bestehende Verpflichtung, etwa eine zu zahlende Pensionszahlung, herabgesetzt wird."@de ;
  skos:editorialNote """Bezieht sich auf Objekte:
- Rentenzahlung"""@de ;
  skos:example "Nicolaus Stertzen rect. par. eccl. s. Nicolai e. m. Wratislav. referens quod quond. Nicolao Brieger de par. eccl. s. Nicolai e. m. Wratislav. vac. p. resign. in manibus pape Johannis Steinkeller prov. et d. Johanni pens. ann. 24 fl. auri ung. p. d. Nicolaum persolv. assign. fuerat et quod ipse d. pens. ann. persolv. n. val.: de reductione d. pens. ad 3. partem veri val."@la .


:Thesaurar a owl:Class ;
  rdfs:subClassOf :Stiftsamt_Leitung ;
  :stringInRGX "custos"@la ;
  rdfs:label "Thesaurar"@de ;
  skos:altLabel "Kustos"@de ;
  skos:definition "Verantwortlich für den Kirchenschatz und den Vollzug bestimmter liturgischer Vorgänge."@de ;
  skos:editorialNote "Achtung: Verwechslungsgefahr mit Küster, Kustos_Kloster, Wächter (Weltliches_Amt)."@de ;
  skos:example "RG IV 02070: Conradus Schnetzer (Snetzer) can. et custos eccl. s. Petri Imbriacen. Constant. dioc. de fruct. in absentia 2 sept. 1420 S 146 150r."@la ,
  "RG IV 12544: Petrus Maczude de Lubscowo (Lupscowo; P. M.) acol. pape custos Poznan.: salv. cond. 6 iun 1422 V 354 90."@la .


:Hochmeister_des_Deutschen_Ritterorden a owl:Class ;
  rdfs:subClassOf :Klosteramt_Leitung ;
  :stringInRG "mag. gen."@la ;
  rdfs:label "Hochmeister des Deutschen Ritterorden"@de ,
  "magister generalis"@la ;
  skos:definition "\"An der Spitze [des Deutschen Ritterordens] stand der auf Lebenszeit gewählte Hochmeister (magister generalis [im RG: mag. gen.]), assistiert von den Inhabern der fünf zentralen Haus (d. h. Residenz-Burg)-Ämter: Großkomtur (→Komtur), oberstem →Marschall, Tressler, Trappier und Spittler.\" (H. Boockmann, \"Deutscher Ritterorden\", in: LexMA 3, Sp. 768-777)."@de ;
  skos:example "RG IV 01578: Colonia civitas mag. gen. et fr. o. P. : de indulg. pro capitulo generali Colonie celebrando; de lic. quod mag. gen. in capitulo generali Colonie celebrando valeat doctorare duos fratres abiles ut gradum suscipiant doctoralem 11 apr. 1419 S 124 21r, lic. doctorandi L 203 202r."@la ,
  "RG IV 02822: Fernandus ep. Lucen. constit. nuntius ad locum ubi conventio inter Sigismundum regem et Wladislaum Polonie regem et Alexandrum Litwanie ducem ad procurandam concordiam inter prefatos et mag. gen. et fratres hosp. b. Marie Theuton. 18 febr. 1423 V 354 186v."@la .


:Regularkanoniker a owl:Class ;
  rdfs:subClassOf :Kanoniker ;
  :stringInRG "can. reg."@la ;
  rdfs:label "Regularkanoniker"@de ,
  "canonicus regularis"@la ;
  skos:definition "\"moderner Sammelbegriff für diejenigen →Kanoniker, die sich im Zuge der →Gregorian. Reform einer über die Aachener Regel v. 816 (→Institutiones Aquisgranenses) hinausgehenden Lebensordnung unterwarfen. Der Verzicht auf persönl. Besitz, Bewahrung oder Wiederherstellung der »vita communis«, ein bescheidenerer Lebensstil auch der Gemeinschaft, ein intensiverer liturg. Dienst und anfangs oft eine eremit. Ausrichtung kennzeichnen seit Mitte des 11. Jh. verschiedene lokale Initiativen im Arelat und in Italien […], die dem Klerus insgesamt das Ideal der »vita apostolica« vorgaben und mit der →Lateransynode v.1059 auch in Rom Fuß faßten. Der so angebahnten Annäherung von »vita canonica« und »vita monastica« setzte Papst →Urban II. 1092 in seinem epochemachenden Privileg für Rottenbuch (Jaffe2 Nr. 5459) den Gedanken der Gleichwertigkeit beider Ordnungen und einer eigenen spirituellen Tradition der Kanoniker entgegen, für die Augustinus rasch zum Kronzeugen wurde (→Augustiner-Chorherren). Im Zeichen der Adaption der beiden ihm zugeschriebenen Regeltexte »Praeeptum« und »Ordo monasterii« stand die nach Hunderten zählende Welle von Stiftsgründungen im 12. Jh. und deren Formierung zu Kongregationen mit impulsgebenden Zentren, die gemeinsame Consuetudines vermittelten. Neben dem wichtigsten Verband, den →Prämonstratensern, sind u. a. die Verbände von →Marbach, →Springiersbach, →Arrouaise, St-Victor in →Paris und S. Maria in Porto (bei Ravenna) daraus erwachsen. In Dtl. erfaßte die Bewegung auch einige Domkapitel und wurde von manchen Bf.en, zumal in →Salzburg und →Halberstadt, zur planmäßigen Reorganisation von Seelsorge und kirchl. Leben genutzt. Zur Zeit ihrer Blüte brachten die R. fünf Päpste (Honorius II., Innozenz II., Lucius II., Hadrian IV., Gregor VIII.), aber auch markante Theologen wie →Manegold v. Lautenbach, →Gerho(c)h v. Reichersberg oder →Hugo v. St-Victor hervor. Die Vereinigung der nicht prämonstratens. Gemeinschaften zu einem Orden durch Papst Benedikt XII. (1339) glückte nur teilweise. Bedeutendster spätma. Reformansatz war die Windesheimer Kongregation (→Windesheim).\" (R. Schieffer, \"Regularkanoniker\", in: LexMA 7, Sp. 608)."@de ;
  skos:example "RG VIII 04732 - Paulus Buse decr. doct. , prep. eccl. s. Mauricii in Hallis can. reg. o. s. Aug. Magdeburg. dioc.de indulg. 7 an. c. lic. deput. confess. 17. decb. 1461 S 548 54rss."@la .


:Erzbischof a owl:Class ;
  rdfs:subClassOf :Bischof ;
  :stringInRG "aep."@la ,
  "aepisc."@la ;
  rdfs:label "Erzbischof"@de ,
  "archiepiscopus"@la ;
  skos:definition "Ein Bischof, der neben einem Erzbistum auch der dazugehörigen Kirchenprovinz vorsteht."@de ;
  skos:example "RG IV 00020: Adam Nicolai de Banchcow (Bantkowo) producit m. ratificationis pro oblig. Alberti aep. Gneznen. 3 nov. 1423 OC 3 54r."@la .


:Gottesdienst a owl:Class ;
  rdfs:subClassOf :Objekt ;
  :stringInRGX "celebrare"@la ,
  "celebrare div. off."@la ,
  "div. off. celebrare"@la ;
  rdfs:label "Gottesdienst"@de ;
  skos:definition "Gottesdienst bezeichnet eine Vielzahl von religiösen Handlungen, insbesondere das Beten des Stundengebets und das Feiern der heiligen Messe."@de ;
  skos:example "RG IV 00278: Aldendorff opidani Magunt. dioc.: lic. celebrandi in par. eccl. in Zoden e. m. d. op. A. durante interdicto lato in d. op. ratione questionis inter Osannam abbam., Cristinam priorissam etc. mon. s. Katherine e. m. loci Isenacen. o. Cist. et Johannem Cratz cler. sup. par. eccl. d. op. A. 3 ian. 1421 L 212 37v."@la .


:Anwaltsauftrag a owl:Class ;
  rdfs:subClassOf :Beauftragung ;
  :stringInRG "de advoc."@la ;
  rdfs:label "Anwaltsauftrag"@de ;
  skos:definition "Auftrag, eine Verteidigung vor Gericht zu übernehmen."@de ;
  skos:example "RG VIII 00135: […] de advoc. et commiss. cause […]"@la ,
  "RG VIII 00262: […] de advoc. et committ. causam in cur. tractam contra quosdam ambitiosos sup. capellis d. par. eccl. […]"@la .


:Knappe_Stand a owl:Class ;
  rdfs:subClassOf :Sozialer_Stand ;
  :stringInRGX "domicellus"@la ;
  :stringInRG "domic."@la ;
  rdfs:label "Knappe Stand"@de ;
  skos:altLabel "Junker [kurialer Ehrentitel]"@de ;
  skos:example "RG 2/24: Bertoldus d. Zorn domic. et Clara quond. Henrici Gurteler nata mul. Argent. m. exig. tertiam partem dotis ( disp. sunt sup. matrim. ) 12 iun. 1389 DC 1 96."@la .


:Kauf a owl:Class ;
  rdfs:subClassOf :Objekt ;
  :stringInRGX "emptionem"@la ;
  rdfs:label "Kauf"@de ;
  skos:definition "Kauf bezeichnet den Erwerb einer Sache durch eine Geldzahlung."@de ;
  skos:example "RG III 00638: Esszlingen hosp. paup. situm in op. Constant. dioc.: conf. emptionem pratorum ac al. bonorum in villa Diczisow Constant. dioc. ac donationem iuris patron. super par. eccl. in dicta villa ex possess. Eberhardi Burgermaister incole dicti op. factam 22 oct. 1411 L 157 113."@la .


:Acquisti_26_1_Preziosi_I a owl:Class ;
  rdfs:subClassOf :Acquisti ;
  :stringInRG "Acquisti 26/1"^^xsd:string ;
  :bezieht_sich_auf_RG-Band "RG X"^^xsd:string ;
  rdfs:label "Acquisti_26/1_(Preziosi) (I)"@de ;
  skos:altLabel "Archivio di Stato di Roma"^^xsd:string ;
  skos:definition "Acquisti 26/1 (Preziosi) bezeichnet eine kuriale Überlieferungseinheit, deren Inhalt in einem oder mehreren Einträgen des Repertorium Germanicum verarbeitet ist. Der Band enthält die gewöhnlichen Breven (Brevia communia), d. h. Routineentscheidungen der Kurie, und umfasst den Zeitraum von September 1476 bis Januar 1477."@de .


:Patron a owl:Class ;
  rdfs:subClassOf :Funktion ;
  :stringInRGX "patronus"@la ;
  :stringInRG "patr."@la ,
  "patron."@la ;
  rdfs:label "Patron"@de ;
  skos:definition "Ein Patron ist eine Person, Laie oder Kleriker, oder eine Institution, die ein kirchliches Stift gestiftet oder mit Rechten ausgestattet hat und dadurch bestimmte Schutz-, Einfluss- oder Mitbestimmungsrechte gegenüber dem Stift besitzt, vgl. Patronatsrecht."@de ;
  skos:example "RG V 08288: Sigismundus R.I. Sigismundus Romanorum, Ungarie et Boemie Rex eius curiales et curiam sequentes rex Ungarie et patronus eccl. b. Marie Alberegalis Vesprimien. dioc. […]"@la .


:servitium_commune a owl:Class ;
  rdfs:subClassOf :Servitienzahlung ;
  :stringInRG "com. serv."@la ,
  "serv. com."@la ;
  rdfs:label "servitium commune"@de ;
  skos:definition "\"Abgaben von Bf.en und Äbten, deren jährl. Einkünfte wenigstens 100 Florenen umfaßten, von ihren Erträgen des ersten Jahres. Ihre Höhe betrug unter Papst Johannes XXII. 1/3 des Jahreseinkommens, später weniger. Die eine Hälfte fiel an den Papst, die andere an die Kard.e.\" (Bäumer, Servitien, in: LexMA 7, Sp. 1795)"@de ;
  skos:editorialNote "über alle Bände"@de .


:Kassation a owl:Class ;
  rdfs:subClassOf :Gnadenerweis ;
  :stringInRGX "cassatio"@la ;
  :stringInRG "cass."@la ;
  rdfs:label "Kassation"@de ;
  skos:definition "Cassatio (von lateinisch cassare = „für nichtig erklären“, „aufheben“) bezeichnet im kirchengerichtlichen Verfahren die Aufhebung eines Urteils durch ein höheres kirchliches Gericht."@de ;
  skos:editorialNote """Bezug zu Objekten: 
- Güterentfremdung (alienatio bonorum)
- Gewohnheit (consuetudo)
- Wahl (electio)
- Interdikt
- Littera
- Mandat
- Pfründentausch (permutatio)
- Statut
- Urteil (sententia)
- Prozess (processus)
- Pension
- Bestimmung (constitutio)

Bezug zu anderen Gnadenerweisen: 
- Exemption
- Bestätigung
- Inkorporation
- Unklare_Gnade
- Absolution
- Bestätigung (confirmatio)
- einfache Provisio"""@de ;
  skos:example "RG II 02980: […] lic. cass. quaedam eccl. mai. statuta […]"@la .


:Kustos_im_Kloster a owl:Class ;
  rdfs:subClassOf :Klosteramt_Leitung ;
  :stringInRGX "custos"@la ;
  rdfs:label "Kustos im Kloster"@de ;
  skos:definition "Kustos in einem Kloster."@de ;
  skos:editorialNote "Achtung: Verwechslungsgefahr mit Küster, Thesaurer (Stift), Wächter (Weltliches_Amt)."@de ;
  skos:example "RG IV 07866: Johannes Hicmeysen (?) de Rummerskirchen (Rommerskirchen, Rummerskerkin) cler. Colon. custos eccl. mon. in Deytkirchen o. s. Ben. Colon. dioc. sup. qua litig. contra Johannem Carpentarii cler.: m. procedendi contra intrusos 8 aug. 1424 L 241 190."@la ,
  "RG IV 10260: Lubic. custos custodie o. f. m. etc.: […]"@la ,
  "RG IV 14443: Waltherus de Geroltzeck ex utr. de com. gen. custos et monach. mon. s. Petri in Wissenburg o. s. Ben. Spiren. dioc. de incorp. par. eccl. in Hoenstat Spiren. dioc. in d. custod. 17 oct. 1427 S 216 244."@la .


:Prozessausgang_zugunsten_des_Beklagten a owl:Class ;
  rdfs:subClassOf :Regulaerer_Prozessausgang ;
  rdfs:label "Prozessausgang zugunsten des Beklagten"@de ;
  skos:definition "\"Prozessausgang zugunsten des Beklagten\" bezeichnet einen regulären Prozessausgang, bei dem das Gericht die Ansprüche des Beklagten ganz oder überwiegend bestätigt."@de .


:Abtei a owl:Class ;
  rdfs:subClassOf :Kloster ;
  :stringInRGX "mon. in Claricampo o. Cist. Traiect. dioc."@la ;
  rdfs:label "Abtei"@de ;
  skos:definition "Eine Abtei ist ein Kloster, das von einem Abt oder einer Äbtissin geleitet wird."@de ;
  skos:editorialNote "Es handelt sich bei im RG genannten Klöstern immer dann um Abteien, wenn sie einen Abt haben (abb. mon.) oder direkt als Abtei (abbatia) bezeichnet werden."@de ;
  skos:example "RG IV 00073: Ayleuardus (Aylewardus) abb. mon. in Claricampo o. Cist. Traiect. dioc. solv. pro ann. 45 fl. p. Henricum Clant 25 sept. 1425 JE 383 21v."@la .


:Administrator a owl:Class ;
  rdfs:subClassOf :Kirchliches_Amt ;
  :stringInRGX "administrator"@la ;
  :stringInRG "admin."@la ;
  rdfs:label "Administrator"@de ;
  skos:definition "\"seit dem späten 13. Jh. offizielle Bezeichnung für den Verwalter eines Bm.s in Sonderfällen, meist bei rechtl. Behinderung des Bf.s zur Leitung der Diözese (→Suspension oder →Exkommunikation). Bonifatius VIII. entzog durch seine Gesetzgebung (VI0 1. 6. 42 und 1. 8. 4) dem →Metropoliten das Recht, in solchen Fällen einen Visitator zu ernennen, und reservierte die Bestellung eines A.s dem Apostol. Stuhl. Wenn nichts anderes in der Ernennungsurkunde verfügt wurde, hatte er die gleichen Rechte wie ein zum Bf. Gewählter, der bereits vom Papst bestätigt war. Er besaß wie ein Koadjutor das Recht auf Unterhalt aus den Einkünften des Bm.s. Er blieb so lange im Amt, bis die Behinderung ein Ende hatte oder ein neuer Bf. bestellt war. Im SpätMA wurde einzelnen Bf.en gegen entsprechende Provision vom Papst ein 2. (oder gar 3.) Bm. übertragen, das diese dann als A.en verwalteten. Gelegentl. führte auch der Verwalter kirchl. Vermögens die Bezeichnung A.\" (R. Weigand, \"Administrator\", in: LexMA 1, Sp. 155)."@de ;
  skos:example "RG IV 00903: […] admin. eccl. Sedun. […]"@la ,
  "RG VI 00093: [… ] ep. Constant. admin. Cur. […]"@la .


:motu_proprio a owl:Class ;
  rdfs:subClassOf :Expeditionsmodalitaet ;
  :stringInRG "motu pr."@la ,
  "motu proprio"@la ;
  rdfs:label "motu proprio"@de ;
  skos:definition """\"(vorgeblich) aus eigenem Antrieb (erlassene Verfügung des Papstes)\" (Bearbeitungshinweise, S. 27).

Drückt aus, dass ein Brief - im Gegensatz zum üblichen Reskriptionsverfahren – vom Papst selbst ausgeht; Ausdruck besonderen Wohlwollens."""@de ;
  skos:example "RG IV 00137: Albertus Varentrapp decr. doct. prov. motu proprio de can. et preb. Leod. contra Fridericum Deys aud. el. Lavant. 22 apr. 1422 S 163 10r, L 227 13v."@la ,
  "RG VII 00023: Agapitus Cincii (de Rusticis) mag., can. basilice Principis appl. de Urbe, utr. iur. doct., cap. ap. et aud. de adm. cessione motu pr. can. et preb. eccl. s. Johannis ev. Leod., quos vig. gr. expect. acc. litig. desuper contra mag. Adrianum Hee script. et fam. ap., et de reserv. ann. pens. 24 fl. adc. sup. fruct. et de revalidanda gr. expect. 19 iul. 1456 S 492 123vss."@la .


:Baronat a owl:Class ;
  rdfs:subClassOf :Ort ;
  :stringInRGX "baronatus"@la ;
  :stringInRG "baron."@la ;
  rdfs:label "Baronat"@de ;
  skos:definition "Ein Baronat, auch Baronie genannt, lat. baronatus, war im Mittelalter als freies Lehen die Besitzung eines Barons. Der Titel des jeweiligen Barons oder Freiherren war in der Regel an das Baronat gebunden. (Wiki)"@de ;
  skos:example "RG III 00333: Beydbur domus fr. ord. Herem. Colon. dioc.: m. incorp. par. eccl. in Beydburreyfercheyt Colon. dioc., super qua ius patron. Johannes bar. baron. de Reyferscheit Colon. dioc. fratribus d. donavit 2 dec. 1410 L 150 162."@la .


:Bulle a owl:Class ;
  rdfs:subClassOf :Objekt ;
  :stringInRGX "bulla"@la ;
  rdfs:label "Bulle"@de ;
  skos:definition "\"Seit dem 13. Jh. wird die Bezeichnung B. vom Siegel auf die ganze Urkunde übertragen, und zwar zunächst nur auf eine bestimmte Urkundenart, später (etwa seit dem 15. Jh.) auf alle Urkunden mit Bleisiegel; für das Siegel selbst kommt dann die Bezeichnung »plumbum« auf. Der amtl. Sprachgebrauch und die moderne wissenschaftl. Terminologie halten aber an der engen Bedeutung fest. Diese B.n im engeren Sinne stehen auf der Mitte zw. den →Privilegien, die feierlicher, und den →Litterae, die minder aufwendig als sie ausgestattet sind. […]\" (Th. Frenz, \"Bulle\", in: LexMA 2, Sp. 934-935)"@de ;
  skos:example "RG VII 01306: Johannes Bodeker (de Castronovo) perp. vic. in eccl. b. Marie Hamburg. Bremen. dioc. Georgii de Flisco ep. card. fam. bulla sup. par. eccl. in Werlte habetur Leonardo de Vernaciis merc. Florentin. in cur. 24 mart. 1456 OP 3 9r."@la .


:Resignation a owl:Class ;
  rdfs:subClassOf :Aktivitaet ;
  :stringInRG "dim."@la ,
  "res."@la ,
  "resig."@la ,
  "resign."@la ;
  rdfs:label "Resignation"@de ;
  skos:definition "Eine Person resigniert / verzichtet auf eine Pfründe oder einen Rechtsanspruch."@de ;
  skos:editorialNote "Achtung: res. kann sowohl für Resignation als auch für reservatio stehen."@de ;
  skos:example "RG III 00034: Euerhardus Lupi mag., can. eccl. b. Marie ad Gradus Colon., script. litt. ap. de resign. benef. 18 nov. 1409 Ind. 323 105v."@la ,
  "RG V 00081: Albanus Seyfricstorffer de surrog. ad iur. Jacobi Smid ( resig. ) […]"@la .


:Vollzahlung a owl:Class ;
  rdfs:subClassOf :Zahlungsmodalitaet ;
  rdfs:label "Vollzahlung"@de ;
  skos:definition "Die gesamte Summe wird beglichen."@de ;
  skos:editorialNote "Eine Zahlung ist in der Regel als vollständige Zahlung zu betrachten, es sei denn es gibt den Hinweis auf Teilzahlung (vgl. RG Bearbeitungshinweise, S. 72)"@de .


:Koenig_von_Polen a owl:Class ;
  rdfs:subClassOf :Koenig ;
  :stringInRGX "regi Polonie"@la ;
  rdfs:label "König von Polen"@de ;
  skos:definition "König von Polen bezeichnet den Regenten des Königreiches Polen."@de ;
  skos:example "RG III 00076: […] Casimiro regi Polonie […]"@la .


:Stiftsamt a owl:Class ;
  rdfs:subClassOf :Kirchliches_Amt ;
  rdfs:label "Stiftsamt"@de ;
  skos:definition "Kirchliche Ämter, die innerhalb eines Stifts bekleidet werden konnten."@de .


:Praezeptor a owl:Class ;
  rdfs:subClassOf :Klosteramt_Leitung ;
  :stringInRGX "preceptor"@la ;
  :stringInRG "precept."@la ;
  rdfs:label "Präzeptor"@de ;
  skos:definition "Vorsteher eines Antoniterklosters"@de ;
  skos:example "RG IV 03451: Gerhardus de Combres preceptor domus hosp. s. Antonii in Briga o. s. Ant. Wratislav. dioc. reservatur preceptoria in provincia Magunt. et Bisunt. 3 ian. 1419 L 205 162."@la ,
  "RG IV 12264: Petrus de Amanziaco (Amasia, Amantia) precept. domus s. Anthonii in Alzeya Magunt. dioc. de rem. plen. 13 ian. 1418 S 108 243v."@la .


:Pfruendenresignation a owl:Class ;
  rdfs:subClassOf :Objekt ;
  :stringInRGX "resignare"@la ;
  :stringInRG "resign."@la ;
  rdfs:label "Pfründenresignation"@de ,
  "resignatio"@la ;
  skos:definition "\"Gelegentlich wird die generelle Erlaubnis erteilt, Pfründen zu resignieren oder zu tauschen. Diese Erlaubnis bezieht sich auch auf die künftig zu erwerbenden Benefizien, was im Regest nicht eigens zum Ausdruck gebracht wird.\" (Bearbeitungshinweise, S. 63f.)"@de ;
  skos:example "RG I 01101: […] lic. permutandi beneficia resignandique […]"@la ,
  "RG IX 00602: Bruno Cluyt (Clayt) (de Werda) cler. Colon. dioc. Berardi tit. s. Sabine presb. card. fam. de disp. ut par. eccl. ut supra extra cur. resignare val. 28. nov. 1470 S 661 139vs."@la ,
  "RG VIII 02421: Jodocus Nusser (Musser) presb. Herbip. dioc. de adm. resign. Conradi Lutz et prov. sibi de par. eccl. s. Kiliani et soc. eius in Marckerlbach (Marckterelbach) d. dioc. (9 m. arg. ) c. reserv. pens. ann. 30 fl. renen., n. o. perp. s. c. benef. ad alt. s. Nicolai in par. eccl. s. Kiliani op. Winsenhem (Windeszhem) <d. dioc.> (3 m. ) quod possidet 12. nov. 1463 S 569 22vs., L 594 135vss."@la .


:Avignonesische_Register_I a owl:Class ;
  rdfs:subClassOf :Kuriale_Ueberlieferungseinheit ;
  :stringInRG "A"^^xsd:string ;
  :bezieht_sich_auf_RG-Band "RG I"^^xsd:string ;
  rdfs:label "Avignonesische Register (I)"@de ;
  skos:altLabel "Registra Avinionensia"@la ;
  skos:definition "Avignonesische Register bezeichnet eine kuriale Überlieferungseinheit, deren Inhalt in einem oder mehreren Einträgen des Repertorium Germanicum verarbeitet ist. Es ist zur Zeit des großen Schismas entstanden und beinhaltet hauptsächlich Kanzlei- und Bullenregister (Gratial- und Justizsachen d.h. Benefizialangelegenheiten, Dispensen und Ablässe), diese handschriftlichen Archivinventare werden von maschinenschriftlichen Indice ergänzt. Die Reihe endet im 15. Jahrhundert und wird dann vollständig vom Lateranregister ersetzt. Es ist in Pontifikate eingeteilt und besitzt innerhalb eine durchlaufende Bandzählung."@de ;
  skos:editorialNote "Nur in Band I steht \"A\" für die Avignonesischen Register. In allen anderen Bänden steht \"A\" für die Annatenregister."@de .


:Paepstlicher_Kaplan a owl:Class ;
  rdfs:subClassOf :Kuriales_Amt ;
  :stringInRG "ap. sedis capellan."@la ,
  "capellan. pape"@la ;
  rdfs:label "Päpstlicher Kaplan"@de ;
  skos:definition "Kaplan des Papstes an der Kurie"@de ;
  skos:example "RG I 00046: Albertus Haegge monach. mon. omn. SS. in Schafusa o. s. Ben. Constant. dioc. fit capellan. pape 15 nov. 1380 A 225 473 V 293 18v."@la ,
  "RG I 00049: Albertus Haubt can. Bamberg. de can. et preb., quos Ernestus de Sebeck ap. sedis. capellan. in eccl. Herbip. obtinebat S 62 70."@la .


:Weltliches_Amt a owl:Class ;
  rdfs:subClassOf :Amt ;
  rdfs:label "Weltliches Amt"@de ;
  skos:definition "Ein weltliches Amt ist eine offizielle Stellung oder Funktion, die eine Person im höfischen Kontext (Fürstenhof, Bischofshof etc.) oder als städtischer Funktionsträger (Bürgermeister, Kanzler einer städtischen Kanzlei, Zunftmeister) einnahm."@de .


:Prato_Bibl_Roncioniana_cod_I a owl:Class ;
  rdfs:subClassOf :Bestaende_aus_Prato ;
  :stringInRG "R"^^xsd:string ;
  :bezieht_sich_auf_RG-Band "RG III"^^xsd:string ;
  rdfs:label "Prato,_Bibl._Roncioniana_cod. (I)"@de ;
  skos:altLabel "Cod. Bibl. Roncioniana in Prato (Toscana)"^^xsd:string ;
  skos:definition "Prato, Bibl. Roncioniana cod. bezeichnet eine kuriale Überlieferungseinheit, deren Inhalt in einem oder mehreren Einträgen des Repertorium Germanicum verarbeitet ist. Die Serie beinhaltet hauptsächlich Abrechnungen verschiedener Bullen. Einzelne Teile gehören zu den Lektionenregistern, den Expeditionsregistern oder auch zur Serie Introitus et Exitus."@de .


:Ehehindernis a owl:Class ;
  rdfs:subClassOf :Objekt ;
  :stringInRGX "impedimento affinitatis"@la ,
  "impedimento cognationis spirit."@la ,
  "impedimento consang."@la ,
  "impedimento consang. et affin."@la ,
  "impedimento matrim."@la ;
  :stringInRG "disp. sup. matrim."@la ;
  rdfs:label "Ehehindernis"@de ;
  skos:definition """Ein Ehehindernis bezeichnet einen kirchenrechtlichen Umstand, der das Zustandekommen einer Ehe verbietet. \"Diese Dispens wird auch in der Kanzlei (häufiger jedoch in der Pönitentiarie) erteilt. Wichtig ist hier die Angabe des Verwandtschaftsgrades (Blutsverwandtschaft:
consanguinitas, Verschwägerung: affinitas, geistige Verwandtschaft: cognatio spir.)\" (RG Bearbeitungshinweise, S. 52f.)"""@de ;
  skos:example "RG I 00976: […] disp. super impedimento consang. pro matrimonio contrahendo […]"@la ,
  "RG II 01977: […] disp. sup. matrim. […]"@la ,
  "RG X ...: […] Johannes de Sonnvich […] de disp. sup. impedimento matrim. in 3. affinitatis gradu"@la ,
  "RG X...: […] Johannes Hausner […] de disp. sup. matrim. contracto, n. o. impedimento 2. gradus affinitatis quia quond. Johannes Rieder d. Margarite primus maritus fuit filius sororis patris d. Johannis H., p. breve"@la .


:Cod_Reg_Lat_I a owl:Class ;
  rdfs:subClassOf :Codices_Vaticani ;
  :stringInRG "Cod. Reg. lat."^^xsd:string ,
  "Cod. Regin. lat."^^xsd:string ;
  :bezieht_sich_auf_RG-Band "RG IX"^^xsd:string ,
  "RG VI"^^xsd:string ;
  rdfs:label "Cod._Reg._Lat. (I)"@de ;
  skos:altLabel "Bibliotheca Vaticana. Codices Reginenses Latini"^^xsd:string ;
  skos:definition "Cod. Reg. Lat. bezeichnet eine kuriale Überlieferungseinheit, deren Inhalt in einem oder mehreren Einträgen des Repertorium Germanicum verarbeitet ist. Die Sammlung umfasst diverse Abschriften kurialer Dokumente, die aus dem 16. bis 18. Jahrhundert stammen."@de ;
  skos:editorialNote """Cod. Reg. lat. (RG VI);
Cod. Regin. lat. (RG IX)"""^^xsd:string .


:Indult a owl:Class ;
  rdfs:subClassOf :Gnadenerweis ;
  :stringInRGX "indultum"@la ;
  :stringInRG "indult."@la ;
  rdfs:label "Indult"@de ;
  skos:definition "\"Indultum ist wie gratia und declaratio ein sehr weit gefasster Begriff, der, soweit nicht die oben behandelten Fälle betroffen sind, von der Kanzlei für viele unterschiedliche Gnadenerweise gebraucht wird\" (Bearbeitungshinweise, S. 57)"@de ;
  skos:editorialNote """Bezieht sich auf Objekt:
- Beichtvater"""@de ;
  skos:example "RG I 00029: Albertus ep. Tarbat. S 50 105 (petit div. indulta eligendi confessorem, providendi 2 personis de can. sub expect. preb. etc. privandi adher. Barth. beneficiis eaque aliis conferendi) 50 108 170v 61 6v. I 361122 149v. prov. 24 ian. 1379 A 219 424."@la .


:Franziskanerminoriten a owl:Class ;
  rdfs:subClassOf :Orden ;
  :stringInRG "o. fr. min."@la ;
  rdfs:label "Franziskanerminoriten"@de ;
  skos:definition "\"ein katholischer Bettelorden, der 1209 von Franz von Assisi gegründet wurde.\" (https://database.factgrid.de/wiki/Item:Q164255)"@de .


:Introitus_et_Exitus_I a owl:Class ;
  rdfs:subClassOf :Kuriale_Ueberlieferungseinheit ;
  :stringInRG "I"^^xsd:string ,
  "IE"^^xsd:string ;
  :bezieht_sich_auf_RG-Band "RG I"^^xsd:string ,
  "RG III"^^xsd:string ,
  "RG IV"^^xsd:string ,
  "RG IX"^^xsd:string ,
  "RG V"^^xsd:string ,
  "RG VI"^^xsd:string ,
  "RG VII"^^xsd:string ,
  "RG VIII"^^xsd:string ,
  "RG X"^^xsd:string ;
  rdfs:label "Introitus_et_Exitus (I)"@de ;
  skos:altLabel "Archivio Segreto Vaticano, Introitus et Exitus"@la ,
  "Introitus et Exitus"@la ;
  skos:definition "Introitus et Exitus bezeichnet eine kuriale Überlieferungseinheit, deren Inhalt in einem oder mehreren Einträgen des Repertorium Germanicum verarbeitet ist. Dabei handelt es sich um die Hauptbücher der zentralen kurialen Finanzverwaltung. Die Serie dient oft als Hilfe zur Erschließung verlorengegangener Annatenregister. Im „Introitus“-Teil wurde der Eingang der Annatengelder unter Nennung von Pfründe, Inhaber und Diözese registriert, während der „Exitus“-Teil den Ausgang der Gelder dokumentiert."@de ;
  skos:editorialNote """I (RG I); 
IE (RG III) + 
I = Cod. Bibl. Nat . Florent. XIX nr. 80
II = Cod. Bibl. Nat. Florent. XIX nr. 81
III = Cod. Bibl. Nat. Florent. XIX nr. 79;
IE (Restliche RG Bände)
In RG III einmal als \"JE\" und in RG IV über 200 \"JE\""""^^xsd:string .


:Ritter a owl:Class ;
  rdfs:subClassOf :Sozialer_Stand ;
  :stringInRGX "miles"@la ;
  :stringInRG "mil."@la ;
  rdfs:label "Ritter"@de ,
  "miles"@la ;
  skos:definition "Ritter bezeichnet einen bewaffneten Krieger von adligem Stand."@de ;
  skos:example "RG 8/4415: Nicolaus Cavileti can. Meten. p. patron. laic. < Johannem Baldoche mil. civ. Meten.> present. ad perp. capn. ad alt. s. Bartholomei in par. eccl. s. Sulpitii Meten. vac. p. resign. < Andrieti Gerardini presb.> c. reserv. eidem certam partem fruct. de abol. inhabil. et absol. a labe simonie 2. mai. 1461 S 538 294rs., V 505 130rs."@la .


:Markgraf_von_Baden a owl:Class ;
  rdfs:subClassOf :Markgraf ;
  :stringInRGX "marchio Baden."@la ,
  "marchio de Baden"@la ;
  rdfs:label "Markgraf von Baden"@de ;
  skos:definition "Markgraf Baden bezeichnet einen Markgrafen, der mit der Herrschaft über die Mark Baden betraut ist."@de ;
  skos:example "RG I 00218: Bernardus marchio de Baden m. Johanni de Basilea, ep. Lomberien. et officiali Constant., ut solvant matrimonium inter dictum B. et Margaretham de Hohenberch impedimento consang. et affin. n. o. contractum 29 dec. 1391 V 302 1 A 269 359."@la .


:Cod_Barb_Lat_I a owl:Class ;
  rdfs:subClassOf :Codices_Vaticani ;
  :stringInRG "Barb. lat."^^xsd:string ,
  "Cod. Barb. lat."^^xsd:string ;
  :bezieht_sich_auf_RG-Band "RG IX"^^xsd:string ,
  "RG VIII"^^xsd:string ,
  "RG X"^^xsd:string ;
  rdfs:label "Cod._Barb._Lat. (I)"@de ;
  skos:altLabel "Biblioteca Vaticana, Codices Barberiniani latini"@la ;
  skos:definition "Cod. Barb. Lat. bezeichnet eine kuriale Überlieferungseinheit, deren Inhalt in einem oder mehreren Einträgen des Repertorium Germanicum verarbeitet ist. Diese Bände haben einen vielfältigen Inhalt und enthalten beispielsweise Abschriften älterer Dokumente oder Kanzleibücher (Libri cancellariae)."@de ;
  skos:editorialNote """Barb. lat. (RG VIII)
Cod. Barb. lat. (RG IX, RG X)"""^^xsd:string .


:Kommissionsvermerk a owl:Class ;
  :stringInRG "commiss."@la ,
  "committ."@la ;
  rdfs:label "Kommissionsvermerk"@de ;
  skos:definition """Der Verweis darauf, dass ein Fall zur weiteren Bearbeitung an eine andere Person oder Institution weitergeleitet wird.

Eine Commissio (lat. committere = „übertragen, anvertrauen“) ist die Übertragung der Zuständigkeit an eine Person oder Institution durch eine kirchliche Autorität, z. B. durch den Bischof, Erzbischof oder den Papst.

\"Bei Commissionen werden schwierige Streitfälle, die durch die Gerichtsinstanzen bisher nicht zufriedenstellend geklärt werden konnten, in der Narratio mehr oder weniger ausführlich geschildert. Der Streitpunkt wird im Regest nur so weit referiert, dass verständlich wird, worum es geht. In der Dispositio beauftragt der Papst einen Auditor oder einen Bischof mit der Untersuchung des Falles und erteilt ihm dazu noch weitere Vollmachten (pot. citandi, pot. evocandi etc.), die im Regest unberücksichtigt bleiben. Die Dispositio wird i. d. R. sehr kurz zusammengefasst unter Angabe, wo (evtl. auch wie) der Fall entschieden werden soll\" (Bearbeitungshinweise, S. 65)"""@de ;
  skos:editorialNote "Achtung: Nicht verwechseln mit dem Gnadenerweis Bitte um \"Kommission\" (de committ./de commiss.)."@de ;
  skos:example "RG V 00061: Agnes de Bronchorst (Brouchorst) de illustri gen., can. sec. eccl. [s. Viti] Altinen. (de Elten) Traiect. dioc., in 22 an. sue et. constit., in abbam. d. eccl. el. de disp. sup. def. et. ( committ. mag. Petro de Mera prep. eccl. Embricen. [Traiect. dioc.]) 17. apr. 1443 S 391 146v."@la .


:Kellner_im_Kloster a owl:Class ;
  rdfs:subClassOf :Klosteramt_Amt ;
  :stringInRGX "cellerarius"@la ;
  rdfs:label "Kellner im Kloster"@de ;
  skos:altLabel "Kellerer"@de ;
  skos:definition "\"[…] der die Beaufsichtigung bei der Verteilung der Vorräte durchzuführen hatte\" (Wentz/Schwineköper, 1,1 S. 134)"@de ;
  skos:editorialNote "vgl. Kellner_Stift"@de ;
  skos:example "RG V 08341: Simon cellerarius et can. mon. Nuemburg. o. s. Aug. Patav. dioc. lic. elig. confess. 28. apr. 1436 L 346 276v."@la .


:Pfruendentausch a owl:Class ;
  rdfs:subClassOf :Objekt ,
  :Aktivitaet ;
  :stringInRGX "permutandi beneficia"@la ;
  :stringInRG "perm."@la ;
  rdfs:label "Pfründentausch"@de ,
  "permutatio"@la ;
  skos:definition "Pfründentausch (permutatio) bezeichnet einen thematischen Bezugspunkt, auf den sich eine Lizenz oder ein anderer Gnadenerweis bezieht, wenn der Austausch kirchlicher Pfründen zwischen Personen erlaubt wird."@de ;
  skos:example "RG I 01101: […] lic. permutandi beneficia resignandique […]"@la ,
  "RG II 03800: […] m. cass. perm. fact. cogente Wigando de Assenheim cler. Magunt. […]"@la .


:Chorherren_vom_Grossen_St_Bernhard a owl:Class ;
  rdfs:subClassOf :Augustinerchorherren ;
  :stringInRG "Montisiovis"@la ;
  rdfs:label "Chorherren vom Großen St. Bernhard"@de ;
  skos:definition "Eine Gruppe von Kanonikern, die das Schweizer Hospiz auf dem Großen St. Bernhard betreiben (vgl. Hospice of the Canons Regular of St Augustine, Col du Grand-Saint-Bernard, Switzerland, https://database.factgrid.de/wiki/Item:Q1779182)."@de .


:Kollegiatstift a owl:Class ;
  rdfs:subClassOf :Stift ;
  :stringInRGX "colleg. eccl. Wildeshusen."@la ;
  rdfs:label "Kollegiatstift"@de ;
  skos:altLabel "Kanonikerstift"@de ;
  skos:definition "Gemeinschaft von Weltgeistlichen ohne Bischofssitz; oft in Städten."@de ;
  skos:example "\"can. et preb. colleg. eccl. Wildeshusen.\": RG IV 00218: Albertus Pongen presb. Paderburn. de conf. benef. ebdomadaria nunc. in eccl. Heruord. Paderburn. dioc. vac. p. o. Arnoldi Jacobi et res. Bernardi Suringh, n. o. can. et preb. colleg. eccl. Wildeshusen., vicar. in eccl. Paderburn., in s. Dionisii et Johannis Heruord., in par. eccl. in Ryndorp Osnaburg., Paderburn. et Colon. dioc. 29 ian. 1424 S 174 119v."@la .


:Personengruppe a owl:Class ;
  rdfs:subClassOf :Akteur ;
  :stringInRGX "6000 parochiani"@la ,
  "etc."@la ;
  rdfs:label "Personengruppe"@de ;
  skos:definition "Diese Klasse umfasst alle Zusammenkünfte oder Organisationen menschlicher Individuen oder Gruppen, die kollektiv oder in ähnlicher Weise handeln, aufgrund irgendeiner Form einer verbindenden Beziehung. […] Eine Zusammenkunft von Personen wird zu einer Instanz von E74 Gruppe, wenn sie organisatorische Merkmale aufweist, die üblicherweise durch einen gemeinsamen Bestand an Ideen oder Überzeugungen oder durch gemeinsam ausgeführte Handlungen gekennzeichnet sind. Dazu können Kommunikation, die Schaffung eines gemeinsamen Artefakts oder ein gemeinsamer Zweck wie Studium, Gottesdienst, geschäftliche Tätigkeiten, Sport usw. gehören. […]. \"This class comprises any gatherings or organizations of human individuals or groups that act collectively or in a similar way due to any form of unifying relationship. […] A gathering of people becomes an instance of E74 Group when it exhibits organizational characteristics usually typified by a set of ideas or beliefs held in common, or actions performed together. These might be communication, creating some common artifact, a common purpose such as study, worship, business, sports, etc. […]\" (CIDOC)"@de ;
  skos:editorialNote <http://www.cidoc-crm.org/cidoc-crm/E74_Group> ;
  skos:example "\"6000 parochiani\": RG IX 01002: Daventria (Davantria) Proconsules et consules et commune op. D. Traiect. dioc. referentes quod d. op. adeo populosum exist. quod infra limites eccl. b. Marie ( p. secularem regi solite) quidem 8000 et infra lim. eccl. s. Nicolai ep. ( p. religiosum o. Prem. regi solite) 6000 parochiani existunt et quod ob nonnullas nundinas mercatores de diversis partibus confluunt: de indulto ut dd. eccl. p. presb. idoneos in theol. aut in altero iurium doct. vel saltem in eisdem theol. seu altero iurium lic. gubernari valeant 22. oct. 1467 S 616 16vs."@la ,
  "\"etc.\": RG IV 00361: […] de gr. ad coll. ep. etc. Brixin. […]"@la .


:Klosterkapelle a owl:Class ;
  rdfs:subClassOf :Kapelle ;
  rdfs:label "Klosterkapelle"@de ;
  skos:definition "Eine Kapelle, die sich in einem Kloster befindet."@de .


:Dispens a owl:Class ;
  rdfs:subClassOf :Gnadenerweis ;
  :stringInRGX "dispensationes"@la ;
  :stringInRG "disp."@la ;
  rdfs:label "Dispens"@de ;
  skos:definition """\"An apostolic dispensation is a special exemption granted directly by the Pope or the Holy See, allowing a deviation from a Church law or regulation in exceptional circumstances. This type of dispensation is typically reserved for significant matters, such as resolving impediments to marriage, relaxing canonical obligations, or addressing unique pastoral needs\" (Graceful17, \"apostolic_dispensation\")

\"D. bedeutete ganz allgemein die nur durch göttliches Recht und die guten Sitten beschränkte Änderung einer Norm, insbesondere eben das Gestatten einer Abweichung von dem, was an sich geboten oder verboten war, um des Erbarmens, der Notwendigkeit oder des Wohles der Kirche willen.\" (C.G. Fürst, \"Dispens\", in: LexMA 3, Sp. 1113-1114)."""@de ;
  skos:editorialNote """- disp. hat 12.400 Treffer (Bd. 1-9)
- taucht in einer kleinen Zahl auch ausgeschrieben (also nicht: disp.) auf: RG I 00063, RG I 02184, RG II 02005, RG V 01952, RG V 01996, RG IX 01031, RG IX 02888
- und noch seltener mit \"dispens.\": RG I 00219, RG I 02711 (2x)

Bezieht sich auf Objekte:
- Fastenvorschriften
- Weihe_Frist
- Besuchspflicht_Papst
- Weihaufschub
- Körperlicher_Mangel
- Mindestalter_Mangel
- Herzensmilde_Mangel
- Eheliche_Geburt_Mangel
- Ehehindernis
- Irregularität
- Inhabilität
- Pfründenhäufung
- Pfründenresignation

Andere:
- Residenzpflicht"""@de ;
  skos:example "RG VIII 00022: Adam Smol(l) de Swabach (Swobach) o. fr. herem. s. Aug. in conv. Nurenberg. Bamberg. dioc. prof., Alberti ducis Austrie cap. supplic. d. Alberto de disp. ad quodcumque benef. et de committ. Johanni ep. Eistet. ad disp. de una par. eccl. 26. iul. 1459 S 519 241v, L 544 49rs., 185rs. ( def. )."@la ,
  "RG X 2987: [...] referens quod secum sup. def. nat. (de cler. soluto ex utr. par. de nob. et mil. gen. et soluta) ut ad omnes ord. promoveri et c. c. benef. obtin. val. disp. fuit cuius vig. ad omnes min. ord. prom. fuit et vig. gr. expect. vicar. ad alt. ss. Crucis et Odalrici in eccl. s. Patrocli Susacien. Colon. dioc. in forma paup. acc. et quod deinde ad quecumque compat. benef. c. lic. perm. disp. fuit et quod sibi quod in litt. nullam de d. def. nat. mentionem facere teneretur conc. fuit et quod ipse post obtentas dd. dispensationes plures impetrationes fecit et gr. expectativas habuit quarum vig. certa benef. assec. fuit et sup. aliquibus litig. in Rota quod- que in prima disp. p. penit. expeditam express. fuit de soluto et soluta in aliis vero a papa emanatis narratum est de cler. soluto ex utr. nob. mil. gen. procreato genitus et soluta: de decl. dd. litt. perinde val. acsi in primis litt. de d. def. nat. mentio facta fuisset 26. iun. 84 S 839 162r."@la ,
  """facultas dispensandi:

RG I 00219: […] diverse fac.: concedendi 20 personis rem. plen., disp. cum 20 viris et mulier. super 4 consang. et affin. grad., necnon absolv. ab excom., disp. cum 60 personis super def. nat., absolv. 60 personas ab excom. sent., recipiendi resignationem benef. et conferendi aliis 31 aug. 1386 A 242 87-89v."""@la ,
  """prorogatio dispensationis:

RG II 03739: […] prorog. disp. sup. non prom. conc. a Wenceslao ep. Wratislav. […]"""@la .


:Kardinaldiakon a owl:Class ;
  rdfs:subClassOf :Kardinal ;
  :stringInRG "diac. card."@la ;
  rdfs:label "Kardinaldiakon"@de ;
  skos:definition "Ein Diakon, der gleichzeitig die Kardinalswürde innehat."@de .


:Nachbesserung a owl:Class ;
  rdfs:subClassOf :Gnadenerweis ;
  rdfs:label "Nachbesserung"@de ;
  skos:definition "Nachbesserung bezeichnet einen päpstlichen Gnadenakt, durch den ein bereits gewährter oder beantragter Rechtszustand nachträglich ergänzt, berichtigt oder wirksam gemacht wird."@de .


:Suspension a owl:Class ;
  rdfs:subClassOf :Zensurstrafe ;
  :stringInRGX "suspensio"@la ,
  "suspensus"@la ;
  :stringInRG "suspens."@la ;
  rdfs:label "Suspension"@de ;
  skos:definition "\"Amtsenthebung, untersagt die Ausübung der mit einem Amt verbundenen Rechte und Aufgaben, wobei Umfang und Dauer durch Gesetz oder Strafgebot, durch Urteil oder Strafverfügung festgelegt werden können. Hist. ist sie von der härteren →Deposition und →Degradation zu unterscheiden, weil sie dem Geistlichen Kirchenamt und Zugehörigkeit zum Klerus beließ. Schon früh (Can. apost. 15; Nov. 123 c. 1. 2. 10) gab es die S. vom geistl. Amt im Sinne der Enthebung von allen Amtsfunktionen (relative →Ordination). Sie wurde sowohl als Besserungs- als auch als Sühnestrafe (seit dem 8. Jh. auch als Tatstrafe) verhängt. Das Aufkommen der absoluten →Ordination und die Ausbildung und Erweiterung des →Interdikts bewirkten seit dem 12. Jh., daß die S. auf die strafweise Amtsenthebung eingeengt wurde. Erst dadurch wurde sie zu einer reinen Klerikerstrafe. Die seit dem Ende des 11. Jh. eingeführte S. ab officio et beneficio bildete durch den Verlust der Einkünfte zunächst eine Verschärfung der S. ab officio (X 2. 21. 2; X 5. 19.7), seit der Mitte der 12. Jh. ist sie eine eigene Form der S. (X 1. 6. 7, § 3). Die S. ab ordine bewirkte die strafweise Hemmung der Befugnis zur Ausübung von Weihehandlungen und kam erst gegen Ende des 12. Jh. mit der absoluten Ordination auf (X 5. 8. 1). Es gab auch partielle S.en, wie die des Pfarrbesetzungsrechtes oder der Hemmung der Ordinationsbefugnis eines Bf.s. Die S. ex informata conscientia erfolgte durch den eigenen Ordinarius bei geheimen Vergehen ohne Verfahren und Rechtsschutzgarantie. (R. Puza, \"Suspension\", in: LexMA 8, Sp. 332)."@de ;
  skos:example "RG VI 01071: [… ] abol. suspensionis de off. collectorie […]"@la .


:Weihbischof a owl:Class ;
  rdfs:subClassOf :Bischof ;
  rdfs:label "Weihbischof"@de ;
  skos:definition "\"ein →Bischof, der einem Diözesanbf. in der Ausübung der Weihegewalt zur Seite steht. Er ist →Titularbf. und als solcher für die Ausübung der iura pontificalia, also von Amtshandlungen, die liturg. Mitra und Stab verlangen und daher nur von einem konsekrierten Bf. vollzogen werden können, zuständig. […] Der W. war nicht Mitglied des Domkapitels. Die Einkünfte erhielt er vom Diözesanbf. In Köln gab es seit 1279 bzw. 1298 einen ständigen W., in Mainz deren zwei. Gemäß dem Konzil v. →Vienne (1311-12) besaß der Diözesanbf. für das W.samt das Benennungsrecht. Die Auswahl konnte sich unter Beteiligung des Domkapitels vollziehen, die Ernennung der W.e stand allein dem Papst zu.\" (R. Puza, \"Weihbischof\", in: LexMA 8, Sp. 2104)."@de ;
  skos:example "RG III 01001: Hermannus Swab ord. Herem. mag. in theol. presb. prov. super eccl. Nicopol. l sept. 1413 L 174 203."@la .


:Griechischer_Kaiser a owl:Class ;
  rdfs:subClassOf :Kaiser ;
  :stringInRG "imper. Grecorum"@la ;
  rdfs:label "Griechischer Kaiser"@de ;
  skos:definition "Der Kaiser der Griechen bezeichnet den byzantinischen Kaiser, der als Herrscher des Oströmischen Reiches in der Tradition des römischen Imperiums stand."@de ;
  skos:example "RG V 00156: […] fit mentio in litt. ad imper. Grecorum [= Epp. pont. ad concil. Florentin. II, 217, p. 113ss] […]"@la .


:Kartaeuser a owl:Class ;
  rdfs:subClassOf :Orden ;
  :stringInRG "Carthusiensibus"@la ,
  "domum Carthusien."@la ,
  "domum Cartus."@la ,
  "domum Cartusien."@la ,
  "domus Cartusien."@la ,
  "mon. Cartus."@la ,
  "ord. Cartus."@la ;
  rdfs:label "Kartäuser"@de ;
  skos:altLabel "Karthäuser"@de ;
  skos:definition "\"Der Kartäuserorden geht auf den hl. Bruno von Köln (1032–1101) zurück, der diesen strengen Reformorden 1084 in der Nähe von Chartreuse gründete. Die 1127 verfassten Konstitutionen wurden 1133 von Papst Innozenz II. († 1143) approbiert. Das Klosterleben der Kartäuser ist geprägt durch ein strenges Armuts- und Schweigegebot. Die Mönche sollten in eigenen Häusern oder Zellen alleine leben und kamen nur zu bestimmten Gebetszeiten und zu Sonn- und Feiertagen in der Gemeinschaft zusammen. Im 12. Jahrhundert breitete sich der Kartäuserorden vor allem in Frankreich aus, dann auch in den europäischen Nachbarländern. Der Orden spielte eine wichtige Rolle in der klösterlichen Reformbewegung des 11. und 12. Jahrhunderts.\" (https://database.factgrid.de/wiki/Item:Q394850)"@de .


:Regest a owl:Class ;
  rdfs:subClassOf :RG-Strukturelement ;
  rdfs:label "Regest"@de ;
  skos:definition "Als Regesten im weiteren Sinne werden alle Einträge im Repertorium Germanicum bezeichnet, auch wenn sie keinen rechtsrelevanten Inhalte zusammenfassen. Im engeren Sinne sind sie Bestandteile (Untereinträge) der sogenannten Petentenviten. In den Regesten finden sich sowohl zentrale als auch nachgeordnete Ereignisse (vgl. Object Properties: \"ist zentrales Ereignis in\" und \"ist nachgeordnetes Ereignis in\")."@de .


:Kommendatar a owl:Class ;
  rdfs:subClassOf :Kirchliches_Amt ;
  :stringInRGX "commendatarius"@la ;
  rdfs:label "Kommendatar"@de ;
  skos:definition """\"commendatarius mon.\", aber auch: \"commendatarius prepos. mon.\" oder \"perp. commendatarius hosp. sive domus\"


\"*commendatarius, -i m.
1 procurator, custos — Verwalter, Bewahrer: Dipl. Merov. III A 10 p. 127,12 (spur.) quod ... prior non sit nisi solum administrator et -us [commendatarius] locorum.
2 commendatus, cliens — Schutzbefohlener: Dipl. Otton. I. 357 p. 491,5 (interp.?) cum ... chartulariis ... et -is [commendatariis].
3 commendator — Komtur: Chart. Friburg. 283 p. 253,25 (a. 1275) frater Rodolfus ... -us [commendatarius] domus sancte Marie fratrum Theutunicorum.\" (Mittellateinisches Wörterbuch, Bd. II, Sp. 942)

kein Eintrag in RG Bearbeitungshinweisen, LexMA oder Frenz.

\"An ecclesiastic, or sometimes a layman, who holds an abbey in commendam, that is, who draws its revenues and, if an ecclesiastic, may also have some jurisdiction, but does not exercise any authority over its inner monastic discipline. Originally only vacant abbeys, or such as were temporarily without an actual superior, were given in commendam, in the latter case only until an actual superior was elected or appointed. An abbey is held in commendam, i.e. provisorily, in distinction to one held in titulum, which is a permanent benefice. […]\" (
Catholic Encyclopedia: \"Commendatory abbot\" https://www.newadvent.org/cathen/04155b.htm)"""@de ;
  skos:editorialNote "Achtung: nicht Komtur, s. Kommendator"@de ;
  skos:example "RG II 04144: Johannes aep. Gneznen. commendatarius mon. cuiusdam Quinqueeccl. dioc.: oblig. p. Vincentium Angelini Welucii vic. in eccl. s. Crucis Wratislav. 16 mai. 1401 O 57 61."@la ,
  "RG II 09290: Matheus tit. s. Ciriaci in Termis presb. card. d. Wormat. commendatarius eccl. Wormat. oblig. p. m. Arnoldi Arnoldi can. eccl. s. Martini Wormat. negotiorum gestoris 10 oct. 1408 OS 11."@la ,
  "RG IV 01444: Cristianus Cobant (Coband, Comband) o. Prem. commendatarius mon. ss. Bonifatii et Alexii Urbis et Henricus Teutonici: abscinduntur eorum arbores et vites 21 apr. 1423 DC 7 193r."@la ,
  "RG IV 01739: Conradus Ekk (Eck) presb. Ratisbon. de (Ludovico Bavarie duce pro cap. supplic. ) surrog. ad iura Ulrici olim ep. Verden. nunc Seccov. qui tamquam commendatarius sup. par. eccl. s. Georgii al. s. Martini in Amburg Ratisbon. dioc. litig. contra Conradum Auffsez, n. o. capella b. v. in colleg. eccl. b. v. Veteriscapelle Ratisbon., primariis precibus regis Romanorum ad coll. aep. Salzeburg. 16 dec. 1417 S 106 213v."@la ,
  "RG IV 02377: Dominicus de Capranica (Crapanica, D. Nicolai de C.) cler. Rom. commendatarius et administrator scolastr. eccl. Meten.: constituit procur. ad transferendum d. scolastr. Meten. in Zaninum Fabri de Ours dioc. Leod. cler. fam. suum 30 aug. 1430 DC 12 18r."@la ,
  "RG IV 06401: Johannes abb. mon. Salsen. Clun. ord. Argent. dioc. et Henricus ep. Signien. commendatarius mon. s. Vincentii in Beinwilr o. s. Ben. Basil. dioc. ac fr. Johannes Eselweg prior domus Vallis s. Margarethe in op. minori Basil. Constant. dioc. o. Cartus. ac Johannes Rich mag. civium etc. Basil.: de conf. venditionis ville Lyela Basil. ( Constant. ) dioc. facte p. mon. B. d. domui o. Cartus. et incorp. ad d. domum 28 iul. 1430 S 260 237."@la ,
  "RG IX 01472: Georgius el. Meten. commendatarius prioratus ut supra: solv. 75 fl. adc. pro annat. p. manus d. Nicolai &nbsp; 18. apr. 1466 &nbsp; FC I 1126 209r , IE 465 35v, IE 466 36v &nbsp;."@la ,
  "RG IX 01697: God(e)fridus (Giuffredus) abb. [mon.] s. Clementis [in Iborch] o.s. Ben. Osnaburg. [dioc.] el. ep. Tricalen. mon. s. Clementis in Yborch o.s. Ben. Osnaburg. dioc. commendatarius: obtulit p. Johannem Belholt dec. colleg. eccl. s. Mauritii e.m. Monast. procur. ( vig. instr. p. mag. Arnoldum Grundick cler. Osnaburg. dioc. ap. et imperiali auct. not. s.d. 3. oct. 70 subscripti) pro commun. serv. d. mon. ratione commendationis p. bullas s.d. 13. febr. 71 fact. 50 fl. adc. presentibus Matheo Sass cam. ap. not. et al. &nbsp; 26. apr. 1471 &nbsp; OC 9 205r, OS 84 136v &nbsp;."@la ,
  "RG IX 02427: Jacobus Vamberghen presb. Lubic., elemosinarius seu commendatarius elemosinarie sive commende sub invocatione ss. Jacobi, Valentini et Cristofori ad quoddam alt. versus scolam disciplinatorum in par. eccl. s. Jacobi Lubic. (14 m. monete Lubic. = 7 fl. adc. ) de disp. ad aliud benef. et de n. resid. 11. aug. 1466 S 599 13vss, ( exped. 10. ian. 67 ) L 646 186rs."@la ,
  "RG V 00848: Blasius [de Molino] patriarcha Graden. [postea Jerusalem.] regens canc. ap. commendatarius d. mon. Mosacen.: de lic. quasdam domos in op. Utini in burgo Friu d. dioc. consistentes ad d. mon. pertinentes et admodum ruinosas in emphiteosim conc. pro 10 fl. adc. quibusdam laic. ( conc. si in evidentem [usum]) 31. decb. 1435 S 317 74rs."@la ,
  "RG V 00872: Bremen Baldewinus [de Wenden] aep. Bremen. et Hermannus Wersbe sen., Johannes Hellingstede, Hugo de Schagen, Theodericus Borsen, Johannes Rode et Theodericus Bollcer can. et capit. eccl. Bremen. necnon Doneldeus Duckelis commendatarius domus s. Spiritus hosp. b. Marie Theoton. Jerusalem. ac commun. et offic. civit. Bremen.: committ. ep. Verden. ut terminet causam contra Henricum Nigeland diac. Bremen. dioc. et procur. penitentiarie propter crimina arrestatum (primum in R. cur. contra d. H. decisam) 8. oct. 1440 L 375 249vss."@la ,
  "RG VI 05066: Rodulphus [de Diepholt] ep. Traiect. commendatarius Osnaburg.: solv. 1 serv. min. (28 fl. ) oct. 1454 SM 3 111v."@la ,
  "RG VII 00731: Gerardus iun. ex Reni com. cler. Trever. dioc. de com. et bar. gen. ex utr. par. de disp. ut certam par. eccl. (quam Jacobus aep. Trever. commendatarius resign. proponit) recip. val., n. o. def. et. (17 an. ) 22 apr. 1456 S 490 22rs."@la .


:Pfruendenvergabe a owl:Class ;
  rdfs:subClassOf :Gnadenerweis ;
  rdfs:label "Pfründenvergabe"@de ,
  "provisio"@la ;
  skos:definition "\"Unter der Besetzung eines Kirchenamtes (provisio, collatio, institutio, donatio, concessio, assignatio) versteht man die vorschriftsmäßige Übertragung eines vakanten Kirchenamtes seitens des kompetenten Obern an eine taugliche Person. […] Der Besetzende macht sich der Usurpation, und wenn er Gewalt anwendet, der Invasion schuldig. Der Eingesetzte aber ist ein intrusus. Beide verfallen ipso facto der dem Papste speciali modo reservierten Exkommunikation. Endlich ist die Erlangung eines Kirchenamtes durch Erbfolge oder durch das Los strengstens verboten. Die Provision enthält drei Momente: einmal die Bezeichnung der Person, welche das Kirchenamt erhalten soll (designatio personae). […] Sodann erfolgt als zweites Moment die Übertragung des Kirchenamtes (collatio beneficii s. tituli) […] Das dritte in der Provision erhaltene Moment ist die Einweisung in den Besitz des Amtes und in den Genuß der Pfründe: institutio corporalis oder realis oder actualis, investitura, bei den Bischöfen inthronisatio, bei den Kanonikern installatio.\"(Sägmüller, Kirchenrecht I, 1914, S. 312-315)."@de ;
  skos:example "\"Fakultät für Bischöfe zur alternierenden Besetzung von Pfründen\" (Bearbeitungshinweise, S. 67): RG IX 02408: […] de alternativa videlicet fac. disponendi sup. benef. vacat. […]"@la ,
  "RG I 00219: […] diverse fac.: […] recipiendi resignationem benef. et conferendi aliis […]"@la ,
  "RG VI 02822: […] de fac. coll. 2 benef. eccles., ut liberare possit laic. in servitiis suis detentum 6. iun. 1448 S 428 114rs."@la .


:Vereinigung_unio a owl:Class ;
  rdfs:subClassOf :Gnadenerweis ;
  :stringInRGX "unio"@la ;
  rdfs:label "Vereinigung (unio)"@de ;
  skos:definition "Aufnahme einer geistlichen Institution in eine andere, aber nur für einen gewissen Zeitraum. Vgl. Incorporatio (dauerhafte Aufnahme)."@de ;
  skos:example "RG VI 05035: […] unio eccl. Rigen., que fuerat o. s. Aug., d. ord. […]"@la ,
  "RG VIII 00596: Castronovo Eccl. s. Michaelis C. : unio"@la .


:Vakanzgrund_Uebertritt a owl:Class ;
  rdfs:subClassOf :Vakanzgrund ;
  :stringInRG "vac. per transgr."@la ,
  "vac. per transl."@la ,
  "vacat. p. transgr."@la ,
  "vacat. per transgr."@la ;
  rdfs:label "Vakanzgrund Übertritt"@de ;
  skos:definition "Die Pfründe ist vakant oder wird vakant, weil der vorherige Inhaber eine andere Pfründe übernommen hat."@de ;
  skos:example "RG III 00057: Henricus de Bocholdia al. d. Foet cler. Traiect., mag. in art. bac. in decr. m. prov. super par. eccl. in Bodegrauen Traiect. dioc. vacat. per transgr. Ghiselberti de Lochorst ad decan. eccl. s. Saluatoris Traiect. 9 apr. 1410. L 138 254v."@la .


:Dominikaner a owl:Class ;
  rdfs:subClassOf :Orden ;
  :stringInRG "o. pred."@la ;
  rdfs:label "Dominikaner"@de ;
  skos:definition "\"Der Dominikanerorden ist ein vom hl. Dominikus († 1221) im Jahr 1215 in Toulouse gegründeter Orden, der sich der Augustinusregel verpflichtete. Zu den Neuerungen dieses Ordens gehörten die lebenslange Verpflichtung zum Studium der Theologie und zur Predigt. Insbesondere durch die Ausweitung des Predigtmandats auf die gesamte Christenheit trug der Orden zur einer Veränderung des kirchlichen Pastorals bei, denn bis zu diesem Zeitpunkt war das Predigeramt allein den Bischöfen vorbehalten. Ferner wurde 1220 ein striktes Besitzlosigkeitsgebot in die Konstitutionen aufgenommen. Neben der Armut wurde auch die Askese des Studiums zur Buße gezählt. Mit der Verbindung von Kontemplation und Aktion sowie Mönchtum und Priestertum wurden die Dominikaner zum Vorbild anderer Bettelorden. Zunächst ließ sich der Orden in wichtigen Städten nieder, seit der 2. Hälfte des 13. Jahrhunderts auch in kleineren. Um 1220/50 verbreitete sich der Orden stark in Italien und Frankreich, ein zweiter Ausbreitungsschub 1270/1300 führte besonders in Mittel- und Nordeuropa zur Gründung neuer Konvente. Im Zuge der Reformation verlor der Orden seine Niederlassungen in den protestantischen Gebieten, während er in den katholischen Regionen im Rahmen der Gegenreformation deutlich anwuchs. Die Säkularisation führte zum Niedergang des Ordens in Deutschland und Frankreich und in Teilen auch in Italien.\" (https://database.factgrid.de/wiki/Item:Q164200)"@de .


:Gruendung a owl:Class ;
  rdfs:subClassOf :Objekt ;
  rdfs:label "Gründung"@de ;
  skos:definition "Gründung bezeichnet im Kontext des Repertorium Germanicum den Vorgang der erstmaligen rechtlichen oder institutionellen Errichtung einer Einrichtung, der in der Regel der Genehmigung oder Bestätigung durch eine zuständige Autorität bedarf."@de .


:Botschafter a owl:Class ;
  rdfs:subClassOf :Funktion ;
  :stringInRG "ambassiator"@la ;
  rdfs:label "Botschafter"@de ;
  skos:definition "Eine mit einer politischen Mission betraute Person."@de ;
  skos:example "RG IV 01307: Busso de Vicedominis miles ambassiator Wilhelmi lantgravii Thuringie ac marchionis Misnen."@la .


:Schutzbrief a owl:Class ;
  rdfs:subClassOf :Gnadenerweis ;
  :stringInRGX "littera passus"@la ,
  "salvus conductus"@la ;
  :stringInRG "conserv."@la ,
  "litt. passus"@la ,
  "salv. cond."@la ;
  rdfs:label "Schutzbrief"@de ;
  skos:definition "\"Bei der littera conservatoria bonorum handelt es sich um einen allgemeinen Schutzbrief für Kirchen und Klöster. Es heißt im Regest nur: de conserv.\" (Bearbeitungshinweise, S. 64). \"Kapitel und einzelne kirchliche Personen ließen sich sogenannte litterae conservatoriae ausstellen. Durch sie wurden Konservatoren bestellt, d.h. Männer mit gerichtlichen Vollmachten, die Gegner des zu Schützenden vor sich fordern und ihm Recht schaffen konnten.\" (RG 2, S. 39)."@de ;
  skos:editorialNote """Bezieht sich auf Objekte:
- Reise (salvus conductus; littera passus)
- Güter (littera conserv. bonorum)
- (de conserv. […])"""@de ;
  skos:example "RG II 00266: Adilheydis de Lossow abba etc. mon. e. m. Gubin o. Cist. Misnen. dioc. m. conserv. privil. 13 dec. 1400 L 85 255v."@la ,
  "RG II 00275: Admont abb. etc.: conserv. 13 nov. 1398 L 68 23."@la ,
  "RG II 08872: Gerlacus Florentii fam. et littera passus 13 mai. 1409 V 337 85."@la ,
  "RG IV 00530: Anselmus olim ep. August.: de conserv. ne iudicio laicali in op. Ulme respondere cogatur […]"@la ,
  "RG V 00353: Andreas filius magnifici mil. dom. Czeschkovis de Iambiniza (Dambnizc) nob. vir, cler. Gneznen. dioc., fam. Francisci [Condulmari] card. et camerarii pape salvus conductus c. 3 fam. 5. iul. 1435 DC 19 105v."@la ,
  "RG VI 00060: Albertinus Boqueti et Theodericus Frudichem (Frundeke) cursores et fam. pape litt. passus ad partes Italie 13. ian. 1450 V 410 287v."@la ,
  "[…] de n. evocando et de conserv. presertim contra iudices in Vestphalia et Colon. dioc. c. derog. constit. Bonifacii VIII. et concil. gener. de 2 dietis […]"@la .


:Vakanzgrund_Ordenseintritt a owl:Class ;
  rdfs:subClassOf :Vakanzgrund ;
  :stringInRG "vac. p. ingr."@la ,
  "vacat. p. ingr."@la ;
  rdfs:label "Vakanzgrund Ordenseintritt"@de ;
  skos:definition "Die Pfründe ist vakant, weil der vorherige Inhaber einem Orden beitritt  (vgl. RG Bearbeitungshinweise, S. 45)."@de ;
  skos:example "RG IV 00080: Alardus de Grembosch (Gremsbosch, Grambosch) cler. Leod. de vicar. ad alt. s. N. in eccl. b. Marie e. m. Wesalien. Trever. dioc. vac. p. ingr. rel. Michaelis Layrbecher de Wesalia, n. o. lite sup. par. eccl. in Speel Colon. dioc., vicar. ad alt. s. Ypoliti in eccl. XI mil. virg. Colon. 15 dec. 1421 S 158 269v."@la ,
  "RG V 00789: Bertoldus Echter cler. Magunt. dioc. ex utr. de mil. gen. de can. et preb. eccl. Magunt. (14 m. arg. ) vacat. p. ingr. domus o. Cartus. [e.m. Magunt.] Marquardi Prumheym; n.o. can. et preb. eccl. ss. Petri et Alexandri Aschaffinburgen. d. dioc. (12 m. arg. ) 6. aug. 1437 S 338 174vs."@la .


:Paepstlicher_Bote a owl:Class ;
  rdfs:subClassOf :Kuriales_Amt ;
  :stringInRGX "nuntius ap."@la ,
  "nuntius ap. sed."@la ,
  "nuntius pape"@la ;
  rdfs:label "Päpstlicher Bote"@de ;
  skos:definition "\"[…] Diese waren die eigtl. »legati a latere« (entsandt »von der Seite« des Papstes), während die rangniedrigeren in den →Dekretalen und später manchmal »legati missi« hießen, meist jedoch »nuntii«. […]\"  (D. Girgensohn, \"Legat, päpstlicher\", in: LexMA 5, Sp. 1795-1796)."@de ;
  skos:example "RG III 00102: Ludouicus de Baro tit. XII. apl. presb. card. fit nuntius ap. cum pot. legati a latere ad partes Francie in Remen. Senon. Rothomag. Turon. Trever. provin., Lingon. et Leod. dioc., Lugdun, et Colon. provin. 11 iul. 1409 Ind. 323 145."@la .


:Secretaria_Camerae_I a owl:Class ;
  rdfs:subClassOf :Kuriale_Ueberlieferungseinheit ;
  :stringInRG "Sec. Cam."@la ;
  :bezieht_sich_auf_RG-Band "RG IX"^^xsd:string ,
  "RG X"^^xsd:string ;
  rdfs:label "Secretaria_Camerae (I)"@de ;
  skos:altLabel "Archivio Segreto Vaticano, Camera Apostolica, Secretacia Camerae"^^xsd:string ;
  skos:definition "Secretaria_Camerae bezeichnet eine kuriale Überlieferungseinheit, deren Inhalt in einem oder mehreren Einträgen des Repertorium Germanicum verarbeitet ist. Diese Serie umfasst Abrechnungen über die Einnahmen aus dem Ablasswesen."@de .


:declaratio_litteras_perinde_valere a owl:Class ;
  rdfs:subClassOf :Nachbesserung ;
  :stringInRG "perinde val."@la ,
  "perinde valere"@la ;
  rdfs:label "declaratio litteras perinde valere"@de ;
  skos:definition "\"Das Formular perinde valere kommt vor, wenn eine früher ausgestellte Bulle, die aufgrund von Formfehlern als ungültig angesehen werden muss oder aufgrund einer neuen Entwicklung nicht mehr ganz gefällt, aufrechterhalten werden soll. Das Formular kommt meistens im Zusammenhang mit gr. expect. vor.\" (Bearbeitungshinweise, S. 54)"@de ;
  skos:example "RG V 00015: Adam de Papenhoven cler. Leod. dioc., qui vig. prov. Juliani [de Cesarinis] card. s. Angeli legati par. eccl. de Achel quarta capel. nunc. Leod. dioc. (20 m. arg. ) vac. p.o. Gob(b)elini de Papenhoven assec. est can. eccl. s. Pauli Leod., sigillifer Johannis [de Heinsberg] ep. Leod.: motu pr. de perinde valere gr. expect. s.d. 11. mart. 37 ad can. c. reserv. preb. etc. eccl. s. Servatii Traiect. Leod. dioc. et ad benef. ad coll. ep. Leod. ac si tunc sigillifer d. ep. fuisset 4. iun. 1440 S 371 245rs."@la .


:Kuriensekretaer a owl:Class ;
  rdfs:subClassOf :Kuriales_Amt ;
  :stringInRGX "secretarius"@la ;
  :stringInRG "secr."@la ;
  rdfs:label "Kuriensekretär"@de ;
  skos:definition "\"Für geheimzuhaltende Schreiben bedienten sich die Päpste einzelner vertrauenswürdiger →Abbreviatoren und →Skriptoren, die von der Mitte des 14. Jh. an namentl. faßbar werden. Sie expedierten diese Schreiben als →litterae clausae, →Sekretbriefe und bes. →Breven und führten bald auch eigene Register. Ihre Besoldung wurde durch die »expeditio per cancellariam« der S.e und die »expeditio per cameram« sichergestellt (→Kanzlei, B); ferner wurde die den S.en vorbehaltene Urkk.art des Breve im Laufe des 15. Jh. auch für gewöhnl. Urkk. verwendet, wodurch den S.en auch hieraus Taxeinnahmen zuflossen. Der Kanzleivermerk der S.e ist ihre Unterschrift rechts unter der Plica bzw. rechts unter dem Text. Bedeutung erlangte das Amt nicht zuletzt dadurch, daß es zahlreiche berühmte Humanisten innehatten (z. B. Leonardo Bruni, Antonio →Loschi, Domenico Capranica, →Poggio Bracciolini, Flavio →Biondo, Giovanni →Aurispa, Giacomo →Ammanati Piccolomini). Übermäßige Verleihung machte das Amt jedoch bald zu einer Ehrenstelle, während die tatsächl. Arbeit wenigen »secretarii participantes« (seit Calixt III.), dann sogar nur noch einem »secretarius domesticus« oder »secretarius secretus« (seit Paul II.) oblag. 1487 errichtete Innozenz VIII. ein 30köpfiges Vakabilistenkolleg der »secretarii apostolici«; die Funktion des secretarius domesticus bestand daneben weiter und wandelte sich über mehrere Zwischenstufen zum modernen Staatssekretariat. - Zum S. (notaire - sécrétaire) im Kgr. Frankreich →Notar, B.II.\" (Th. Frenz, \"Sekretär\", in: LexMA 7, Sp. 1723-1724)."@de ;
  skos:editorialNote "Achtung: Die Bezeichnungen secr. und secretarius können sich je nach Kontext auf den Kuriensekretär (secr. pape) oder auf andere Sekretäre beziehen, z.B. von Königen oder Bischöfen (secr. regis o. Ä.), vgl. Weltliches_Amt."@de ;
  skos:example "RG I 01491: Hugo de Arena secretarius et abbreviator pape de par. eccl. de Waudrichen Traiect. dioc. S 61 70."@la ,
  "RG V 00672: Basilea oratores et nuntii, presidentes in concilio: Cristoforus Garatonus secr. pape missus Basileam: assign. 100 fl. pro expensis 27. febr. 1435 M 828 21v."@la .


:Jubilaeumsablass a owl:Class ;
  rdfs:subClassOf :Ablass ;
  :stringInRG "indulg. iubilei"@la ;
  rdfs:label "Jubiläumsablass"@de .


:Barbier a owl:Class ;
  rdfs:subClassOf :Beruf ;
  :stringInRGX "barbitonsor"@la ;
  rdfs:label "Barbier"@de ;
  skos:definition "\"[Der Barbier] (lat. barbator, barbitonsor, barbarius, dt. [Bart]-scherer) nahm im MA die Aufgaben des Friseurs (→Haartracht), des Arztes, Chirurgen (→Chirurg, Chirurgie), Zahnarztes (→Zahnheilkunde) und in gewissem Maß des Apothekers wahr. Das Aderlassen (→Aderlaß) gehörte zu seinen Haupttätigkeiten - daher in manchen Gegenden die Bezeichnung Lesser.\" (LexMA 1, Sp. 1444)"@de ;
  skos:example "RG IV 00017: Adam de Juliaco laicus Colon. salv. cond. (interfuit homicidio p. Nicolaum de Spira barbitonsorem in personam Johannis de Parka commisso et vulneratus exstitit tamquam sedator) 20 nov. 1430 DC 13 130v."@la .


:Ad_instar_Ablass a owl:Class ;
  rdfs:subClassOf :Ablass ;
  :stringInRG "indulg. ad instar"@la ;
  rdfs:label "Ad instar Ablass"@de ;
  skos:definition "Wer einen Ablass „ad instar“ der Kirche X erhält, bekommt unter denselben Bedingungen denselben Ablass wie in Kirche X – nur auf einen anderen Ort, Altar, Bruderschaft o.Ä. übertragen."@de .


:Florenz_II_III_256_I a owl:Class ;
  rdfs:subClassOf :Bestaende_aus_Florenz ;
  :stringInRG "Florenz II. III. 256"^^xsd:string ;
  :bezieht_sich_auf_RG-Band "RG X"^^xsd:string ;
  rdfs:label "Florenz_II._III._256 (I)"@de ;
  skos:altLabel "Florenz, Biblioteca Nazionale. Ms."^^xsd:string ;
  skos:definition "Florenz II. III. 256 bezeichnet eine kuriale Überlieferungseinheit, deren Inhalt in einem oder mehreren Einträgen des Repertorium Germanicum verarbeitet ist. Der Band enthält ein Brevenregister der Kurie aus dem Zeitraum von August 1481 bis August 1482. Er wird zu den Armarien zugeordnet und heute in der Nationalbibliothek Florenz aufbewahrt."@de .


:Aebtissin a owl:Class ;
  rdfs:subClassOf :Klosteramt_Leitung ;
  :stringInRG "abba."@la ,
  "abbam."@la ,
  "abbat."@la ,
  "abbatissa"@la ;
  rdfs:label "Äbtissin"@de ;
  skos:definition "Vorsteherin eines Klosters."@de ;
  skos:editorialNote "Im RG steht abbat. meist für Abtei, manchmal aber auch für die Äbtissin oder ihr Amt."@de ;
  skos:example "RG IV 00062: Agnes abba. mon. s. Stephani o. s. Aug. August. liberatur a visit. liminum 16 iun. l9 DC 5 97v."@la .


:Studienfach a owl:Class ;
  rdfs:subClassOf owl:Thing ;
  rdfs:label "Studienfach"@de ;
  skos:definition "Ein Studienfach ist ein klar abgegrenztes akademisches Wissens- und Lehrgebiet, das an einer Universität im Rahmen eines Studiums systematisch vermittelt wird."@de .


:Rotanotar a owl:Class ;
  rdfs:subClassOf :Kuriennotar ;
  rdfs:label "Rotanotar"@de ;
  skos:definition "\"von denen jeweils vier bei einem der zwölf Rotaauditoren Dienst tun\" (Thomas Frenz \"Notarius\", in: LexMA, Verlag J.B. Metzler, Vol. 6, cols 1275-1276)"@de .


:Zahlungsmodalitaet a owl:Class ;
  rdfs:subClassOf owl:Thing ;
  rdfs:label "Zahlungsmodalität"@de ;
  skos:definition "Art der Bezahlung einer Geldzahlung."@de .


:Laie a owl:Class ;
  rdfs:subClassOf :Kirchlicher_Stand ;
  :stringInRGX "laicus"@la ;
  :stringInRG "laic."@la ;
  rdfs:label "Laie"@de ;
  skos:definition "Neben den direkt als Laien bezeichneten Personen fallen alle in diese Kategorie, die keinen kirchlichen Weihegrad besitzen."@de .


:Codices_Vaticani a owl:Class ;
  rdfs:subClassOf :Kuriale_Ueberlieferungseinheit ;
  rdfs:label "Codices_Vaticani"@de .


:Kuriales_Amt a owl:Class ;
  rdfs:subClassOf :Amt ;
  rdfs:label "Kuriales Amt"@de ;
  skos:definition "Ein kuriales Amt ist eine offizielle Stellung oder Funktion, die eine Person an der römischen Kurie einnahm."@de .


:Weihe_Aufschub a owl:Class ;
  rdfs:subClassOf :Objekt ;
  :stringInRGX "de non promovendo"@la ;
  :stringInRG "de n. prom."@la ,
  "super receptione ordinis"@la ;
  rdfs:label "Weihe Aufschub"@de ;
  skos:definition "Sondererlaubnis, eine Weihe, die eigentlich innerhalb einer gewissen Zeit empfangen werden muss, aufzuschieben."@de ;
  skos:example "RG I 00782: […] cum disp. de non promovendo ad sacros ordines […]"@la ,
  "RG I 01071: [...] disp. super receptione ordinis presb. ad. biennium ratione dicte eccl. […]"@la ,
  "RG V 00013: […] de n. prom. ad 7 an. in stud. […]"@la .


:Kammer_zahlt_Geld_an_Person a owl:Class ;
  rdfs:subClassOf :Geldzahlung ;
  rdfs:label "Kammer zahlt Geld an Person"@de ;
  skos:definition "Kammer zahlt Geld an Person bezeichnet im Kontext der Zahlungsanlässe einen Vorgang, bei dem die päpstliche Kammer stellvertretend für den Papst einem namentlich genannten Petenten Geld zuweist oder auszahlt (assignatio, receptio), wobei Kammer und Papst in der Quelle häufig nur implizit erscheinen."@de .


:Feststehender_Altar a owl:Class ;
  rdfs:subClassOf :Altar_Objekt ;
  :stringInRGX "altare"@la ;
  rdfs:label "Feststehender_Altar"@de ;
  skos:definition "Der Altar bezeichnet u.a. den geweihten Tisch in einer Kirche, auf dem die Eucharistie gefeiert wird. Er ist Zentrum der Liturgie und oft mit dem Patrozinium verbunden. In großen Kirchen gibt es oft mehrere Altäre (Haupt- und Nebenaltäre)."@de ;
  skos:example "RG V 06590: Martinus Panndorfer domic. Patav. dioc. lic. destruendi altare vetus et erigendi in alio loco in capel. domus sue 11. mai. 1440 L 368 98r."@la .


:Altarist a owl:Class ;
  rdfs:subClassOf :Kirchliches_Amt ;
  :stringInRGX "altarista"@la ;
  :stringInRG "rect. alt."@la ;
  rdfs:label "Altarist"@de ;
  skos:definition "Inhaber einer Altarpfründe, die keine Vikariatspfründe ist; davon zu unterscheiden wären bloße Hilfsgeistliche."@de ;
  skos:example "RG IV 00825: Bartholmeus Burgower […] cler. Constant. altarista alt. gloriose virg. Marie apud s. sepulcrum eccl. Constant. […]"@la .


:Scholaster a owl:Class ;
  rdfs:subClassOf :Stiftsamt_Leitung ;
  :stringInRG "scol."@la ,
  "scolast."@la ,
  "scolastr."@la ;
  rdfs:label "Scholaster"@de ,
  "scholasticus"@la ;
  skos:definition """\"Dem Scholaster, dessen Amt sicher schon bei Gründung des Domkapitels errichtet worden ist, kam ursprünglich die wissenschaftliche Ausbildung der angehenden Domherren und wahrscheinlich auch von jungen Adligen zu.\" (Wentz/Schwineköper, 1,1, S. 143)

\"[…] Der S. (Scholastes) war an den Kathedralkapiteln (→Kapitel, I) derjenige Kleriker (in der Regel ein Kanoniker), der den Schulbetrieb (→Domschule) verantwortlich leitete und häufig auch selbst unterrichtete. Der S. erteilte die \"licentia docendi\", ernannte und kontrollierte die →Magister und übte Jurisdiktion über die Schüler aus. Er wurde auch als \"magister scholarum\" oder \"caput scholae\" bezeichnet. In einigen Fällen vermischte sich die Funktion des S. mit derjenigen des Kanzlers und Praecantors. […]\" (J. Verger, \"Scholasticus\", in: LexMA 7, Sp. 1520-1521)."""@de ;
  skos:editorialNote "Achtung: scol. steht nur selten für Scholaster, meist für Scholar/Schüler."@de ;
  skos:example "RG II 00361: Albertus Jastrabetz scolast. Gneznen. alt. port. 31 iul. 1394 L 34 217v."@la ,
  "RG IV 00213:  Albertus Ozen (Osen) cler. Paderburn. de scolastr. eccl. s. Stephani Magunt. vac. p. res. Johannis de Selheym qui collect. fuit 13 mart. 1422 S 161 262v."@la .


:Statut_Stift a owl:Class ;
  rdfs:subClassOf :Statut ;
  :stringInRGX "statutis in fund. d. prepos."@la ;
  rdfs:label "Statut Stift"@de ;
  skos:definition "Statut_Stift bezeichnet im RG den Bezug auf meist nicht weiter ausgeführte Statuten eines Stifts."@de ;
  skos:example "RG IV 12827: Poznan capit.: ref. sup. statutis […]"@la ,
  "RG IX 05803: […] prep. eccl. s. Pancratii Leyden. Traiect. dioc., can. eccl. Traiect.: de disp. ut unac. d. prepos. dignitatem in eccl. Traiect. recip. valeat, n.o. statutis in fund. d. prepos. […]"@la .


:Teilablass a owl:Class ;
  rdfs:subClassOf :Ablassart ;
  rdfs:label "Teilablass"@de .


:Suffraganbischof a owl:Class ;
  rdfs:subClassOf :Bischof ;
  :stringInRGX "suffraganeus"@la ;
  :stringInRG "suffrag."@la ;
  rdfs:label "Suffraganbischof"@de ;
  skos:definition "Unter einem Metropoliten/ Erzbischof stehender Bischof, Hilfsbischof/ Weihbischof"@de ;
  skos:example "Theodericus aep. Colon. ac suffrag.: imponitur summa 6 mil. fl. pro Petro s. Angli card. ad orientem pro unione Grecorum ituro 21 aug. 1420 V 353 19."@la .


:Registerschreiber a owl:Class ;
  rdfs:subClassOf :Kurienskriptor ;
  rdfs:label "Registerschreiber"@de ;
  skos:definition "Eine Unterart von kurialen Schreibern, die die Registratoren unterstützten, siehe Registrator und Registeramt."@de .


:Supplikenregister_I a owl:Class ;
  rdfs:subClassOf :Kuriale_Ueberlieferungseinheit ;
  :stringInRG "S"@la ;
  :bezieht_sich_auf_RG-Band "RG I"^^xsd:string ,
  "RG II"^^xsd:string ,
  "RG IV"^^xsd:string ,
  "RG IX"^^xsd:string ,
  "RG V"^^xsd:string ,
  "RG VI"^^xsd:string ,
  "RG VII"^^xsd:string ,
  "RG VIII"^^xsd:string ,
  "RG X"^^xsd:string ;
  rdfs:label "Supplikenregister (I)"@de ;
  skos:altLabel "Archivio Segreto Vaticano, Registra Supplicationum"@la ,
  "Archivio Segreto Vaticano, Registri delle Suppliche"^^xsd:string ,
  "Reg. Suppl. 44-76"^^xsd:string ;
  skos:definition "Supplikenregister bezeichnet eine kuriale Überlieferungseinheit, deren Inhalt in einem oder mehreren Einträgen des Repertorium Germanicum verarbeitet ist. Die Serie beinhaltet an den Papst gerichtete und von ihm genehmigte Suppliken (Bittschriften), die als Grundlage für die spätere Ausfertigung einer Bulle dienten. Sie bilden eine eigene Serie, die eng mit den Vatikanischen, Avignonesischen oder Lateranregistern verknüpft ist."@de .


:Quellenbeleg a owl:Class ;
  rdfs:subClassOf owl:Thing ;
  :stringInRGX "27. oct. 1445 S 408 31r"@la ;
  rdfs:label "Quellenbeleg"@de ;
  skos:definition "Quellenbelege sind Nachweise für die den RG-Strukturelementen dargelegten Informationen. Sie beinhalten die Angabe der Fundstelle und ein dazugehöriges Datum, ggf. auch den Zusatz exped. (= ausgestellt am)."@de .


:Stiftskirche a owl:Class ;
  rdfs:subClassOf :Kirche ;
  :stringInRGX "eccl. colleg. s. Clementis in Wisschel"@la ;
  rdfs:label "Stiftskirche"@de ;
  skos:definition "Eine Stiftskirche ist die Hauptkirche eines kirchlichen Stifts, in der das Stiftskapitel regelmäßig Gottesdienst feiert und seine liturgischen Aufgaben wahrnimmt."@de ;
  skos:example "RG IV 00040: […] de transl. eccl. colleg. s. Clementis in Wisschel ad op. Calcar et colleg. eccl. s. Martini in Seeflit ad op. Crauenborch et de unione c. par. eccl. dd. op. et erectione in eccl. colleg. […]"@la ,
  "RG V 01758: Ernestus Aurifaber Ernestus Aurifaber can. eccl. Magdeburg., <thesaur. eccl. Hildesem.>, licent. in decr., qui R. cur. p. 16 an. secutus est: de disp. ut prepos. eccl. b. Marie Halberstad. unac. thesaur. eccl. Hildesem. et alio benef. incompat. retin. val. ad vitam 16. apr. 38 S 347 175rs, 5. mai. 38 S 349 49rs, 27. mai. 38 S 348 273vs, de ref. 16. iul. 1438 S 349 295v."@la .


:Paepstliche_Littera a owl:Class ;
  rdfs:subClassOf :Objekt ;
  :stringInRGX "littera"@la ;
  :stringInRG "litt."@la ;
  rdfs:label "Päpstliche Littera"@de ;
  skos:definition "Das Schriftstück, das einem Petenten ausgehändigt wird, nachdem die Supplik bewilligt worden ist, vgl. Gnadenerweise (littera declaratoria, testimonialis, conservatoria etc.)."@de ;
  skos:example "RG II 01102: […] cass. litteras de translatione eccl. Verden. ad op. Lunenburg. et ad par. eccl. s. Johannis in op. Lunenburg. […]"@la ,
  "RG II 05006: […] cass. litt. de restit. Johannis in vicar. par. eccl. s. Viti […]"@la .


:Herzog_von_Sachsen a owl:Class ;
  rdfs:subClassOf :Herzog_Amt ;
  :stringInRGX "dux Saxonie"@la ;
  rdfs:label "Herzog von Sachsen"@de ;
  skos:definition "Herzog Sachsen bezeichnet einen Herzog als Inhaber der herzoglichen Herrschaft im Herzogtum Sachsen."@de ;
  skos:example "RG IX 00109: Albertus dux Saxonie et Anna ux. alt. port. 5. mart. 1468 L 664 199r."@la .


:Kommunregister a owl:Class ;
  rdfs:subClassOf :Kuriale_Ueberlieferungseinheit ;
  rdfs:label "Kommunregister"@de ;
  skos:definition "Ein im RG II eingeführter Oberbegriff für die Unterklassen (RG II, S. )."@de .


:Ungehorsam a owl:Class ;
  rdfs:subClassOf :Objekt ;
  :stringInRGX "n. parendo"@la ,
  "non parendi"@la ;
  rdfs:label "Ungehorsam"@de ;
  skos:definition "Ungehorsam bezeichnet als Objekt einer Lizenz die ausdrücklich gewährte Erlaubnis, kirchlichen Vorgesetzten in einem bestimmten, rechtlich begrenzten Zusammenhang nicht gehorchen zu müssen."@de ;
  skos:example "RG I 00015: […] lic. non parendi ordinariis adher. Barth. […]"@la ,
  "RG VIII 01345: Georgius (de Baden ) de ducum et marchionum gen. motu pr. m. publ. litt. ap. de n. intitulando Ulricum de Albomonte can. eccl. Meten. el. Meten. et n. parendo eidem 27. mai. 1460 V 502 403v-405r."@la .


:Weihegrad a owl:Class ;
  rdfs:subClassOf owl:Thing ;
  rdfs:label "Weihegrad"@de ,
  "ordo"@la ;
  skos:definition """\"Mit dem Ordo empfängt der Kleriker zunächst die innere Befähigung zur Ausübung von Weihegewalt überhaupt. Damit er sie aber wirklich ausüben darf, muß ihm das Recht hierzu vom Bischof übertragen werden. […]\" (Sägmuller, Kirchenrecht I, 1914, S. 275); vgl. Kirchliches_Amt.

\"Weihegrade: Während Gratian und Huguccio neun W.grade zählen, kennt →Ivo v. Chartres nur sieben, es fehlen der Psalmistat und der Episkopat. Die W.grade wurden eingeteilt in höhere W.grade, die unbedingt notwendig sind für die Feier der Liturgie (Priester und Diakone), und in niedere W.grade, die erst später mit dem Anwachsen der Kirche zur Unterstützung der ersten Gruppe hinzugefügt wurden (Ostiarier, Lektoren, Exorzisten [→Exorzismus] und Akolythen). Unter der Bezeichnung Priester (sacerdos) sind die Bf.e und Presbyter zusammengefaßt. Seit Gratian und Petrus Lombardus wird außerdem der Subdiakonat mit Rücksicht auf die damit verbundene Zölibatsverpflichtung von Theologen und Kanonisten des 12. und beginnenden 13. Jh. zu den ordines sacri gerechnet. Episkopat und Presbyterat wurden noch lange als gleich behandelt. Für die Hochscholastik und Spätscholastik bezeugt →Johannes Duns Scotus (99. J.), daß die Kanonisten den Episkopat allg. als bes. W.grad erklären. Die Theologen halten eher an der Siebenzahl der W.grade fest. Für Guillelmus Durantis (1. D.) ist der Episkopat das vollendete und vollkommene Priestertum. Für ihn ist die Jurisdiktionsgewalt, die zur Leitung des Volkes bestimmt ist, auf seiten des Bf.s zweifellos größer als auf seiten des Priesters. Von den meisten Theologen wird die Frage verneint, ob der Episkopat ein sakramentaler W.grad ist.\" (R. Puza, \"Weihe, -grade, -hindernisse\", in: LexMA 8, Sp. 2104-2106)."""@de .


:Kuriennotar a owl:Class ;
  rdfs:subClassOf :Kuriales_Amt ;
  :stringInRGX "notarius curie"@la ;
  rdfs:label "Kuriennotar"@de ,
  "notarius apostolicus"@la ;
  skos:altLabel "officium tabellionatus"@la ,
  "s. palatii notarius"@la ;
  skos:definition """\"Die päpstl. →Kurie bediente sich für die Urkk.ausstellung zunächst der stadtröm. N.e, bes. der sieben Regionarn.e. Der primicerius notariorum gehört zu den höchsten Würdenträgern, den iudices de clero, und fungiert auch als Datar der Urkk. Zur Zeit des Reformpapsttums werden die röm. N.e durch auswärtige, nur vom Papst abhängige Kräfte verdrängt, die sog. Pfalzn.e, die vom 12. Jh. an allein tätig sind. Die notarii apostolici bzw., aus der Sicht des Papstes, notarii nostri (so ihr offizieller Titel) nehmen in der data communis die Bittgesuche der Petenten entgegen, wobei im tägl. Wechsel ein N. zuständig ist (dies notarii), holen die Entscheidung des Papstes ein und fertigen Konzept und Reinschrift an, wobei sie von den →Abbreviatoren und →Skriptoren unterstützt und entlastet werden. Im 14. Jh. werden die N.e weitgehend aus der prakt. Mitwirkung an der Urkk.ausstellung verdrängt. Die Kanzleireform Johannes' XXII. entzieht ihnen die Bearbeitung der Gnadensachen und beschränkt sie auf die Justizsachen, aber auch in diesem Bereich werden sie weitgehend durch den Korrektor und die Prokuratoren der →Audientia verdrängt. Im 15. Jh. sind sie gar nicht mehr prakt. tätig, sondern beziehen nur noch bestimmte Taxen bei der Ausstellung von Justizbriefen und Konsistorialprovisionen.

Die Zahl der N.e beträgt ursprgl. sieben, später (da eine Stelle an den Vizekanzler übergeht) nur noch sechs. Über diese Zahl hinaus werden aber häufig Verleihungen ehrenhalber vorgenommen. Um die N.e der Kanzlei von anderen N.n der Kurie (s. u.) zu unterscheiden, wird außeramtl. im 15. Jh. die Bezeichnung protonotarius üblich. Die sechs »wirkl.« Proton.e werden als protonotarii participantes bezeichnet, da nur sie an den Einnahmen teilhaben; sie bilden ferner ein Kollegium. Im späten 15. Jh. wird das Amt käufl. (ca. 3500 ducati auri de camera). Ebenso wird im letzten Viertel des 15. Jh. das Protonotariat ehrenhalber massenweise für eine Gebühr von 100 fl. verliehen.

Weitere N.e an der Kurie waren: die notarii camere, die in der apostol. →Kammer tätig sind; der notarius auditoris camere am Kammertribunal; der notarius cancellarie, ein Spezialn. des Kanzleileiters; die notarii rote, von denen jeweils vier bei einem der zwölf Rotaauditoren Dienst tun; und öffentl. N.e.

Ferner kreiert der Papst öffentl. N.e bzw. verleiht den Lateranens. Hofpfgf.en die Befugnis, dies zu tun.\"

(Thomas Frenz \"Notarius\", in: LexMA 6, Sp. 1275-1276)"""@de ;
  skos:editorialNote "Von Frenz erwähnt, aber im RG scheinbar nicht nachweisbar: Kanzleinotar = notarius cancellarie: \"ein Spezialn. des Kanzleileiters\""^^xsd:string .


:Simonie a owl:Class ;
  rdfs:subClassOf :Objekt ;
  :stringInRG "simonia"@la ;
  rdfs:label "Simonie"@de ;
  skos:definition "Simonie bezeichnet den unerlaubten Kauf oder Verkauf geistlicher Ämter, Sakramente oder kirchlicher Gnaden gegen Geld oder andere Gegenleistungen."@de ;
  skos:example "RG IV 00782: […] de absol. quod B. Alphardo pro perm. can. et preb. […] pecuniam concesserat […]"@la ,
  "RG IX 00002: […] de absol. a labe simonie […]"@la .


:Weltliches_Recht a owl:Class ;
  rdfs:subClassOf :Recht ;
  :stringInRG "in iure civili"@la ,
  "in leg."@la ,
  "in legibus"@la ;
  rdfs:label "Weltliches Recht"@de ;
  skos:definition "Weltliches_Recht bezeichnet als Studienfach den gelehrten Bereich, der sich mit der systematischen Lehre und Auslegung des nichtkirchlichen Rechts befasst."@de ;
  skos:example "RG 4/77: Alardus de Aelst (Goeswini de Aelst) cler. Traiect. bac. in leg.: de uberiori disp. sup. def. nat. ( c. c. ), n. o. vicar. in eccl. s. Petri Traiect. 12 apr. 1429 S 240 61r."@de .


:Statut a owl:Class ;
  rdfs:subClassOf :Objekt ;
  :stringInRGX "statutis"@la ;
  :stringInRG "statut."^^xsd:string ;
  rdfs:label "Statut"@de ;
