:Koerperlicher_Mangel a owl:Class ;
  rdfs:subClassOf :Mangel ;
  :stringInRGX "defectus oculi"@la ;
  :stringInRG "def. corporis"@la ;
  rdfs:label "Körperlicher Mangel"@de ,
